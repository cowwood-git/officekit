# Cloudflare Pages headers
# 광고(AdSense) 출처는 손으로 넣지 않는다. PUBLIC_ADSENSE_CLIENT 가 설정된 빌드에서
# scripts/apply-ad-csp.mjs(postbuild)가 dist/_headers 의 모든 CSP 에 자동으로 추가한다.

# 카메라는 QR·바코드 읽기의 "카메라로 읽기"가 쓴다 — 이 사이트에만 허용한다(광고 iframe 등은 계속 금지).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(self), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob: https://cloudflareinsights.com; frame-src 'none'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/rhwp/rhwp_bg.wasm.gz
  Cache-Control: public, max-age=3600

/rhwp/rhwp.js
  Cache-Control: public, max-age=3600

/icons.svg
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
# 공유 이미지는 다른 사이트(메신저·SNS 미리보기)가 직접 불러 쓴다 — 기본 same-origin 을 풀어 준다.
/og/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/og-default.png
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

# Pages 기본 주소(officekit-c4y.pages.dev)·미리보기 배포는 같은 사이트의 복제본이다.
# canonical 만으로는 검색엔진이 복제본을 색인할 수 있어 noindex 로 확실히 뺀다(officekit.kr 은 영향 없음).
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
