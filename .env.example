# 사이트 (빌드 시 canonical 도메인)
# 비우면 src/site.mjs 의 DEFAULT_SITE_URL 을 쓴다.
# SITE_URL=https://officekit.kr

# Google AdSense — 비워두면 광고 슬롯이 렌더링되지 않는다.
# PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# 슬롯 ID 가 있는 자리만 켜진다. 하나씩 켜고 데이터를 본다(docs/ad-policy.md).
# PUBLIC_ADSENSE_SLOT_TOOL=0000000000     # 도구 제목 아래 배너
# PUBLIC_ADSENSE_SLOT_RESULT=0000000000   # 결과 아래 (결과가 나온 뒤에만)
# PUBLIC_ADSENSE_SLOT_RAIL=0000000000     # 오른쪽 세로 160×600 (1480px 이상 화면만)
# PUBLIC_ADSENSE_SLOT_HOME=0000000000     # 홈 그리드 아래

# Cloudflare Web Analytics — 쿠키 없는 집계 통계
# PUBLIC_CF_ANALYTICS_TOKEN=
