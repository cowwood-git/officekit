---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('pdf-image-extract');
if (!tool) throw new Error('pdf-image-extract 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/pdf-image-extract/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'PDF 이미지 추출', path },
  ]),
];
---

<BaseLayout
  title="PDF 이미지 추출 — 페이지 속 사진·그림 PNG로 저장"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">PDF 이미지 추출</h2>

      <label class="dropzone" id="ie-drop" for="ie-input">
        <span class="dropzone-icon" aria-hidden="true">🖼️</span>
        <strong>이미지를 추출할 PDF를 끌어다 놓으세요</strong>
        <small>PDF 한 개 · 최대 300쪽 · 50MB</small>
        <input id="ie-input" class="visually-hidden" type="file" accept="application/pdf,.pdf" />
      </label>

      <p id="ie-status" class="status" role="status" aria-live="polite"></p>
      <p id="ie-error" class="error" role="alert" hidden></p>

      <div id="ie-panel" hidden>
        <p id="ie-file-info" class="file-info-line"></p>

        <div class="ie-options">
          <div class="field">
            <label for="ie-range">페이지 범위</label>
            <input id="ie-range" type="text" placeholder="비우면 전체, 예: 1-3" autocomplete="off" />
          </div>
          <button id="ie-extract" class="btn" type="button">이미지 추출</button>
          <button id="ie-reset" class="btn btn-secondary" type="button">다른 PDF 선택</button>
        </div>

        <div id="ie-result" class="result-panel" tabindex="-1" hidden>
          <p class="result-value">추출 결과</p>
          <dl class="stat-grid">
            <div class="stat"><dt>이미지</dt><dd id="ie-result-count">-</dd></div>
            <div class="stat"><dt>전체 크기</dt><dd id="ie-result-size">-</dd></div>
          </dl>
        </div>

        <div class="tool-actions">
          <a id="ie-zip" class="btn" href="#" hidden>ZIP 모두 저장</a>
        </div>

        <div id="ie-list" class="ie-list" aria-live="polite"></div>
      </div>
    </section>

    <div class="prose">
      <h2>PDF 안의 사진·그림을 꺼냅니다</h2>
      <p>
        페이지에 배치된 사진·그림을 찾아 <strong>PNG</strong>로 저장합니다. 문서를 통째로 캡처하는
        방식이 아니라 원본 픽셀을 사용하므로, 스캔본·보고서에 들어간 사진을 개별 파일로 꺼낼 때
        유용합니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>보고서에 삽입된 제품 사진·차트 이미지 추출</li>
        <li>스캔 PDF의 페이지 이미지를 개별 보관</li>
        <li>프레젠테이션 자료로 쓰인 그림 재사용</li>
        <li>PDF 카탈로그의 상품 이미지 모으기</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>도형·차트·글자는 이미지가 아니므로 추출되지 않습니다.</li>
        <li>페이지 전체를 하나의 이미지로 저장한 스캔본은 페이지당 1개 이미지가 나옵니다.</li>
        <li>마스크·아주 작은 아이콘(16px 미만)은 제외합니다.</li>
        <li>한 번에 최대 <strong>100개</strong> 이미지까지 추출합니다.</li>
        <li>이미지 형식은 투명도를 유지하는 PNG입니다.</li>
        <li>암호가 걸린 PDF는 열 수 없습니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        PDF 해석과 이미지 변환이 브라우저에서 실행됩니다. 사내 문서의 사진도 서버에 올리지 않고 추출할
        수 있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initPdfImageExtract } from '../../scripts/pdf-image-extract';

  initPdfImageExtract();
</script>

<style>
  .ie-options {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.7rem 1rem;
    margin-bottom: 0.9rem;
  }

  .ie-options .field {
    min-width: 240px;
  }

  .ie-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .ie-list :global(.ie-card) {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .ie-list :global(.ie-card) img {
    width: 100%;
    height: 140px;
    border-radius: 4px;
    background: var(--surface-muted);
    object-fit: contain;
  }

  .ie-list :global(.ie-card figcaption) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.7rem;
  }

  .ie-list :global(.ie-card figcaption span) {
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ie-list :global(.ie-card figcaption a) {
    flex: none;
    font-weight: 700;
  }
</style>
