---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('pdf-sign');
if (!tool) throw new Error('pdf-sign 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/pdf-sign/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'PDF 서명·도장', path },
  ]),
];
---

<BaseLayout
  title="PDF 서명·도장 — 그리거나 이미지로 넣기"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">PDF 서명 넣기</h2>

      <label class="dropzone" id="ps-drop" for="ps-input">
        <span class="dropzone-icon" aria-hidden="true">✍️</span>
        <strong>서명할 PDF를 끌어다 놓으세요</strong>
        <small>PDF 한 개 · 최대 300쪽 · 50MB</small>
        <input id="ps-input" class="visually-hidden" type="file" accept="application/pdf,.pdf" />
      </label>

      <p id="ps-status" class="status" role="status" aria-live="polite"></p>
      <p id="ps-error" class="error" role="alert" hidden></p>

      <div id="ps-panel" hidden>
        <p id="ps-file-info" class="file-info-line"></p>

        <div class="ps-layout">
          <div>
            <div id="ps-preview-wrap" class="preview-wrap">
              <canvas id="ps-canvas" aria-label="서명 배치 미리보기"></canvas>
            </div>
            <p id="ps-preview-label" class="preview-label">1쪽 미리보기</p>
          </div>

          <div class="ps-controls">
            <div id="ps-source-tabs" class="ps-tabs" role="group" aria-label="서명 만들기">
              <button type="button" data-source="draw" aria-pressed="true">직접 그리기</button>
              <button type="button" data-source="upload" aria-pressed="false">이미지 올리기</button>
            </div>

            <div id="ps-draw-panel">
              <canvas
                id="ps-draw"
                class="ps-draw"
                width="600"
                height="240"
                aria-label="서명 그리기"
              ></canvas>
              <div class="ps-pen">
                <div class="field">
                  <label for="ps-pen-color">색상</label>
                  <input id="ps-pen-color" type="color" value="#111827" />
                </div>
                <div class="field">
                  <label for="ps-pen-width">굵기</label>
                  <input id="ps-pen-width" type="range" min="2" max="12" step="1" value="4" />
                </div>
                <button id="ps-clear-draw" class="btn btn-secondary" type="button">지우기</button>
              </div>
              <p class="hint">마우스·터치로 서명을 그리면 투명 배경으로 자동 저장됩니다.</p>
            </div>

            <div id="ps-upload-panel" hidden>
              <label class="dropzone ps-upload" for="ps-signature-input">
                <strong>서명 이미지 선택</strong>
                <small>투명 PNG 권장 · JPG 가능</small>
                <input
                  id="ps-signature-input"
                  class="visually-hidden"
                  type="file"
                  accept="image/png,image/jpeg,image/webp"
                />
              </label>
            </div>

            <div class="field">
              <label for="ps-target">넣을 페이지</label>
              <select id="ps-target">
                <option value="last" selected>마지막 페이지</option>
                <option value="all">모든 페이지</option>
                <option value="custom">지정 페이지</option>
              </select>
            </div>
            <div class="field">
              <label for="ps-page">페이지 번호</label>
              <input id="ps-page" type="number" min="1" step="1" value="1" />
            </div>

            <div class="field">
              <label for="ps-size">크기 <span id="ps-size-value">30%</span></label>
              <input id="ps-size" type="range" min="10" max="60" step="1" value="30" />
            </div>
            <div class="field">
              <label for="ps-opacity">투명도 <span id="ps-opacity-value">100%</span></label>
              <input id="ps-opacity" type="range" min="30" max="100" step="1" value="100" />
            </div>

            <p class="hint">미리보기에서 서명을 끌어 위치를 옮길 수 있습니다.</p>
          </div>
        </div>

        <div class="tool-actions">
          <button id="ps-apply" class="btn" type="button" disabled>서명 넣고 저장</button>
          <button id="ps-reset" class="btn btn-secondary" type="button">다른 PDF 선택</button>
        </div>

        <div id="ps-result" class="result-panel" tabindex="-1" hidden>
          <p class="result-value">서명 결과</p>
          <dl class="stat-grid">
            <div class="stat"><dt>적용 페이지</dt><dd id="ps-result-pages">-</dd></div>
            <div class="stat"><dt>파일 크기</dt><dd id="ps-result-size">-</dd></div>
          </dl>
          <div class="tool-actions">
            <a id="ps-download" class="btn" href="#" hidden>서명 PDF 내려받기</a>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>서명을 PDF 위에 얹습니다</h2>
      <p>
        직접 그린 서명이나 서명 이미지를 PDF 페이지 위에 배치합니다. 원본 문서는 그대로 두고 투명
        레이어로 합성하므로 글자·표가 유지됩니다. 마지막 페이지, 모든 페이지, 특정 페이지 중에서 고를
        수 있습니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>계약서·동의서에 자필 서명 넣기</li>
        <li>사내 결재 문서에 서명 이미지 배치</li>
        <li>제출용 확인서에 도장 대신 서명</li>
        <li>여러 페이지에 같은 서명 반복</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>전자서명의 법적 효력은 문서·상황에 따라 다릅니다. 이 도구는 이미지 서명을 넣는 기능입니다.</li>
        <li>서명은 <strong>이미지 레이어</strong>로 들어가며 PDF 텍스트로 추출되지 않습니다.</li>
        <li>투명 PNG를 사용하면 배경 없이 깔끔하게 들어갑니다. JPG는 흰 배경이 함께 들어갑니다.</li>
        <li>서명 이미지는 페이지 밖으로 나가지 않도록 제한되지만, 본문과 겹칠 수 있으니 미리보기를 확인하세요.</li>
        <li>한 번에 최대 <strong>300쪽·50MB</strong>까지 처리합니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        PDF 해석과 서명 합성이 브라우저에서 실행됩니다. 계약서·신청서도 서버에 올리지 않고 서명할 수
        있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initPdfSign } from '../../scripts/pdf-sign';

  initPdfSign();
</script>

<style>
  .ps-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(270px, 0.9fr);
    gap: 1.2rem;
    align-items: start;
  }

  .preview-wrap {
    display: grid;
    place-items: center;
    padding: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }

  #ps-canvas {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 520px;
    background: #fff;
    box-shadow: 0 1px 6px rgba(20, 24, 31, 0.12);
    touch-action: none;
    cursor: move;
  }

  .preview-label {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.74rem;
    text-align: center;
  }

  .ps-controls {
    display: grid;
    gap: 0.65rem;
  }

  .ps-tabs {
    display: flex;
    gap: 0.35rem;
  }

  .ps-tabs button {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .ps-tabs button[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .ps-draw {
    width: 100%;
    height: auto;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    touch-action: none;
    cursor: crosshair;
  }

  .ps-pen {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .ps-pen .field {
    flex: 1;
  }

  .ps-pen .btn {
    padding: 0.45rem 0.7rem;
    font-size: 0.78rem;
  }

  .ps-upload {
    padding: 1rem;
  }

  .ps-controls .hint {
    display: block;
    margin-top: 0.1rem;
  }

  @media (max-width: 900px) {
    .ps-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
