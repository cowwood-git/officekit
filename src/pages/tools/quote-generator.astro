---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('quote-generator');
if (!tool) throw new Error('quote-generator 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/quote-generator/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '견적서·거래명세서', path },
  ]),
];
---

<BaseLayout
  title="견적서·거래명세서 만들기 — PDF로 저장"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel quote-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">견적서·거래명세서 만들기</h2>

      <div class="quote-section">
        <div class="quote-section-head">
          <div>
            <h3>문서 정보</h3>
            <p>견적서와 거래명세서는 같은 내용으로 만들 수 있습니다.</p>
          </div>
        </div>
        <div class="quote-meta">
          <div class="field">
            <label for="q-type">문서 종류</label>
            <select id="q-type">
              <option value="quote" selected>견적서</option>
              <option value="statement">거래명세서</option>
            </select>
          </div>
          <div class="field">
            <label for="q-number">문서 번호</label>
            <input id="q-number" type="text" autocomplete="off" />
          </div>
          <div class="field">
            <label for="q-date">작성일</label>
            <input id="q-date" type="date" />
          </div>
          <div class="field">
            <label for="q-valid">유효기간</label>
            <input id="q-valid" type="date" />
          </div>
        </div>
      </div>

      <div class="quote-section">
        <div class="quote-section-head">
          <div>
            <h3>공급자와 공급받는자</h3>
            <p>입력한 정보가 PDF 상단에 그대로 표시됩니다.</p>
          </div>
        </div>
        <div class="quote-parties">
          <fieldset class="party-card">
            <legend>공급자 <span class="party-hint">내 회사</span></legend>
            <div class="party-grid">
              <div class="field party-span-2">
                <label for="q-supplier-company">상호</label>
                <input
                  id="q-supplier-company"
                  type="text"
                  placeholder="예: 옷깃"
                  autocomplete="organization"
                />
              </div>
              <div class="field">
                <label for="q-supplier-biz">사업자번호</label>
                <input
                  id="q-supplier-biz"
                  type="text"
                  placeholder="000-00-00000"
                  inputmode="numeric"
                />
              </div>
              <div class="field">
                <label for="q-supplier-ceo">대표자</label>
                <input id="q-supplier-ceo" type="text" autocomplete="name" />
              </div>
              <div class="field party-span-2">
                <label for="q-supplier-address">주소</label>
                <input id="q-supplier-address" type="text" autocomplete="street-address" />
              </div>
              <div class="field party-span-2">
                <label for="q-supplier-contact">연락처</label>
                <input id="q-supplier-contact" type="text" placeholder="전화 또는 이메일" />
              </div>
            </div>
          </fieldset>

          <fieldset class="party-card">
            <legend>공급받는자 <span class="party-hint">거래처</span></legend>
            <div class="party-grid">
              <div class="field party-span-2">
                <label for="q-buyer-company">상호</label>
                <input
                  id="q-buyer-company"
                  type="text"
                  placeholder="예: 거래처"
                  autocomplete="organization"
                />
              </div>
              <div class="field">
                <label for="q-buyer-biz">사업자번호</label>
                <input
                  id="q-buyer-biz"
                  type="text"
                  placeholder="000-00-00000"
                  inputmode="numeric"
                />
              </div>
              <div class="field">
                <label for="q-buyer-ceo">담당자</label>
                <input id="q-buyer-ceo" type="text" autocomplete="name" />
              </div>
              <div class="field party-span-2">
                <label for="q-buyer-address">주소</label>
                <input id="q-buyer-address" type="text" autocomplete="street-address" />
              </div>
              <div class="field party-span-2">
                <label for="q-buyer-contact">연락처</label>
                <input id="q-buyer-contact" type="text" placeholder="전화 또는 이메일" />
              </div>
            </div>
          </fieldset>
        </div>

        <label class="quote-save">
          <input id="q-save-company" type="checkbox" />
          <span>회사 정보를 이 브라우저에 저장</span>
        </label>
      </div>

      <div class="quote-section">
        <div class="quote-section-head">
          <div>
            <h3>품목</h3>
            <p>수량과 단가를 입력하면 금액이 자동으로 계산됩니다.</p>
          </div>
          <span id="q-item-count" class="quote-count">1개</span>
        </div>
        <div id="q-items-body" class="quote-items" role="list" aria-label="품목 목록"></div>
        <button id="q-add-item" class="quote-add" type="button">
          <span aria-hidden="true">＋</span>
          품목 추가
        </button>
      </div>

      <div class="quote-section">
        <div class="quote-section-head">
          <div>
            <h3>부가세와 비고</h3>
            <p>결제 조건이나 납기일을 함께 적어 두세요.</p>
          </div>
        </div>
        <div class="quote-settle-grid">
          <div class="quote-options">
            <div class="field quote-vat">
              <label for="q-vat">부가세</label>
              <select id="q-vat">
                <option value="excluded" selected>별도 (10%)</option>
                <option value="included">포함</option>
                <option value="none">없음</option>
              </select>
            </div>
            <div class="field quote-note">
              <label for="q-note">비고</label>
              <textarea
                id="q-note"
                rows="3"
                placeholder="결제 조건, 납기, 계좌 정보 등"
              ></textarea>
            </div>
          </div>

          <aside class="quote-summary" aria-label="금액 합계">
            <div class="quote-summary-row">
              <span>공급가액</span>
              <strong id="q-supply">0원</strong>
            </div>
            <div class="quote-summary-row">
              <span>부가세</span>
              <strong id="q-vat-amount">0원</strong>
            </div>
            <div class="quote-summary-row quote-total">
              <span>합계</span>
              <strong id="q-total">0원</strong>
            </div>
          </aside>
        </div>
      </div>

      <div class="quote-footer">
        <div class="tool-actions">
          <button id="q-generate" class="btn" type="button">PDF 만들기</button>
          <button id="q-reset" class="btn btn-secondary" type="button">새로 작성</button>
        </div>
      </div>

      <p id="q-status" class="status" role="status" aria-live="polite"></p>
      <p id="q-error" class="error" role="alert" hidden></p>

      <div id="q-result" class="result-panel" tabindex="-1" hidden>
        <p class="result-value">PDF가 준비됐습니다</p>
        <dl class="stat-grid">
          <div class="stat"><dt>파일 크기</dt><dd id="q-result-size">-</dd></div>
          <div class="stat"><dt>형식</dt><dd>A4 PDF</dd></div>
        </dl>
        <div class="tool-actions">
          <a id="q-download" class="btn" href="#" hidden>PDF 내려받기</a>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>견적서와 거래명세서를 한 번에</h2>
      <p>
        회사 정보와 품목, 수량, 단가를 입력하면 A4 PDF로 만들어 줍니다. 견적서와 거래명세서는
        같은 내용을 바탕으로 제목과 문서 번호만 바꿔 만들 수 있습니다. 모든 처리는 브라우저
        안에서 실행되며 파일은 서버로 전송되지 않습니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>거래처에 보낼 견적서를 빠르게 만들 때</li>
        <li>납품 후 거래명세서를 PDF로 정리할 때</li>
        <li>부가세 포함·별도 금액을 확인할 때</li>
        <li>회사 정보를 매번 다시 입력하지 않고 재사용할 때</li>
      </ul>

      <h2>부가세 계산</h2>
      <ul>
        <li><strong>별도</strong> — 품목 합계에 10%를 더해 합계를 계산합니다.</li>
        <li><strong>포함</strong> — 입력한 금액 안에서 공급가액과 부가세를 역산합니다.</li>
        <li><strong>없음</strong> — 부가세 없이 합계만 표시합니다.</li>
        <li>반올림은 원 단위이며, 실제 세무 처리 기준과 다를 수 있습니다.</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>이 도구는 <strong>참고용 서식</strong>입니다. 세금계산서 발행이나 세무 신고를 대신하지 않습니다.</li>
        <li>회사 정보 저장을 체크하면 이 브라우저에만 보관됩니다. 서버에는 저장하지 않습니다.</li>
        <li>PDF 글자는 텍스트로 들어가 선택·검색·복사할 수 있습니다.</li>
        <li>품목이 많으면 자동으로 다음 페이지로 넘어갑니다.</li>
        <li>글꼴은 나눔고딕으로 표시되며, 회사 로고·도장은 넣지 않습니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        견적서 작성과 PDF 생성이 모두 브라우저 안에서 실행됩니다. 거래처 정보·단가가 서버로
        전송되지 않으며, 탭을 닫으면 입력값도 사라집니다. 자세한 원리는
        <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initQuoteGenerator } from '../../scripts/quote-generator';

  initQuoteGenerator();
</script>

<style>
  .quote-panel {
    display: grid;
  }

  .quote-section {
    display: grid;
    gap: 0.85rem;
  }

  .quote-section + .quote-section {
    margin-top: 1.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .quote-section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .quote-section-head h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.015em;
  }

  .quote-section-head p {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .quote-count {
    flex: none;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .quote-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: end;
  }

  .quote-meta .field,
  .quote-meta .field input,
  .quote-meta .field select {
    min-width: 0;
  }

  .quote-parties {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .party-card {
    min-width: 0;
    margin: 0;
    padding: 0.75rem 0.9rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-muted);
  }

  .party-card legend {
    padding: 0 0.35rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .party-hint {
    margin-left: 0.3rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .party-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .party-span-2 {
    grid-column: 1 / -1;
  }

  .party-card .field {
    gap: 0.25rem;
  }

  .party-card .field label {
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .party-card .field input {
    min-height: 42px;
    padding: 0.5rem 0.65rem;
    font-size: 0.88rem;
  }

  .quote-save {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    color: var(--muted);
    font-size: 0.82rem;
    cursor: pointer;
  }

  .quote-save input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--accent);
  }

  .quote-items {
    display: grid;
  }

  :global(.quote-items .item-row) {
    display: grid;
    grid-template-columns:
      minmax(0, 2.4fr) minmax(5.5rem, 0.75fr) minmax(7rem, 1fr)
      minmax(7rem, 1fr) 2.25rem;
    gap: 0.6rem;
    align-items: end;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  :global(.quote-items .item-row:first-child) {
    padding-top: 0;
  }

  :global(.quote-items .item-field) {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  :global(.quote-items .item-label) {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.2;
  }

  :global(.quote-items .item-field input) {
    width: 100%;
    min-width: 0;
    min-height: 42px;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    background: var(--surface);
    font-size: 0.88rem;
  }

  :global(.quote-items .item-field input:focus) {
    border-color: var(--accent);
  }

  :global(.quote-items .item-field input[type="number"]) {
    appearance: textfield;
    -moz-appearance: textfield;
  }

  :global(.quote-items .item-field input[type="number"]::-webkit-outer-spin-button),
  :global(.quote-items .item-field input[type="number"]::-webkit-inner-spin-button) {
    margin: 0;
    -webkit-appearance: none;
  }

  :global(.quote-items .item-field input[data-field="quantity"]),
  :global(.quote-items .item-field input[data-field="unitPrice"]) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  :global(.quote-items .item-amount strong) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 42px;
    padding: 0.45rem 0.6rem;
    border-radius: 7px;
    background: var(--surface-muted);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.quote-items .item-remove) {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 42px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  :global(.quote-items .item-remove:hover) {
    border-color: color-mix(in srgb, var(--warn) 30%, transparent);
    background: var(--warn-soft);
    color: var(--warn);
  }

  .quote-add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
    min-height: 44px;
    margin-top: 0.7rem;
    border: 1px dashed var(--line-strong);
    border-radius: 9px;
    background: transparent;
    color: var(--accent-strong);
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .quote-add:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .quote-add span {
    font-size: 1rem;
    line-height: 1;
  }

  .quote-settle-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 19rem);
    gap: 1rem;
    align-items: start;
  }

  .quote-options {
    display: grid;
    gap: 0.8rem;
  }

  .quote-vat {
    max-width: 14rem;
  }

  .quote-note textarea {
    min-height: 5.2rem;
    resize: vertical;
  }

  .quote-summary {
    display: grid;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-muted);
  }

  .quote-summary-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
  }

  .quote-summary-row + .quote-summary-row {
    border-top: 1px dashed var(--line);
  }

  .quote-summary-row span {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .quote-summary-row strong {
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
  }

  .quote-summary .quote-total {
    padding-top: 0.6rem;
  }

  .quote-summary .quote-total span {
    color: var(--ink);
    font-weight: 700;
  }

  .quote-summary .quote-total strong {
    color: var(--accent-strong);
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }

  .quote-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }

  .quote-footer .tool-actions {
    margin-top: 0;
  }

  @media (max-width: 760px) {
    .quote-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .quote-parties {
      grid-template-columns: 1fr;
    }

    .quote-settle-grid {
      grid-template-columns: 1fr;
    }

    :global(.quote-items .item-row) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.15fr);
      grid-template-areas:
        "name name remove"
        "qty price amount";
      gap: 0.55rem;
      padding: 0.8rem 0;
    }

    :global(.quote-items .item-name) {
      grid-area: name;
    }

    :global(.quote-items .item-qty) {
      grid-area: qty;
    }

    :global(.quote-items .item-price) {
      grid-area: price;
    }

    :global(.quote-items .item-amount) {
      grid-area: amount;
    }

    :global(.quote-items .item-remove) {
      grid-area: remove;
      justify-self: end;
      width: 2.5rem;
    }
  }

  @media (max-width: 520px) {
    .quote-footer .tool-actions {
      width: 100%;
    }

    .quote-footer .btn {
      flex: 1;
    }
  }
</style>
