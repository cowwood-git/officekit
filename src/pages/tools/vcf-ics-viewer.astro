---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('vcf-ics-viewer');
if (!tool) throw new Error('vcf-ics-viewer 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/vcf-ics-viewer/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'VCF·ICS 뷰어', path },
  ]),
];
---

<BaseLayout
  title="VCF·ICS 뷰어 — 연락처·일정 파일 열기"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">VCF·ICS 연락처와 일정 보기</h2>

      <label class="dropzone" id="vi-drop" for="vi-input">
        <span class="dropzone-icon" aria-hidden="true">📇</span>
        <strong>연락처·일정 파일을 끌어다 놓으세요</strong>
        <small>VCF(vCard) · ICS(iCalendar) · 50MB · 서버 전송 없음</small>
        <input id="vi-input" class="visually-hidden" type="file" accept=".vcf,.vcs,.ics,.ical" />
      </label>

      <p id="vi-status" class="status" role="status" aria-live="polite"></p>
      <p id="vi-error" class="error" role="alert" hidden></p>

      <div id="vi-panel" hidden>
        <p id="vi-info" class="vi-info"></p>

        <dl class="stat-grid">
          <div class="stat"><dt>연락처</dt><dd id="vi-stat-contacts">0</dd></div>
          <div class="stat"><dt>일정</dt><dd id="vi-stat-events">0</dd></div>
          <div class="stat"><dt>형식</dt><dd id="vi-stat-kind">-</dd></div>
        </dl>

        <div class="vi-toolbar">
          <label class="visually-hidden" for="vi-search">연락처·일정 검색</label>
          <input
            id="vi-search"
            type="search"
            placeholder="이름, 전화, 회사, 일정, 장소 검색"
            autocomplete="off"
            aria-controls="vi-contacts-list vi-events-list"
          />
          <button id="vi-reset" class="btn btn-secondary" type="button">다른 파일</button>
        </div>

        <section id="vi-contacts-section" class="vi-section" aria-labelledby="vi-contacts-title">
          <div class="vi-section-head">
            <h2 id="vi-contacts-title">연락처</h2>
            <button id="vi-contacts-csv" class="btn btn-secondary" type="button">
              연락처 CSV
            </button>
          </div>
          <div id="vi-contacts-list" class="vi-contacts"></div>
        </section>

        <section id="vi-events-section" class="vi-section" aria-labelledby="vi-events-title">
          <div class="vi-section-head">
            <h2 id="vi-events-title">일정</h2>
            <button id="vi-events-csv" class="btn btn-secondary" type="button">일정 CSV</button>
          </div>
          <ol id="vi-events-list" class="vi-events"></ol>
        </section>

        <p id="vi-no-results" class="vi-empty" hidden>검색 결과가 없습니다.</p>
      </div>
    </section>

    <div class="prose">
      <h2>연락처와 일정 파일을 설치 없이</h2>
      <p>
        아이폰·안드로이드·아웃룩·구글 캘린더에서 내보낸 <strong>VCF</strong>와
        <strong>ICS</strong> 파일을 브라우저에서 바로 엽니다. 연락처는 이름·전화·이메일·회사,
        일정은 제목·날짜·장소·설명을 확인할 수 있습니다. 파일은 서버로 전송되지 않습니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>아이폰에서 내보낸 연락처를 윈도우에서 확인할 때</li>
        <li>구글 캘린더·아웃룩 일정 파일을 빠르게 훑어볼 때</li>
        <li>연락처를 CSV로 바꿔 엑셀에서 정리할 때</li>
        <li>일정 목록을 표로 만들어 공유할 때</li>
      </ul>

      <h2>지원 범위</h2>
      <ul>
        <li>vCard 2.1·3.0·4.0의 이름·전화·이메일·회사·직함·주소·메모</li>
        <li>ICS 일정의 제목·시작·종료·장소·설명·반복 규칙·상태</li>
        <li>UTF-8 / EUC-KR, 오래된 vCard의 한글 인코딩</li>
        <li>연락처·일정을 엑셀에서 열 수 있는 CSV로 저장</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>반복 일정은 <strong>반복 규칙만 표시</strong>하고, 실제 발생 일정을 모두 펼치지는 않습니다.</li>
        <li>사진·첨부·복잡한 사용자 정의 필드는 표시하지 않습니다.</li>
        <li>앱마다 파일 형식이 조금씩 달라 일부 필드가 빠질 수 있습니다.</li>
        <li>일정 시간은 파일에 적힌 시간대를 기준으로 표시하며, 기기 시간대와 다를 수 있습니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        VCF·ICS 읽기와 CSV 생성이 모두 브라우저 안에서 실행됩니다. 연락처·일정 원본은 서버에
        저장되지 않으며, 탭을 닫으면 작업 흔적도 남지 않습니다. 자세한 원리는
        <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initVcfIcsViewer } from '../../scripts/vcf-ics-viewer';

  initVcfIcsViewer();
</script>

<style is:global>
  .vi-info {
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
    word-break: break-all;
  }

  .vi-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: 1.2rem;
  }

  .vi-toolbar input {
    flex: 1 1 16rem;
    min-width: 0;
    /* 옆 버튼(48px)과 같은 높이 */
    min-height: 48px;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: 0.86rem;
  }

  .vi-toolbar input:focus {
    border-color: var(--accent);
    outline: 2px solid var(--accent-soft);
    outline-offset: 1px;
  }

  .vi-section {
    margin-top: 1.4rem;
  }

  .vi-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.65rem;
  }

  .vi-section-head h2 {
    margin: 0;
    font-size: 1rem;
  }

  .vi-contacts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.6rem;
  }

  .vi-contact {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .vi-contact h3,
  .vi-event h3 {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }

  .vi-contact-meta {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .vi-line {
    display: block;
    overflow-wrap: anywhere;
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.5;
    text-decoration: none;
  }

  a.vi-line:hover,
  a.vi-line:focus-visible {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .vi-note {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .vi-events {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vi-event {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .vi-event-date {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .vi-badge {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .vi-empty {
    margin-top: 1.2rem;
    padding: 1.2rem 1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface-muted);
    color: var(--muted);
    font-size: 0.86rem;
    text-align: center;
  }
</style>
