---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('pdf-watermark');
if (!tool) throw new Error('pdf-watermark 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/pdf-watermark/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'PDF 워터마크', path },
  ]),
];
---

<BaseLayout
  title="PDF 워터마크 — 대외비·초안 문구 일괄 삽입"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">PDF 워터마크 넣기</h2>

      <label class="dropzone" id="pw-drop" for="pw-input">
        <span class="dropzone-icon" aria-hidden="true">💧</span>
        <strong>워터마크를 넣을 PDF를 끌어다 놓으세요</strong>
        <small>PDF 한 개 · 최대 100쪽 · 50MB</small>
        <input id="pw-input" class="visually-hidden" type="file" accept="application/pdf,.pdf" />
      </label>

      <p id="pw-status" class="status" role="status" aria-live="polite"></p>
      <p id="pw-error" class="error" role="alert" hidden></p>

      <div id="pw-panel" hidden>
        <p id="pw-file-info" class="file-info-line"></p>

        <div class="pw-layout">
          <div class="pw-preview">
            <div id="pw-preview-wrap" class="preview-wrap">
              <canvas id="pw-canvas" aria-label="워터마크 미리보기"></canvas>
            </div>
            <p id="pw-preview-label" class="preview-label">1쪽 미리보기</p>
          </div>

          <div class="pw-controls">
            <div class="field">
              <label for="pw-text">문구</label>
              <input id="pw-text" type="text" value="대외비" maxlength="40" autocomplete="off" />
              <span class="hint">예: 대외비, 초안, 사내한정, 2026-11-10</span>
            </div>

            <div class="field">
              <label for="pw-layout">배치</label>
              <select id="pw-layout">
                <option value="tile" selected>전체 반복 (타일)</option>
                <option value="center">가운데 한 번</option>
                <option value="corner">오른쪽 아래</option>
              </select>
            </div>

            <div class="field">
              <label for="pw-range">페이지 범위</label>
              <input id="pw-range" type="text" placeholder="비우면 전체, 예: 1-3,5" autocomplete="off" />
              <span class="hint">지정한 페이지만 바꾸고 나머지는 원본 그대로 저장합니다.</span>
            </div>

            <details class="tool-advanced" data-tool-advanced>
              <summary>
                세부 설정 <span class="tool-advanced-state" data-advanced-state>기본값</span>
              </summary>
              <div class="tool-advanced-body">
                <div class="field">
                  <label for="pw-size">크기 <span id="pw-size-value">7%</span></label>
                  <input id="pw-size" type="range" min="3" max="18" step="1" value="7" />
                </div>
                <div class="field">
                  <label for="pw-opacity">투명도 <span id="pw-opacity-value">20%</span></label>
                  <input id="pw-opacity" type="range" min="8" max="60" step="2" value="20" />
                </div>
                <div class="field">
                  <label for="pw-color">색상</label>
                  <input id="pw-color" type="color" value="#cc2222" />
                  <span class="hint">흰 바탕에는 빨강·회색이 잘 보입니다.</span>
                </div>
                <div class="field">
                  <label for="pw-angle">각도</label>
                  <select id="pw-angle">
                    <option value="0">0°</option>
                    <option value="-30" selected>-30°</option>
                    <option value="-45">-45°</option>
                  </select>
                </div>
              </div>
            </details>
          </div>
        </div>

        <div class="tool-actions">
          <button id="pw-apply" class="btn" type="button">워터마크 넣고 저장</button>
          <button id="pw-reset" class="btn btn-secondary" type="button">다른 PDF 선택</button>
        </div>

        <div id="pw-result" class="result-panel" tabindex="-1" hidden>
          <p class="result-value">워터마크 결과</p>
          <dl class="stat-grid">
            <div class="stat">
              <dt>적용 페이지</dt>
              <dd id="pw-result-pages">-</dd>
            </div>
            <div class="stat">
              <dt>파일 크기</dt>
              <dd id="pw-result-size">-</dd>
            </div>
          </dl>
          <p id="pw-result-note" class="notice" hidden></p>
          <div class="tool-actions">
            <a id="pw-download" class="btn" href="#" hidden>워터마크 PDF 내려받기</a>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>PDF 워터마크가 하는 일</h2>
      <p>
        PDF 페이지 위에 <strong>투명한 워터마크 레이어</strong>를 얹습니다. 원본의 텍스트·이미지·링크·
        입력 폼은 그대로 두고, 대외비·초안 같은 문구만 추가합니다. 페이지를 이미지로 다시 그리는 방식이
        아니므로 <strong>글자 선택과 검색이 유지</strong>됩니다.
      </p>

      <h2>배치 선택 가이드</h2>
      <table>
        <thead>
          <tr><th>배치</th><th>어울리는 경우</th><th>특징</th></tr>
        </thead>
        <tbody>
          <tr><td>전체 반복</td><td>유출 방지·대외비</td><td>문서 전체에 촘촘히 표시</td></tr>
          <tr><td>가운데 한 번</td><td>초안·검토본</td><td>본문을 크게 가리지 않음</td></tr>
          <tr><td>오른쪽 아래</td><td>사내 배포·출처 표시</td><td>가장 눈에 덜 띔</td></tr>
        </tbody>
      </table>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>견적서·계약서 사본에 “대외비” 표시</li>
        <li>검토 중인 보고서에 “초안” 표시</li>
        <li>사외 배포 자료에 배포일·출처 표시</li>
        <li>특정 페이지만 골라 워터마크 적용</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>워터마크는 <strong>이미지 레이어</strong>로 들어갑니다. 원본 텍스트는 유지되지만, 워터마크 문구 자체는 텍스트로 추출되지 않습니다.</li>
        <li>완전히 제거하려면 원본 PDF를 사용하세요. 워터마크가 들어간 사본에서 지우는 기능은 제공하지 않습니다.</li>
        <li>한 번에 최대 <strong>100쪽·50MB</strong>까지 처리합니다.</li>
        <li>암호가 걸린 PDF는 열 수 없습니다. 암호를 먼저 해제하세요.</li>
        <li>페이지 범위를 비우면 전체 페이지에 적용합니다. 예: <code>1-3,5</code></li>
        <li>스캔 PDF에도 넣을 수 있지만, 이미 워터마크가 있는 페이지는 겹쳐 보일 수 있습니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        PDF 해석과 워터마크 생성이 모두 브라우저에서 실행됩니다. 계약서·인사 문서도 서버에 올리지 않고
        처리할 수 있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initPdfWatermark } from '../../scripts/pdf-watermark';

  initPdfWatermark();
</script>

<style>
  .pw-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: 1.25rem;
    align-items: start;
  }

  .pw-preview {
    min-width: 0;
  }

  .preview-wrap {
    display: grid;
    place-items: center;
    padding: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }

  #pw-canvas {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 560px;
    background: #fff;
    box-shadow: 0 1px 6px rgba(20, 24, 31, 0.12);
  }

  .preview-label {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.74rem;
    text-align: center;
  }

  .pw-controls {
    display: grid;
    gap: 0.75rem;
  }

  .pw-controls .hint {
    display: block;
    margin-top: 0.2rem;
  }

  @media (max-width: 820px) {
    .pw-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
