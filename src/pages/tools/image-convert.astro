---
import ImageConvertPanel from '@/components/panels/ImageConvertPanel.astro';
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('image-convert');
if (!tool) throw new Error('image-convert 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/image-convert/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '이미지 형식 변환', path },
  ]),
];
---

<BaseLayout
  title="이미지 형식 변환 — JPG·PNG·WebP 일괄 변환"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <ImageConvertPanel />

    <div class="prose">
      <h2>지원 형식</h2>
      <table>
        <thead>
          <tr><th>입력</th><th>설명</th></tr>
        </thead>
        <tbody>
          <tr><td>JPG / PNG / WebP</td><td>가장 일반적인 사진·스크린샷 형식</td></tr>
          <tr><td>GIF</td><td>첫 프레임만 변환합니다(애니메이션 미지원)</td></tr>
          <tr><td>BMP</td><td>오래된 비트맵. 용량이 크므로 변환에 적합</td></tr>
          <tr><td>SVG</td><td>이미지로 변환 (글꼴·효과는 환경에 따라 다름)</td></tr>
          <tr><td>AVIF</td><td>브라우저가 디코딩할 수 있는 경우에만</td></tr>
        </tbody>
      </table>

      <h2>출력 형식 고르기</h2>
      <ul>
        <li><strong>JPG</strong> — 사진·문서 스캔. 투명도 없음, 호환성 최고.</li>
        <li><strong>PNG</strong> — 로고·스크린샷·투명 배경. 무손실이라 용량이 큼.</li>
        <li><strong>WebP</strong> — 웹용. 같은 화질에서 가장 작지만 일부 오래된 프로그램은 못 엶.</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>투명 PNG를 JPG로 바꾸면 배경색으로 채워집니다. 기본값은 흰색입니다.</li>
        <li>GIF 애니메이션은 첫 장면만 변환됩니다.</li>
        <li>SVG는 원본에 지정된 크기로 변환됩니다. 크기를 키우려면 원본 SVG의 width/height를 조정하세요.</li>
        <li>6000px를 넘는 이미지는 축소 저장됩니다.</li>
        <li>한 번에 20장, 전체 50MB까지 처리합니다. 여러 장은 ZIP으로 내려받습니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        디코딩·변환·ZIP 생성이 모두 브라우저에서 실행됩니다. 사내 이미지·제품 사진도 서버에 올리지
        않고 형식을 바꿀 수 있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  th {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
</style>
