---
import ImageConvertPanel from '@/components/panels/ImageConvertPanel.astro';
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('image-resize');
if (!tool) throw new Error('image-resize 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/image-resize/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '이미지 크기 조절', path },
  ]),
];
---

<BaseLayout
  title="이미지 크기 조절 — 가로·세로 픽셀, 비율로 줄이기"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <ImageConvertPanel
      resize
      drop="크기를 바꿀 이미지를 끌어다 놓으세요"
      hint="JPG · PNG · WebP · GIF · BMP · 최대 20장"
    />

    <div class="prose">
      <h2>크기 기준 고르기</h2>
      <table>
        <thead>
          <tr><th>기준</th><th>이럴 때</th></tr>
        </thead>
        <tbody>
          <tr><td>가로 길이</td><td>블로그·쇼핑몰처럼 본문 폭이 정해진 곳에 올릴 때</td></tr>
          <tr><td>세로 길이</td><td>배너·썸네일처럼 높이를 맞춰야 할 때</td></tr>
          <tr><td>가로 × 세로</td><td>"1080×1080 이내"처럼 상자 크기가 정해진 업로드 규격</td></tr>
          <tr><td>비율 (%)</td><td>여러 장을 똑같이 절반, 30% 식으로 줄일 때</td></tr>
        </tbody>
      </table>

      <h2>비율 유지와 정확한 크기</h2>
      <p>
        가로 × 세로를 고르면 기본으로 <strong>비율 유지</strong>가 켜져 있습니다. 사진을 찌그러뜨리지
        않고 정한 상자 안에 들어가는 가장 큰 크기로 맞춥니다. 증명사진 칸이나 아이콘처럼 반드시 그
        크기여야 한다면 비율 유지를 끄세요. 그때는 적은 크기 그대로 늘리거나 줄이므로 원본 비율이
        다르면 모양이 바뀝니다. 모양을 지키면서 정확한 크기가 필요하다면 먼저
        <a href="/tools/image-crop/">이미지 자르기</a>로 비율을 맞춘 뒤 크기를 바꾸는 편이 좋습니다.
      </p>

      <h2>저장 형식과 용량</h2>
      <ul>
        <li>기본은 <strong>원본 형식 유지</strong>입니다. JPG는 JPG로, PNG는 PNG로 저장합니다.</li>
        <li>GIF·BMP처럼 브라우저가 그 형식으로 저장할 수 없는 파일은 PNG로 저장합니다.</li>
        <li>크기를 줄이면 용량도 대부분 줄어듭니다. 더 줄이려면 JPG·WebP를 고르고 화질을 낮추세요.</li>
        <li>사진의 회전 정보(EXIF 방향)를 반영해 그리므로 세로 사진이 눕지 않습니다.</li>
        <li>한 번에 20장, 한 변 최대 8000px까지 만듭니다. 여러 장은 ZIP 하나로 받습니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        사진을 읽고 새 크기로 다시 그리는 과정이 모두 이 브라우저 안에서 일어납니다. 가족 사진이나
        제품 원본처럼 밖으로 내보내기 꺼려지는 이미지도 안심하고 줄일 수 있습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>
