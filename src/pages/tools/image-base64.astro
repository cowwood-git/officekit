---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('image-base64');
if (!tool) throw new Error('image-base64 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/image-base64/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '이미지 Base64 변환', path },
  ]),
];
---

<BaseLayout title="이미지 Base64 변환 — data URI·HTML·CSS 코드 ↔ 이미지" description={tool.description.ko} path={path} jsonLd={jsonLd}>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">이미지 Base64 변환</h2>
      <h3 class="b6-heading">이미지 → Base64</h3>
      <label class="dropzone" id="b6-drop" for="b6-input">
        <span class="dropzone-icon" aria-hidden="true">🧬</span>
        <strong>Base64로 바꿀 이미지를 끌어다 놓으세요</strong>
        <small>PNG · JPG · GIF · WebP · SVG · ICO · 10MB</small>
        <input id="b6-input" class="visually-hidden" type="file" accept="image/*,.svg,.ico" />
      </label>
      <p id="b6-error" class="error" role="alert" hidden></p>

      <div id="b6-encode" class="stack" hidden>
        <div class="b6-row">
          <div class="kit-preview b6-thumb"><img id="b6-encode-preview" alt="넣은 이미지" /></div>
          <p id="b6-encode-info" class="kit-info"></p>
        </div>
        <div class="kit-row">
          <div class="field">
            <label for="b6-format">복사할 형식</label>
            <select id="b6-format">
              <option value="dataUri">data URI</option>
              <option value="html">HTML &lt;img&gt;</option>
              <option value="css">CSS background</option>
              <option value="markdown">마크다운</option>
            </select>
          </div>
          <button id="b6-copy" class="btn" type="button">복사</button>
        </div>
        <label for="b6-output" class="visually-hidden">Base64 결과</label>
        <textarea id="b6-output" class="kit-code" rows="6" readonly></textarea>
      </div>

      <h3 class="b6-heading">Base64 → 이미지</h3>
      <div class="field">
        <label for="b6-paste">Base64 또는 data URI 붙여 넣기</label>
        <textarea id="b6-paste" class="kit-code" rows="5" spellcheck="false" placeholder="data:image/png;base64,iVBORw0KGgo…"></textarea>
      </div>
      <div class="tool-actions">
        <button id="b6-decode" class="btn" type="button">이미지로 바꾸기</button>
      </div>
      <p id="b6-decode-error" class="error" role="alert" hidden></p>
      <div id="b6-decoded" class="result-panel" tabindex="-1" hidden>
        <div class="kit-preview"><img id="b6-decoded-preview" alt="풀어낸 이미지" /></div>
        <p id="b6-decoded-info" class="kit-info"></p>
        <div class="tool-actions">
          <a id="b6-download" class="btn" href="#">이미지 내려받기</a>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>Base64 이미지가 뭔가요</h2>
      <p>
        Base64는 사진 같은 이진 파일을 영문자와 숫자로만 이루어진 긴 글자로 바꾸는 방식입니다. 앞에
        <code>data:image/png;base64,</code>를 붙인 것을 data URI라고 하며, 이미지 파일 없이 HTML·CSS·이메일 서명 안에
        이미지를 통째로 넣을 수 있습니다. 반대로 API 응답이나 웹 소스에서 본 긴 Base64 글자를 이미지 파일로 되돌릴 때도
        이 도구를 씁니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>작은 아이콘·로고를 HTML 메일이나 이메일 서명에 파일 첨부 없이 넣을 때</li>
        <li>CSS에 배경 이미지를 직접 넣어 요청 수를 줄일 때</li>
        <li>개발 중 API·로그에 찍힌 Base64 이미지가 무엇인지 확인할 때</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>Base64로 바꾸면 용량이 원본보다 약 33% 커집니다. 100KB가 넘는 이미지는 파일로 두는 편이 낫습니다.</li>
        <li>data URI 앞부분이 없어도 PNG·JPG·GIF·WebP·SVG는 내용을 보고 형식을 알아냅니다.</li>
        <li>글자를 Base64로 바꾼 것을 풀려면 <a href="/tools/text-convert/">텍스트 변환</a>을 쓰세요.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        파일을 읽고 처리하고 내려받는 과정이 모두 이 브라우저 안에서 끝납니다. 회사 문서나 개인 사진도
        외부 서버에 올리지 않습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initImageBase64 } from '../../scripts/image-base64';

  initImageBase64();
</script>

<style>
  .b6-heading {
    margin: 0.5rem 0 0.25rem;
    font-size: 1rem;
  }

  .b6-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .b6-thumb {
    flex: 0 0 96px;
    min-height: 96px;
    padding: 0.3rem;
  }

  .b6-thumb img {
    max-height: 84px;
  }
</style>
