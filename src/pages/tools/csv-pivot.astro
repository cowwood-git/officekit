---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('csv-pivot');
if (!tool) throw new Error('csv-pivot 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/csv-pivot/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'CSV 피벗', path },
  ]),
];
---

<BaseLayout
  title="CSV 피벗 테이블 — 행·열 교차 집계"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">CSV 피벗 테이블</h2>

      <label class="dropzone" id="cpv-drop" for="cpv-input">
        <span class="dropzone-icon" aria-hidden="true">📊</span>
        <strong>피벗할 CSV·엑셀 파일을 끌어다 놓으세요</strong>
        <small>CSV · TSV · XLSX · XLS · ODS · 50MB</small>
        <input
          id="cpv-input"
          class="visually-hidden"
          type="file"
          accept=".csv,.tsv,.xlsx,.xls,.ods"
        />
      </label>

      <p id="cpv-status" class="status" role="status" aria-live="polite"></p>
      <p id="cpv-error" class="error" role="alert" hidden></p>

      <div id="cpv-panel" hidden>
        <p id="cpv-file-info" class="file-info-line"></p>

        <div class="cpv-options">
          <div class="field">
            <label for="cpv-row">행 (세로)</label>
            <select id="cpv-row"></select>
          </div>
          <div class="field">
            <label for="cpv-column">열 (가로)</label>
            <select id="cpv-column"></select>
          </div>
          <div class="field">
            <label for="cpv-value">값</label>
            <select id="cpv-value"></select>
          </div>
          <div class="field">
            <label for="cpv-aggregate">집계</label>
            <select id="cpv-aggregate">
              <option value="sum" selected>합계</option>
              <option value="count">개수</option>
              <option value="avg">평균</option>
              <option value="min">최소</option>
              <option value="max">최대</option>
            </select>
          </div>
          <label class="check"><input id="cpv-totals" type="checkbox" checked /> 합계 행·열</label>
        </div>

        <div class="tool-actions">
          <button id="cpv-run" class="btn" type="button" disabled>피벗 만들기</button>
          <button id="cpv-clear" class="btn btn-secondary" type="button">다른 파일</button>
        </div>

        <div id="cpv-result" hidden>
          <div class="cpv-head">
            <p id="cpv-stats" class="hint"></p>
            <div class="tool-actions">
              <a id="cpv-csv" class="btn btn-secondary" href="#" hidden>피벗 CSV</a>
              <a id="cpv-xlsx" class="btn btn-secondary" href="#" hidden>피벗 XLSX</a>
            </div>
          </div>

          <div class="cpv-preview-wrap">
            <table id="cpv-preview" class="cpv-preview"></table>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>엑셀 피벗 테이블을 브라우저에서</h2>
      <p>
        행 기준과 열 기준을 고르면 교차표를 만들고, 선택한 값 열을 합계·개수·평균·최소·최대로 집계합니다.
        합계 행·열을 켜면 전체 요약도 함께 나옵니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>지역별·제품별 매출 합계</li>
        <li>부서별 인원 수 교차표</li>
        <li>월별·항목별 평균값 비교</li>
        <li>설문 응답의 교차 집계</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>첫 행을 헤더로 사용하며, 빈 행·열 값은 집계에서 제외합니다.</li>
        <li>값 열에 숫자가 아닌 데이터가 섞여 있으면 합계·평균에서 제외됩니다.</li>
        <li>개수 집계는 값의 종류와 관계없이 행 수를 셉니다.</li>
        <li>여러 시트가 있으면 첫 번째 시트만 사용합니다.</li>
        <li>결과는 CSV·XLSX로 내려받을 수 있습니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        표 읽기와 집계가 브라우저에서 실행됩니다. 매출·인사 데이터도 서버에 올리지 않고 피벗할 수
        있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initCsvPivot } from '../../scripts/csv-pivot';

  initCsvPivot();
</script>

<style>
  .cpv-options {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.6rem 1rem;
  }

  .cpv-options .field {
    min-width: 145px;
  }

  .cpv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0.9rem 0 0.5rem;
  }

  .cpv-head .tool-actions {
    margin: 0;
  }

  .cpv-preview-wrap {
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .cpv-preview {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .cpv-preview :global(th),
  .cpv-preview :global(td) {
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
    text-align: right;
  }

  .cpv-preview :global(th) {
    position: sticky;
    top: 0;
    background: var(--surface-muted);
    text-align: right;
    font-size: 0.72rem;
  }

  .cpv-preview :global(th:first-child),
  .cpv-preview :global(td:first-child) {
    text-align: left;
  }

  @media (max-width: 640px) {
    .cpv-options .field {
      min-width: 120px;
      flex: 1;
    }
  }
</style>
