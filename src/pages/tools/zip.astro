---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('zip');
if (!tool) throw new Error('zip 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/zip/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'ZIP 열기·만들기', path },
  ]),
];
---

<BaseLayout
  title="ZIP 열기·만들기 — 설치 없이 압축 풀기"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">ZIP 열기·만들기</h2>

      <fieldset class="mode-switch">
        <legend class="visually-hidden">ZIP 작업</legend>
        <label>
          <input id="zip-mode-open" type="radio" name="zip-mode" value="open" checked />
          <span>ZIP 열기</span>
        </label>
        <label>
          <input id="zip-mode-create" type="radio" name="zip-mode" value="create" />
          <span>ZIP 만들기</span>
        </label>
      </fieldset>

      <div id="zip-open-panel">
        <label class="dropzone" id="zip-open-drop" for="zip-open-input">
          <span class="dropzone-icon" aria-hidden="true">🗜️</span>
          <strong>열어 볼 ZIP 파일을 끌어다 놓으세요</strong>
          <small>ZIP · 최대 100MB · 서버 전송 없음</small>
          <input id="zip-open-input" class="visually-hidden" type="file" accept=".zip,application/zip" />
        </label>

        <div id="zip-open-info" hidden>
          <dl class="stat-grid zip-stats">
            <div class="stat"><dt>파일</dt><dd id="zip-stat-files">0</dd></div>
            <div class="stat"><dt>압축 전</dt><dd id="zip-stat-size">0 B</dd></div>
            <div class="stat"><dt>압축 후</dt><dd id="zip-stat-compressed">0 B</dd></div>
          </dl>

          <div class="zip-open-layout">
            <div class="zip-list-wrap">
              <div class="zip-list-head">
                <strong>파일 목록</strong>
                <div class="zip-list-actions">
                  <button id="zip-select-all" class="zip-mini" type="button">전체 선택</button>
                  <button id="zip-select-none" class="zip-mini" type="button">전체 해제</button>
                </div>
              </div>
              <ul id="zip-entries" class="zip-entries" aria-label="ZIP 파일 목록"></ul>
            </div>

            <aside class="zip-preview" aria-label="파일 미리보기">
              <div id="zip-preview-head" class="zip-preview-head">
                <strong>미리보기</strong>
              </div>
              <div id="zip-preview-body" class="zip-preview-body">
                <p class="hint">파일 목록에서 <strong>미리보기</strong>를 누르면 내용이 표시됩니다.</p>
              </div>
            </aside>
          </div>

          <div class="tool-actions">
            <button id="zip-extract" class="btn" type="button" disabled>선택 항목 ZIP으로 내려받기</button>
            <button id="zip-open-reset" class="btn btn-secondary" type="button">다른 ZIP</button>
          </div>
        </div>
      </div>

      <div id="zip-create-panel" hidden>
        <label class="dropzone" id="zip-create-drop" for="zip-create-input">
          <span class="dropzone-icon" aria-hidden="true">🗂️</span>
          <strong>ZIP에 담을 파일을 끌어다 놓으세요</strong>
          <small>여러 파일 · 폴더 선택 가능 · 서버 전송 없음</small>
          <input id="zip-create-input" class="visually-hidden" type="file" multiple />
          <input
            id="zip-folder-input"
            class="visually-hidden"
            type="file"
            multiple
          />
        </label>

        <div class="zip-create-tools">
          <label class="btn btn-secondary" for="zip-create-input">파일 선택</label>
          <button id="zip-folder-button" class="btn btn-secondary" type="button">폴더 선택</button>
          <button id="zip-create-reset" class="btn btn-secondary" type="button">목록 비우기</button>
        </div>

        <ul id="zip-create-list" class="zip-create-list" aria-label="ZIP에 담을 파일"></ul>
        <p id="zip-create-note" class="hint"></p>

        <div class="zip-create-options">
          <div class="field">
            <label for="zip-name">파일 이름</label>
            <input id="zip-name" type="text" autocomplete="off" />
            <span class="hint">.zip은 자동으로 붙습니다.</span>
          </div>
          <div class="field">
            <label for="zip-compression">압축 방식</label>
            <select id="zip-compression">
              <option value="store">저장만 (가장 빠름)</option>
              <option value="standard" selected>표준 압축</option>
              <option value="best">최대 압축 (느림)</option>
            </select>
          </div>
        </div>

        <div class="tool-actions">
          <button id="zip-create" class="btn" type="button" disabled>ZIP 만들기</button>
        </div>
      </div>

      <p id="zip-status" class="status" role="status" aria-live="polite"></p>
      <p id="zip-error" class="error" role="alert" hidden></p>
    </section>

    <div class="prose">
      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>받은 ZIP 파일을 설치 없이 열어 내용을 확인할 때</li>
        <li>ZIP 안의 파일 몇 개만 골라 다시 받을 때</li>
        <li>여러 파일을 하나의 ZIP으로 묶어 메일로 보낼 때</li>
        <li>폴더 구조를 유지한 채 압축 파일을 만들 때</li>
      </ul>

      <h2>ZIP 열기</h2>
      <p>
        ZIP 파일을 불러오면 안의 파일 목록과 압축 전·후 용량을 보여 줍니다. 텍스트·이미지는 바로
        미리 볼 수 있고, 필요한 파일만 선택해 새 ZIP으로 내려받을 수 있습니다. 폴더 구조는 그대로
        유지됩니다.
      </p>

      <h2>ZIP 만들기</h2>
      <p>
        여러 파일을 고르거나 폴더를 통째로 선택해 ZIP으로 묶습니다. 폴더를 선택하면 하위 폴더 구조가
        유지됩니다. 압축 방식을 고르고 진행률을 확인한 뒤 내려받으세요.
      </p>

      <h2>알아두세요</h2>
      <ul>
        <li>ZIP 열기는 한 번에 100MB, 압축 해제 합계 500MB, 2,000개 항목까지 지원합니다.</li>
        <li>ZIP 만들기는 1,000개 파일, 합계 500MB까지 지원합니다.</li>
        <li>암호가 걸린 ZIP은 열 수 없습니다. 암호를 푼 뒤 사용하세요.</li>
        <li>압축 해제·생성은 브라우저 메모리에서 실행되며 파일은 서버로 전송되지 않습니다.</li>
        <li>파일 경로의 <code>..</code> 같은 위험한 문자는 안전하게 정리합니다.</li>
      </ul>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initZipTool } from '../../scripts/zip';

  initZipTool();
</script>

<style>
  .mode-switch {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.3rem;
    margin: 0 0 1.2rem;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-muted);
  }

  .mode-switch label {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
  }

  .mode-switch input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .mode-switch label:has(input:checked) {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .mode-switch label:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .zip-stats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 0.9rem;
  }

  .zip-open-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: 1rem;
    align-items: start;
  }

  .zip-list-wrap,
  .zip-preview {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .zip-list-head,
  .zip-preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .zip-list-head strong,
  .zip-preview-head strong {
    font-size: 0.82rem;
  }

  .zip-list-actions {
    display: flex;
    gap: 0.35rem;
  }

  .zip-mini {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.7rem;
    cursor: pointer;
  }

  .zip-mini:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  .zip-entries {
    max-height: 380px;
    margin: 0;
    padding: 0.35rem;
    overflow: auto;
    list-style: none;
  }

  :global(.zip-entry) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    gap: 0.45rem;
    align-items: center;
    padding: 0.4rem 0.45rem;
    border-radius: 7px;
    font-size: 0.78rem;
  }

  :global(.zip-entry:hover) {
    background: var(--surface-muted);
  }

  :global(.zip-entry input) {
    width: 15px;
    height: 15px;
    margin: 0;
    accent-color: var(--accent);
  }

  :global(.zip-entry-name) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.zip-entry-size) {
    color: var(--muted);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  :global(.zip-entry-preview) {
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.68rem;
    cursor: pointer;
  }

  :global(.zip-entry-preview:hover) {
    border-color: var(--accent);
    color: var(--ink);
  }

  .zip-preview-body {
    min-height: 220px;
    max-height: 420px;
    padding: 0.8rem;
    overflow: auto;
  }

  .zip-preview-body pre {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .zip-preview-body img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .zip-preview-name {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.74rem;
    overflow-wrap: anywhere;
  }

  .zip-create-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.7rem;
  }

  .zip-create-tools .btn {
    min-height: 40px;
    padding: 0.45rem 0.75rem;
    font-size: 0.82rem;
  }

  .zip-create-list {
    display: grid;
    gap: 0.35rem;
    max-height: 280px;
    margin: 0.8rem 0 0;
    padding: 0;
    overflow: auto;
    list-style: none;
  }

  :global(.zip-create-item) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface-muted);
    font-size: 0.78rem;
  }

  :global(.zip-create-item-name) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.zip-create-item-size) {
    color: var(--muted);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  :global(.zip-create-remove) {
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }

  :global(.zip-create-remove:hover) {
    border-color: var(--warn);
    color: var(--warn);
  }

  .zip-create-options {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.7fr);
    gap: 0.75rem;
    margin-top: 1rem;
    /* 위로 맞춘다 — 아래 맞춤이면 안내문이 있는 칸만 입력 상자가 위로 올라가 어긋난다 */
    align-items: start;
  }

  @media (max-width: 820px) {
    .zip-open-layout,
    .zip-create-options {
      grid-template-columns: 1fr;
    }

    .zip-preview-body {
      min-height: 140px;
    }
  }

  @media (max-width: 520px) {
    .zip-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
