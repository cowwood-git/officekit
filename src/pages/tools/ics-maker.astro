---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('ics-maker');
if (!tool) throw new Error('ics-maker 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/ics-maker/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'ICS 만들기', path },
  ]),
];
---

<BaseLayout
  title="ICS 만들기 — 일정을 .ics 파일로"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">ICS 일정 만들기</h2>

      <div class="ics-layout">
        <div class="ics-form">
          <div class="field">
            <label for="ics-title">일정 제목</label>
            <input id="ics-title" type="text" placeholder="예: 프로젝트 회의" />
          </div>

          <label class="ics-check">
            <input id="ics-allday" type="checkbox" />
            <span>종일 일정</span>
          </label>

          <div class="ics-row">
            <div class="field">
              <label for="ics-start-date">시작일</label>
              <input id="ics-start-date" type="date" />
            </div>
            <div class="field ics-time" id="ics-start-time-field">
              <label for="ics-start-time">시작 시간</label>
              <input id="ics-start-time" type="time" value="09:00" />
            </div>
          </div>

          <div class="ics-row">
            <div class="field">
              <label for="ics-end-date">종료일</label>
              <input id="ics-end-date" type="date" />
            </div>
            <div class="field ics-time" id="ics-end-time-field">
              <label for="ics-end-time">종료 시간</label>
              <input id="ics-end-time" type="time" value="10:00" />
            </div>
          </div>

          <div class="ics-row">
            <div class="field">
              <label for="ics-location">장소</label>
              <input id="ics-location" type="text" placeholder="예: 회의실 A" />
            </div>
            <div class="field">
              <label for="ics-reminder">알림</label>
              <select id="ics-reminder">
                <option value="0" selected>없음</option>
                <option value="5">5분 전</option>
                <option value="10">10분 전</option>
                <option value="15">15분 전</option>
                <option value="30">30분 전</option>
                <option value="60">1시간 전</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="ics-url">관련 링크 <span class="hint">(선택)</span></label>
            <input id="ics-url" type="url" placeholder="https://..." />
          </div>

          <div class="field">
            <label for="ics-description">설명 <span class="hint">(선택)</span></label>
            <textarea id="ics-description" rows="3" placeholder="안건, 준비물, 참석자 등"></textarea>
          </div>

          <div class="tool-actions">
            <button id="ics-generate" class="btn" type="button">ICS 내려받기</button>
            <button id="ics-reset" class="btn btn-secondary" type="button">초기화</button>
          </div>

          <p id="ics-status" class="status" role="status" aria-live="polite"></p>
          <p id="ics-error" class="error" role="alert" hidden></p>
        </div>

        <aside class="ics-side" aria-label="일정 미리보기">
          <h3>일정 미리보기</h3>
          <p id="ics-summary-title" class="ics-summary-title">일정 제목</p>
          <dl class="ics-summary">
            <div><dt>일시</dt><dd id="ics-summary-when">-</dd></div>
            <div><dt>장소</dt><dd id="ics-summary-where">-</dd></div>
            <div><dt>알림</dt><dd id="ics-summary-reminder">없음</dd></div>
          </dl>
          <p class="hint">
            구글 캘린더·아웃룩·애플 캘린더에서 열 수 있는 iCalendar(.ics) 파일로 저장합니다.
          </p>
        </aside>
      </div>
    </section>

    <div class="prose">
      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>회의·행사 일정을 캘린더 앱으로 보내고 싶을 때</li>
        <li>구글 캘린더에 없는 일정을 .ics 파일로 만들 때</li>
        <li>메일로 일정을 보낼 때 첨부할 파일이 필요할 때</li>
        <li>아웃룩·애플 캘린더에 같은 일정을 넣을 때</li>
      </ul>

      <h2>종일 일정과 시간 일정</h2>
      <p>
        <strong>종일 일정</strong>은 날짜만 저장합니다. iCalendar 규칙상 종료일은 ‘다음 날’로
        기록되므로, 11월 13일 하루 일정은 내부적으로 11월 14일에 끝나는 것으로 저장됩니다.
        <strong>시간 일정</strong>은 시작·종료 시간을 함께 저장합니다.
      </p>

      <h2>알아두세요</h2>
      <ul>
        <li>시간대는 기기의 현지 시간을 기준으로 저장합니다. 다른 시간대에서 열면 시간이 달라질 수 있습니다.</li>
        <li>반복 일정·참석자 초대·첨부 파일은 지원하지 않습니다.</li>
        <li>일정 제목과 설명은 브라우저 안에서만 처리되며 서버로 전송되지 않습니다.</li>
        <li>캘린더 앱에 따라 표시 방식이 조금 다를 수 있습니다.</li>
      </ul>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initIcsMaker } from '../../scripts/ics-maker';

  initIcsMaker();
</script>

<style>
  .ics-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: 1.25rem;
    align-items: start;
  }

  .ics-form {
    display: grid;
    gap: 0.85rem;
  }

  .ics-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: end;
  }

  .ics-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    color: var(--ink-soft);
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
  }

  .ics-check input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--accent);
  }

  .ics-side {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 0.6rem;
    padding: 1.05rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }

  .ics-side h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .ics-summary-title {
    margin: 0;
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }

  .ics-summary {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .ics-summary div {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 0.4rem;
    align-items: baseline;
  }

  .ics-summary dt {
    color: var(--muted);
    font-size: 0.76rem;
  }

  .ics-summary dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 820px) {
    .ics-layout {
      grid-template-columns: 1fr;
    }

    .ics-side {
      position: static;
    }
  }

  @media (max-width: 460px) {
    .ics-row {
      grid-template-columns: 1fr;
    }
  }
</style>
