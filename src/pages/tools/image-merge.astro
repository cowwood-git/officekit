---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('image-merge');
if (!tool) throw new Error('image-merge 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/image-merge/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '이미지 합치기', path },
  ]),
];
---

<BaseLayout
  title="이미지 합치기 — 가로·세로·격자로 사진 붙이기"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">이미지 합치기</h2>

      <label class="dropzone" id="im-drop" for="im-input">
        <span class="dropzone-icon" aria-hidden="true">🧩</span>
        <strong>합칠 이미지를 끌어다 놓으세요</strong>
        <small>2~9장 · JPG · PNG · WebP · 전체 50MB</small>
        <input id="im-input" class="visually-hidden" type="file" accept="image/*" multiple />
      </label>

      <p id="im-status" class="status" role="status" aria-live="polite"></p>
      <p id="im-error" class="error" role="alert" hidden></p>

      <div id="im-panel" hidden>
        <p id="im-info" class="file-info-line"></p>
        <ul id="im-list" class="im-list" aria-label="합칠 이미지 목록"></ul>

        <div class="im-layout">
          <div class="im-preview">
            <canvas id="im-canvas" aria-label="합친 이미지 미리보기"></canvas>
          </div>

          <div class="im-controls">
            <div class="field">
              <label for="im-mode">배치</label>
              <select id="im-mode">
                <option value="horizontal" selected>가로로 이어붙이기</option>
                <option value="vertical">세로로 이어붙이기</option>
                <option value="grid">격자 (콜라주)</option>
              </select>
            </div>
            <div class="field">
              <label for="im-gap">간격 <span id="im-gap-value">0px</span></label>
              <input id="im-gap" type="range" min="0" max="80" step="2" value="0" />
            </div>
            <div class="field">
              <label for="im-background">배경색 (JPG)</label>
              <input id="im-background" type="color" value="#ffffff" />
              <span class="hint">PNG·WebP는 투명 배경을 유지합니다.</span>
            </div>
            <div class="field">
              <label for="im-format">저장 형식</label>
              <select id="im-format">
                <option value="image/jpeg" selected>JPG</option>
                <option value="image/png">PNG</option>
                <option value="image/webp">WebP</option>
              </select>
            </div>
            <div class="field">
              <label for="im-quality">화질 <span id="im-quality-value">92%</span></label>
              <input id="im-quality" type="range" min="0.6" max="0.95" step="0.05" value="0.92" />
            </div>
            <p class="hint">이미지 순서는 선택한 순서를 따릅니다.</p>
          </div>
        </div>

        <div class="tool-actions">
          <button id="im-apply" class="btn" type="button">이미지 합치기</button>
          <button id="im-clear" class="btn btn-secondary" type="button">모두 지우기</button>
        </div>

        <div id="im-result" class="result-panel" tabindex="-1" hidden>
          <p class="result-value">합치기 결과</p>
          <img id="im-result-image" class="result-image" alt="합친 이미지 미리보기" />
          <p id="im-result-summary" class="notice"></p>
          <div class="tool-actions">
            <a id="im-download" class="btn" href="#" hidden>결과 내려받기</a>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>배치 방식</h2>
      <table>
        <thead>
          <tr><th>배치</th><th>동작</th><th>어울리는 경우</th></tr>
        </thead>
        <tbody>
          <tr><td>가로</td><td>가장 높은 이미지에 높이를 맞춤</td><td>전후 사진, 단계별 캡처</td></tr>
          <tr><td>세로</td><td>가장 넓은 이미지에 너비를 맞춤</td><td>스크롤 캡처, 채팅 이어붙이기</td></tr>
          <tr><td>격자</td><td>정사각형에 가까운 칸에 배치</td><td>여러 장 요약·콜라주</td></tr>
        </tbody>
      </table>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>여러 장의 스크린샷을 한 장으로 정리</li>
        <li>상품 사진·현장 사진을 격자로 묶기</li>
        <li>전후 비교 사진을 가로로 나란히 배치</li>
        <li>보고서에 넣을 이미지 한 장 만들기</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>가로·세로 배치에서 작은 이미지는 기준 크기에 맞춰 확대될 수 있습니다.</li>
        <li>격자 배치의 칸 크기는 가장 큰 이미지에 맞춰지므로 빈 공간이 생길 수 있습니다.</li>
        <li>JPG는 투명 배경을 지원하지 않아 선택한 배경색으로 채웁니다.</li>
        <li>결과가 10,000px를 넘으면 비율을 유지해 축소합니다.</li>
        <li>이미지 순서는 파일을 선택한 순서입니다. 순서를 바꾸려면 다시 선택하세요.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        이미지 디코딩과 합성이 브라우저 안에서 실행됩니다. 사내 사진·제품 이미지도 서버에 올리지
        않고 합칠 수 있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initImageMerge } from '../../scripts/image-merge';

  initImageMerge();
</script>

<style>
  .im-list {
    display: grid;
    gap: 0.25rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .im-list :global(li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
  }

  .im-list :global(span) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .im-list :global(.im-remove) {
    flex: none;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .im-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.8fr);
    gap: 1.2rem;
    align-items: start;
    margin-top: 1rem;
  }

  .im-preview {
    display: grid;
    place-items: center;
    min-height: 160px;
    padding: 0.75rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }

  #im-canvas {
    display: block;
    max-width: 100%;
    max-height: 460px;
    background:
      linear-gradient(45deg, #e9ecef 25%, transparent 25%),
      linear-gradient(-45deg, #e9ecef 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #e9ecef 75%),
      linear-gradient(-45deg, transparent 75%, #e9ecef 75%);
    background-size: 16px 16px;
    background-position:
      0 0,
      0 8px,
      8px -8px,
      -8px 0;
  }

  .im-controls {
    display: grid;
    gap: 0.65rem;
  }

  .im-controls .hint {
    display: block;
    margin-top: 0.15rem;
  }

  @media (max-width: 820px) {
    .im-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
