---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('pdf-metadata');
if (!tool) throw new Error('pdf-metadata 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/pdf-metadata/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'PDF 메타데이터', path },
  ]),
];
---

<BaseLayout
  title="PDF 메타데이터 편집 — 제목·작성자·키워드 변경"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">PDF 메타데이터 편집</h2>

      <label class="dropzone" id="pm-drop" for="pm-input">
        <span class="dropzone-icon" aria-hidden="true">🏷️</span>
        <strong>메타데이터를 확인할 PDF를 끌어다 놓으세요</strong>
        <small>PDF 한 개 · 50MB</small>
        <input id="pm-input" class="visually-hidden" type="file" accept="application/pdf,.pdf" />
      </label>

      <p id="pm-status" class="status" role="status" aria-live="polite"></p>
      <p id="pm-error" class="error" role="alert" hidden></p>

      <div id="pm-panel" hidden>
        <p id="pm-file-info" class="file-info-line"></p>

        <div class="pm-current-box">
          <h3>현재 메타데이터</h3>
          <p id="pm-current" class="pm-current-text"></p>
          <p id="pm-current-dates" class="pm-dates"></p>
        </div>

        <div class="pm-fields">
          <div class="field">
            <label for="pm-title">제목</label>
            <input id="pm-title" type="text" maxlength="200" autocomplete="off" />
            <span class="hint">파일을 열 때 창 제목·탭에 표시되는 이름입니다.</span>
          </div>
          <div class="field">
            <label for="pm-author">작성자</label>
            <input id="pm-author" type="text" maxlength="100" autocomplete="off" />
            <span class="hint">개인 이름이 들어 있으면 비워서 내보내세요.</span>
          </div>
          <div class="field">
            <label for="pm-subject">주제</label>
            <input id="pm-subject" type="text" maxlength="300" autocomplete="off" />
          </div>
          <div class="field">
            <label for="pm-keywords">키워드</label>
            <textarea id="pm-keywords" rows="3" placeholder="계약서, 2026, 검토본"></textarea>
            <span class="hint">쉼표·줄바꿈으로 구분합니다. 중복은 자동으로 제거됩니다.</span>
          </div>
        </div>

        <div class="tool-actions">
          <button id="pm-apply" class="btn" type="button">메타데이터 저장</button>
          <button id="pm-clear" class="btn btn-secondary" type="button">모두 비우기</button>
          <button id="pm-reset" class="btn btn-secondary" type="button">다른 PDF 선택</button>
        </div>

        <div id="pm-result" class="result-panel" tabindex="-1" hidden>
          <p class="result-value">저장 결과</p>
          <dl class="stat-grid">
            <div class="stat">
              <dt>변경 내용</dt>
              <dd id="pm-result-summary">-</dd>
            </div>
            <div class="stat">
              <dt>파일 크기</dt>
              <dd id="pm-result-size">-</dd>
            </div>
          </dl>
          <div class="tool-actions">
            <a id="pm-download" class="btn" href="#" hidden>메타데이터 PDF 내려받기</a>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>메타데이터가 왜 중요한가요</h2>
      <p>
        PDF에는 문서 내용과 별도로 제목·작성자·주제·키워드·만든 프로그램 같은 속성이 저장됩니다. 회사
        템플릿이나 개인 PC에서 만든 파일은 <strong>작성자 이름, 부서, 원본 경로</strong>가 남아 있을 수
        있습니다. 외부로 보내기 전에 확인하고 정리하면 불필요한 개인정보 노출을 줄일 수 있습니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>제출용 PDF의 제목을 문서 이름과 맞추기</li>
        <li>외부 배포 전 작성자·회사명 제거</li>
        <li>검색·분류용 키워드 추가</li>
        <li>여러 부서가 만든 문서의 메타데이터 통일</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>제목·작성자·주제·키워드만 수정합니다. 본문·페이지·서명은 건드리지 않습니다.</li>
        <li>“만든 프로그램”과 “PDF 엔진”은 원본 제작 정보라 이 도구에서 바꾸지 않습니다.</li>
        <li>메타데이터를 비워도 문서 내용이 삭제되지는 않습니다.</li>
        <li>암호가 걸린 PDF는 수정할 수 없습니다.</li>
        <li>파일마다 메타데이터가 모두 다르므로, 중요한 문서는 저장 후 다시 열어 확인하세요.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        PDF 해석과 재저장이 브라우저에서 실행됩니다. 인사·계약 문서의 작성자 정보를 정리할 때도 파일을
        서버에 올리지 않습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initPdfMetadata } from '../../scripts/pdf-metadata';

  initPdfMetadata();
</script>

<style>
  .pm-current-box {
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-muted);
  }

  .pm-current-box h3 {
    margin-bottom: 0.35rem;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .pm-current-text {
    font-size: 0.85rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .pm-dates {
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.74rem;
  }

  .pm-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .pm-fields .field:last-child {
    grid-column: 1 / -1;
  }

  .pm-fields textarea {
    resize: vertical;
  }

  @media (max-width: 700px) {
    .pm-fields {
      grid-template-columns: 1fr;
    }

    .pm-fields .field:last-child {
      grid-column: auto;
    }
  }
</style>
