---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('csv-table');
if (!tool) throw new Error('csv-table 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/csv-table/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'CSV → HTML·Markdown', path },
  ]),
];
---

<BaseLayout
  title="CSV → HTML·Markdown 표 변환 — 붙여넣기용 코드"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">CSV를 HTML·Markdown 표로 변환</h2>

      <label class="dropzone" id="ct-drop" for="ct-input">
        <span class="dropzone-icon" aria-hidden="true">🌐</span>
        <strong>표로 바꿀 CSV·엑셀 파일을 끌어다 놓으세요</strong>
        <small>CSV · TSV · XLSX · XLS · ODS · 50MB</small>
        <input
          id="ct-input"
          class="visually-hidden"
          type="file"
          accept=".csv,.tsv,.xlsx,.xls,.ods"
        />
      </label>

      <p id="ct-status" class="status" role="status" aria-live="polite"></p>
      <p id="ct-error" class="error" role="alert" hidden></p>

      <div id="ct-panel" hidden>
        <p id="ct-file-info" class="file-info-line"></p>

        <div class="ct-options">
          <label class="check"><input id="ct-header" type="checkbox" checked /> 첫 행을 헤더로</label>
          <div class="field">
            <label for="ct-align">정렬</label>
            <select id="ct-align">
              <option value="left" selected>왼쪽</option>
              <option value="center">가운데</option>
              <option value="right">오른쪽</option>
            </select>
          </div>
          <div class="field">
            <label for="ct-format">출력 형식</label>
            <select id="ct-format">
              <option value="html" selected>HTML table</option>
              <option value="markdown">Markdown 표</option>
            </select>
          </div>
        </div>

        <div class="tool-actions">
          <button id="ct-run" class="btn" type="button" disabled>표 코드 만들기</button>
          <button id="ct-clear" class="btn btn-secondary" type="button">다른 파일</button>
        </div>

        <div id="ct-result" hidden>
          <div class="tool-actions">
            <button id="ct-copy" class="btn btn-secondary" type="button">코드 복사</button>
            <a id="ct-download" class="btn btn-secondary" href="#" hidden>내려받기</a>
          </div>
          <div class="ct-grid">
            <section aria-labelledby="ct-preview-title">
              <h3 id="ct-preview-title" class="ct-title">미리보기</h3>
              <div id="ct-preview" class="ct-preview"></div>
              <p id="ct-preview-note" class="ct-note"></p>
            </section>
            <section aria-labelledby="ct-code-title">
              <h3 id="ct-code-title" class="ct-title">코드</h3>
              <textarea id="ct-code" rows="16" readonly spellcheck="false"></textarea>
            </section>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>표를 웹·문서에 붙여넣기</h2>
      <p>
        CSV·엑셀의 첫 시트를 읽어 <strong>HTML 표</strong> 또는 <strong>Markdown 표</strong> 코드로
        바꿉니다. 블로그·위키·README·사내 페이지에 붙여넣으면 표로 표시됩니다. 값은 HTML 특수문자와
        Markdown 파이프를 자동으로 이스케이프합니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>블로그·Notion에 엑셀 표를 붙여넣기</li>
        <li>GitHub README에 Markdown 표 만들기</li>
        <li>사내 위키에 HTML 표 코드 삽입</li>
        <li>CSV 데이터를 웹 페이지 템플릿에 넣기</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>여러 시트가 있으면 <strong>첫 번째 시트만</strong> 변환합니다.</li>
        <li>셀 안의 HTML은 이스케이프되어 그대로 글자로 표시됩니다.</li>
        <li>Markdown 표는 셀 안 줄바꿈을 <code>&lt;br&gt;</code>로 바꿉니다.</li>
        <li>HTML 코드에는 <code>style="text-align: …"</code>가 포함됩니다. 필요 없으면 지워도 됩니다.</li>
        <li>수식은 엑셀이 계산한 표시값으로 읽습니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        표 읽기와 코드 생성이 브라우저에서 실행됩니다. 거래처·매출 표도 서버에 올리지 않고 변환할 수
        있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initCsvTable } from '../../scripts/csv-table';

  initCsvTable();
</script>

<style>
  .ct-options {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.6rem 1rem;
    margin-bottom: 0.9rem;
  }

  .ct-options .field {
    min-width: 130px;
  }

  .ct-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }

  .ct-title {
    margin-bottom: 0.4rem;
    font-size: 0.85rem;
  }

  .ct-preview {
    max-height: 360px;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .ct-preview :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .ct-preview :global(th),
  .ct-preview :global(td) {
    padding: 0.4rem 0.55rem;
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }

  .ct-preview :global(th) {
    background: var(--surface-muted);
    color: var(--muted);
    font-size: 0.72rem;
  }

  .ct-note {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.72rem;
  }

  #ct-code {
    min-height: 360px;
    resize: vertical;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .ct-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
