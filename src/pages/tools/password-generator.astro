---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('password-generator');
if (!tool) throw new Error('password-generator 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/password-generator/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '비밀번호 생성기', path },
  ]),
];
---

<BaseLayout
  title="비밀번호 생성기 — 안전한 비밀번호·패스프레이즈"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">비밀번호 생성기</h2>

      <div class="pw-layout">
        <div class="pw-options">
          <div class="field">
            <label for="pw-mode">방식</label>
            <select id="pw-mode">
              <option value="chars" selected>문자 조합</option>
              <option value="words">단어 조합 (패스프레이즈)</option>
            </select>
          </div>

          <div id="pw-char-options">
            <div class="field">
              <label for="pw-length">
                길이 <output id="pw-length-value">16</output>
              </label>
              <input id="pw-length" type="range" min="8" max="64" step="1" value="16" />
              <span class="hint">8~64자. 길수록 안전합니다.</span>
            </div>

            <fieldset class="pw-charsets">
              <legend>포함할 문자</legend>
              <label class="pw-check">
                <input id="pw-lower" type="checkbox" checked />
                <span>소문자 <code>a-z</code></span>
              </label>
              <label class="pw-check">
                <input id="pw-upper" type="checkbox" checked />
                <span>대문자 <code>A-Z</code></span>
              </label>
              <label class="pw-check">
                <input id="pw-digits" type="checkbox" checked />
                <span>숫자 <code>0-9</code></span>
              </label>
              <label class="pw-check">
                <input id="pw-symbols" type="checkbox" checked />
                <span>기호 <code>!@#$</code></span>
              </label>
            </fieldset>

            <label class="pw-check pw-ambiguous">
              <input id="pw-ambiguous" type="checkbox" />
              <span>비슷한 글자 제외 <span class="hint">I l 1 O 0 o</span></span>
            </label>
          </div>

          <div id="pw-word-options" hidden>
            <div class="field">
              <label for="pw-words">
                단어 수 <output id="pw-words-value">6</output>
              </label>
              <input id="pw-words" type="range" min="3" max="12" step="1" value="6" />
              <span class="hint">영문 단어를 무작위로 이어 붙입니다. 단어를 많이 넣을수록 안전합니다.</span>
            </div>
            <div class="field">
              <label for="pw-separator">구분자</label>
              <select id="pw-separator">
                <option value="-" selected>-</option>
                <option value=".">.</option>
                <option value=" ">공백</option>
                <option value="_">_</option>
              </select>
            </div>
          </div>
        </div>

        <div class="pw-result">
          <p class="pw-result-label">생성된 비밀번호</p>
          <output id="pw-output" class="pw-output" aria-live="polite"></output>
          <div class="pw-meter" aria-hidden="true">
            <span id="pw-meter-bar" data-level="weak"></span>
          </div>
          <p id="pw-strength" class="pw-strength" aria-live="polite"></p>

          <div class="tool-actions">
            <button id="pw-generate" class="btn" type="button">다시 생성</button>
            <button id="pw-copy" class="btn btn-secondary" type="button">복사</button>
          </div>

          <p id="pw-status" class="status" role="status" aria-live="polite"></p>
          <p id="pw-error" class="error" role="alert" hidden></p>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>새 사이트에 가입할 때마다 다른 비밀번호를 만들고 싶을 때</li>
        <li>길고 기억하기 쉬운 패스프레이즈가 필요할 때</li>
        <li>비밀번호 관리자에 넣을 임시 비밀번호를 만들 때</li>
        <li>기존 비밀번호가 너무 짧거나 단순해서 바꾸고 싶을 때</li>
      </ul>

      <h2>안전하게 쓰는 법</h2>
      <ul>
        <li>가능하면 <strong>사이트마다 다른 비밀번호</strong>를 쓰세요.</li>
        <li>비밀번호 관리자와 2단계 인증을 함께 쓰면 훨씬 안전합니다.</li>
        <li>이 도구는 결과를 저장하지 않습니다. 필요한 곳에 바로 복사하세요.</li>
        <li>패스프레이즈는 단어 수를 늘리는 것이 좋습니다.</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>난수는 브라우저의 <code>crypto.getRandomValues</code>로 만듭니다.</li>
        <li>강도 표시는 입력한 길이와 문자 종류로 계산한 <strong>대략적인 엔트로피</strong>입니다.</li>
        <li>모든 생성은 브라우저 안에서 이루어지며 서버로 전송되지 않습니다.</li>
      </ul>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initPasswordGenerator } from '../../scripts/password-generator';

  initPasswordGenerator();
</script>

<style>
  .pw-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .pw-options {
    display: grid;
    gap: 0.9rem;
  }

  .pw-charsets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 0.75rem;
    margin: 0;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .pw-charsets legend {
    padding: 0 0.35rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .pw-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
    cursor: pointer;
  }

  .pw-check input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--accent);
  }

  .pw-check code {
    padding: 0.05rem 0.25rem;
    border-radius: 4px;
    background: var(--surface-muted);
    color: var(--muted);
    font-size: 0.76rem;
  }

  .pw-ambiguous {
    width: fit-content;
  }

  .pw-result {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 0.7rem;
    padding: 1.05rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }

  .pw-result-label {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .pw-output {
    display: block;
    min-height: 3.4em;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1.02rem;
    line-height: 1.55;
    word-break: break-all;
    user-select: all;
  }

  .pw-output.is-empty {
    color: var(--muted);
  }

  .pw-meter {
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--line);
  }

  .pw-meter span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: #b91c1c;
    transition:
      width 0.2s ease,
      background 0.2s ease;
  }

  .pw-meter span[data-level='fair'] {
    background: #b45309;
  }

  .pw-meter span[data-level='strong'] {
    background: var(--accent);
  }

  .pw-meter span[data-level='very'] {
    background: var(--accent-strong);
  }

  .pw-strength {
    min-height: 1.4em;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .pw-result .tool-actions {
    margin-top: 0.1rem;
  }

  @media (max-width: 820px) {
    .pw-layout {
      grid-template-columns: 1fr;
    }

    .pw-result {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 460px) {
    .pw-charsets {
      grid-template-columns: 1fr;
    }
  }
</style>
