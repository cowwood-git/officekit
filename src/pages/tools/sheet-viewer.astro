---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('sheet-viewer');
if (!tool) throw new Error('sheet-viewer 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/sheet-viewer/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'CSV·XLS·XLSX 뷰어', path },
  ]),
];
---

<BaseLayout
  title="CSV·XLS·XLSX 뷰어 — 엑셀 없이 표 확인"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">CSV·XLS·XLSX 표 보기</h2>

      <label class="dropzone" id="sv-drop" for="sv-input">
        <span class="dropzone-icon" aria-hidden="true">📊</span>
        <strong>표 파일을 끌어다 놓으세요</strong>
        <small>CSV · XLSX · XLS · ODS · 최대 50MB</small>
        <input
          id="sv-input"
          class="visually-hidden"
          type="file"
          accept=".csv,.xlsx,.xls,.ods,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        />
      </label>

      <p id="sv-status" class="status" role="status" aria-live="polite"></p>
      <p id="sv-error" class="error" role="alert" hidden></p>

      <div id="sv-panel" hidden>
        <div class="sheet-head">
          <p id="sv-file-info" class="file-info-line"></p>
          <div id="sv-encoding-wrap" class="encoding" hidden>
            <label for="sv-encoding">CSV 인코딩</label>
            <select id="sv-encoding">
              <option value="auto" selected>자동</option>
              <option value="utf-8">UTF-8</option>
              <option value="euc-kr">EUC-KR</option>
            </select>
          </div>
        </div>

        <div id="sv-tabs" class="sheet-tabs" role="tablist" aria-label="시트 선택"></div>
        <p id="sv-col-warning" class="notice" hidden></p>

        <div class="table-wrap">
          <table id="sv-table" class="sheet-table"></table>
        </div>

        <div class="pagination">
          <div class="pager">
            <button id="sv-first" class="icon-btn" type="button" aria-label="첫 페이지">«</button>
            <button id="sv-prev" class="icon-btn" type="button" aria-label="이전 페이지">‹</button>
            <span id="sv-page-info" class="page-info" aria-live="polite"></span>
            <button id="sv-next" class="icon-btn" type="button" aria-label="다음 페이지">›</button>
            <button id="sv-last" class="icon-btn" type="button" aria-label="마지막 페이지">»</button>
          </div>

          <label class="page-size">
            페이지당
            <select id="sv-page-size">
              <option value="25">25행</option>
              <option value="50" selected>50행</option>
              <option value="100">100행</option>
              <option value="200">200행</option>
            </select>
          </label>
        </div>

        <div class="tool-actions">
          <button id="sv-csv" class="btn btn-secondary" type="button">CSV로 내려받기</button>
          <button id="sv-json" class="btn btn-secondary" type="button">JSON으로 내려받기</button>
          <button id="sv-reset" class="btn btn-secondary" type="button">다른 파일 열기</button>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>지원 형식</h2>
      <table>
        <thead>
          <tr><th>형식</th><th>설명</th></tr>
        </thead>
        <tbody>
          <tr><td>CSV</td><td>쉼표 구분 텍스트. 인코딩(UTF-8·EUC-KR)을 선택할 수 있습니다.</td></tr>
          <tr><td>XLSX / XLS</td><td>엑셀 통합문서. 시트 탭으로 전환합니다.</td></tr>
          <tr><td>ODS</td><td>LibreOffice·구글 스프레드시트 형식.</td></tr>
        </tbody>
      </table>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>엑셀이 설치되지 않은 PC에서 표 내용을 확인할 때</li>
        <li>CSV가 깨져 보일 때 인코딩을 바꿔 다시 열 때</li>
        <li>시트 일부를 CSV·JSON으로 바꿔 다른 시스템에 넣을 때</li>
        <li>수식 결과(캐시된 값)를 빠르게 훑어볼 때</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>화면에는 한 번에 최대 <strong>100개 열</strong>만 표시합니다. 내려받기는 전체 열을 포함합니다.</li>
        <li>수식은 파일에 저장된 계산 결과를 보여줍니다. 수식을 다시 계산하지는 않습니다.</li>
        <li>병합된 셀은 값이 들어 있는 첫 셀에만 표시됩니다.</li>
        <li>암호가 걸린 통합문서는 열 수 없습니다. 암호를 해제한 뒤 사용하세요.</li>
        <li>50MB를 넘는 파일은 브라우저 메모리 부족으로 실패할 수 있습니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        표 읽기와 화면 표시이 모두 브라우저에서 실행됩니다. 급여명세서·거래내역처럼 민감한 표도
        서버에 올리지 않고 확인할 수 있습니다. 자세한 원리는
        <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initSheetViewer } from '../../scripts/sheet-viewer';

  initSheetViewer();
</script>

<style>
  .sheet-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block: 1rem 0.75rem;
  }

  .file-info-line {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .encoding {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
  }

  .encoding select {
    min-height: 34px;
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--surface);
  }

  .sheet-tabs {
    display: flex;
    gap: 0.3rem;
    overflow-x: auto;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
  }

  .sheet-tabs button {
    flex: none;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    background: var(--surface-muted);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }

  .sheet-tabs button[aria-selected='true'] {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .table-wrap {
    max-height: 520px;
    overflow: auto;
    border: 1px solid var(--line);
    border-top: none;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: var(--surface);
  }

  .sheet-table {
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.8rem;
    min-width: 100%;
  }

  .sheet-table th,
  .sheet-table td {
    max-width: 280px;
    padding: 0.4rem 0.55rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sheet-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--surface-muted);
    vertical-align: bottom;
  }

  .sheet-table .row-number {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 48px;
    background: var(--surface-muted);
    color: var(--muted);
    font-weight: 500;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .sheet-table thead .row-number {
    z-index: 3;
  }

  .sheet-table td.numeric {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .sheet-table tbody tr:nth-child(even) td {
    background: color-mix(in srgb, var(--surface-muted) 45%, transparent);
  }

  .col-label {
    display: block;
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .col-value {
    display: block;
    max-width: 260px;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.78rem;
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .pager {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .page-info {
    min-width: 190px;
    color: var(--muted);
    font-size: 0.78rem;
    text-align: center;
  }

  .page-size {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .page-size select {
    min-height: 34px;
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--surface);
  }

  @media (max-width: 640px) {
    .page-info {
      min-width: 0;
    }
  }
</style>
