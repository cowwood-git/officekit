---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('image-dpi');
if (!tool) throw new Error('image-dpi 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/image-dpi/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '이미지 DPI 변경', path },
  ]),
];
---

<BaseLayout title="이미지 DPI 변경 — 화질 그대로 300dpi·72dpi로 바꾸기" description={tool.description.ko} path={path} jsonLd={jsonLd}>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">이미지 DPI 변경</h2>
      <label class="dropzone" id="id-drop" for="id-input">
        <span class="dropzone-icon" aria-hidden="true">🖨️</span>
        <strong>DPI를 바꿀 JPG·PNG를 끌어다 놓으세요</strong>
        <small>JPG · PNG · 최대 50장</small>
        <input id="id-input" class="visually-hidden" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" multiple />
      </label>

      <p id="id-status" class="status" role="status" aria-live="polite"></p>
      <p id="id-error" class="error" role="alert" hidden></p>

      <div id="id-panel" class="stack" hidden>
        <div class="kit-row">
          <div class="field">
            <label for="id-preset">바꿀 DPI</label>
            <select id="id-preset">
              <option value="72">72dpi (화면용)</option>
              <option value="96">96dpi (윈도우 기본)</option>
              <option value="150">150dpi</option>
              <option value="300" selected>300dpi (인쇄·제출용)</option>
              <option value="350">350dpi</option>
              <option value="600">600dpi</option>
              <option value="custom">직접 입력</option>
            </select>
          </div>
          <div class="field">
            <label for="id-custom" class="visually-hidden">DPI 직접 입력</label>
            <input id="id-custom" type="number" min="1" max="65535" value="300" inputmode="numeric" hidden />
          </div>
        </div>

        <div class="id-table-wrap">
          <table class="id-table">
            <thead>
              <tr><th>파일</th><th>픽셀</th><th>지금 DPI · 인쇄 크기</th><th>바꾼 뒤</th></tr>
            </thead>
            <tbody id="id-rows"></tbody>
          </table>
        </div>

        <div class="tool-actions">
          <button id="id-apply" class="btn" type="button">DPI 바꾸기</button>
          <button id="id-reset" class="btn btn-secondary" type="button">처음부터</button>
        </div>

        <div id="id-result" class="result-panel" tabindex="-1" hidden>
          <p class="result-value">DPI를 바꿨습니다</p>
          <p id="id-result-note" class="kit-info"></p>
          <div class="tool-actions">
            <a id="id-download" class="btn" href="#">내려받기</a>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>DPI가 뭔가요</h2>
      <p>
        DPI(dots per inch)는 이미지를 인쇄할 때 1인치(2.54cm)에 픽셀 몇 개를 찍을지 적어 둔 값입니다. 화면에서는
        픽셀 수만 중요해서 DPI가 달라도 똑같이 보이지만, 인쇄하거나 한글·워드에 넣으면 이 값에 따라 크기가 달라집니다.
        3000×2000 픽셀 사진은 300dpi면 25.4×16.9cm, 72dpi면 105.8×70.6cm로 인쇄됩니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>공모전·출판사·인쇄소가 "300dpi 이상 파일"을 요구할 때</li>
        <li>한글·워드에 넣은 사진이 너무 크거나 작게 들어갈 때</li>
        <li>스캔본·캡처 이미지의 인쇄 크기를 맞출 때</li>
      </ul>

      <h2>화질은 그대로입니다</h2>
      <p>
        이 도구는 픽셀을 다시 그리지 않고 파일 안의 DPI 정보(JPG의 JFIF·EXIF, PNG의 pHYs)만 고칩니다. 그래서 화질과
        용량이 원본과 같습니다. 반대로 말하면 DPI를 올린다고 사진이 더 선명해지지는 않습니다. 실제 픽셀이 부족하면
        원하는 크기로 인쇄했을 때 흐릿할 수 있으니 표의 "바꾼 뒤" 인쇄 크기를 확인하세요. 픽셀 수 자체를 바꾸려면
        <a href="/tools/image-resize/">이미지 크기 조절</a>을 쓰세요.
      </p>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        파일을 읽고 처리하고 내려받는 과정이 모두 이 브라우저 안에서 끝납니다. 회사 문서나 개인 사진도
        외부 서버에 올리지 않습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initImageDpi } from '../../scripts/image-dpi';

  initImageDpi();
</script>

<style>
  .id-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .id-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }

  .id-table th,
  .id-table :global(td) {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
  }

  .id-table :global(td:first-child) {
    max-width: 14rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .id-table :global(td:last-child) {
    color: var(--accent-strong);
    font-weight: 700;
  }
</style>
