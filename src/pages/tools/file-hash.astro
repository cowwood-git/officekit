---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('file-hash');
if (!tool) throw new Error('file-hash 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/file-hash/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '파일 해시', path },
  ]),
];
---

<BaseLayout
  title="파일 해시 — SHA-256 무결성 확인"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">파일 해시 계산</h2>

      <label class="dropzone" id="fh-drop" for="fh-input">
        <span class="dropzone-icon" aria-hidden="true">#</span>
        <strong>해시를 확인할 파일을 끌어다 놓으세요</strong>
        <small>모든 파일 · 최대 100MB · 서버 전송 없음</small>
        <input id="fh-input" class="visually-hidden" type="file" />
      </label>

      <p id="fh-status" class="status" role="status" aria-live="polite"></p>
      <p id="fh-error" class="error" role="alert" hidden></p>

      <div id="fh-panel" hidden>
        <p id="fh-file" class="fh-file"></p>

        <div class="fh-controls">
          <div class="field">
            <label for="fh-algo">해시 알고리즘</label>
            <select id="fh-algo">
              <option value="SHA-256" selected>SHA-256 (권장)</option>
              <option value="SHA-512">SHA-512</option>
              <option value="SHA-384">SHA-384</option>
              <option value="SHA-1">SHA-1 (호환용)</option>
            </select>
          </div>
          <div class="tool-actions fh-actions">
            <button id="fh-run" class="btn" type="button">해시 계산</button>
            <button id="fh-reset" class="btn btn-secondary" type="button">다른 파일</button>
          </div>
        </div>

        <div id="fh-result" class="result-panel" tabindex="-1" hidden>
          <p id="fh-result-title" class="result-value">SHA-256 해시</p>

          <div class="fh-hash-row">
            <code id="fh-hash"></code>
            <button id="fh-copy" class="btn btn-secondary" type="button">복사</button>
          </div>

          <dl class="stat-grid fh-stats">
            <div class="stat"><dt>파일</dt><dd id="fh-result-name">-</dd></div>
            <div class="stat"><dt>크기</dt><dd id="fh-result-size">-</dd></div>
            <div class="stat"><dt>알고리즘</dt><dd id="fh-result-algo">-</dd></div>
          </dl>

          <div class="field fh-compare">
            <label for="fh-compare">비교할 해시</label>
            <input
              id="fh-compare"
              type="text"
              spellcheck="false"
              autocomplete="off"
              placeholder="배포 페이지에 적힌 해시를 붙여넣으세요"
            />
            <span id="fh-match" class="fh-match" role="status" aria-live="polite"></span>
          </div>

          <p class="hint">
            해시는 파일 내용의 지문입니다. 값이 같으면 같은 파일로 볼 수 있습니다. 파일 이름이나
            수정 날짜가 달라도 내용이 같으면 해시는 같습니다.
          </p>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>내려받은 설치 파일이 배포 페이지의 해시와 같은지 확인할 때</li>
        <li>메일·메신저로 받은 파일이 전송 중에 바뀌지 않았는지 확인할 때</li>
        <li>같은 파일인지 이름 대신 내용으로 비교할 때</li>
        <li>백업·배포 파일의 무결성을 기록해 둘 때</li>
      </ul>

      <h2>해시란 무엇인가요</h2>
      <p>
        파일 내용을 고정된 길이의 문자열로 바꾼 값입니다. 내용이 한 글자라도 달라지면 완전히 다른
        값이 나오고, 해시만 보고 원래 내용을 복원하기는 어렵습니다. 그래서 파일이 변조되지 않았는지
        확인하는 데 씁니다.
      </p>

      <h2>알고리즘 선택</h2>
      <ul>
        <li><strong>SHA-256</strong> — 가장 널리 쓰이는 무결성 확인용입니다. 대부분 이 값을 확인하면 됩니다.</li>
        <li><strong>SHA-512·SHA-384</strong> — 더 긴 지문이 필요한 경우에 씁니다.</li>
        <li><strong>SHA-1</strong> — 오래된 배포 파일과의 호환용입니다. 보안 목적의 새 용도로는 권장하지 않습니다.</li>
        <li>MD5는 제공하지 않습니다. 충돌 위험이 커서 무결성 확인용으로 권장하기 어렵습니다.</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>파일은 서버로 전송되지 않고 브라우저 메모리에서만 읽습니다.</li>
        <li>한 번에 최대 100MB까지 계산합니다. 더 큰 파일은 나눠서 확인하세요.</li>
        <li>해시가 같다는 것은 내용이 같다는 뜻이지, 파일이 안전하다는 뜻은 아닙니다.</li>
        <li>공식 배포처의 해시와 비교할 때는 출처가 신뢰할 수 있는지도 함께 확인하세요.</li>
      </ul>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initFileHash } from '../../scripts/file-hash';

  initFileHash();
</script>

<style>
  .fh-file {
    margin: 1rem 0 0.6rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .fh-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: end;
  }

  .fh-actions {
    margin-top: 0;
  }

  .fh-hash-row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }

  .fh-hash-row code {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .fh-hash-row .btn {
    flex: none;
  }

  .fh-stats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .fh-stats dd {
    overflow-wrap: anywhere;
  }

  .fh-compare {
    margin-top: 1rem;
  }

  .fh-match {
    min-height: 1.4em;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .fh-match[data-state='match'] {
    color: var(--accent-strong);
  }

  .fh-match[data-state='mismatch'] {
    color: #b91c1c;
  }

  @media (max-width: 720px) {
    .fh-controls {
      grid-template-columns: 1fr;
    }

    .fh-actions {
      width: 100%;
    }

    .fh-actions .btn {
      flex: 1;
    }

    .fh-hash-row {
      display: grid;
      grid-template-columns: 1fr;
    }

    .fh-hash-row .btn {
      width: 100%;
    }

    .fh-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
