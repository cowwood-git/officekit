---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('seal-maker');
if (!tool) throw new Error('seal-maker 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/seal-maker/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '도장·서명 만들기', path },
  ]),
];
---

<BaseLayout
  title="도장·서명 만들기 — 투명 PNG로 저장"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">도장·서명 만들기</h2>

      <fieldset class="mode-switch">
        <legend class="visually-hidden">만들기 종류</legend>
        <label>
          <input id="sm-mode-seal" type="radio" name="sm-mode" value="seal" checked />
          <span>글자 도장</span>
        </label>
        <label>
          <input id="sm-mode-sign" type="radio" name="sm-mode" value="sign" />
          <span>손글씨 서명</span>
        </label>
      </fieldset>

      <div class="sm-layout">
        <div class="sm-controls">
          <div id="sm-seal-panel">
            <div class="field">
              <label for="sm-text">도장 글자</label>
              <textarea
                id="sm-text"
                rows="3"
                maxlength="56"
                placeholder="예: 옷깃&#10;대표 홍길동"
              ></textarea>
              <span class="hint">한 줄에 한 문장씩, 최대 3줄·줄당 16자까지 들어갑니다.</span>
            </div>

            <div class="sm-row">
              <div class="field">
                <label for="sm-shape">모양</label>
                <select id="sm-shape">
                  <option value="circle" selected>원형</option>
                  <option value="square">사각</option>
                </select>
              </div>
              <div class="field sm-color-field">
                <label for="sm-color">색</label>
                <input id="sm-color" type="color" value="#b83a2f" />
              </div>
            </div>

            <div class="field">
              <label for="sm-border">
                테두리 두께 <output id="sm-border-value">10</output>
              </label>
              <input id="sm-border" type="range" min="2" max="24" step="1" value="10" />
            </div>

            <div class="field">
              <label for="sm-rotation">
                기울기 <output id="sm-rotation-value">0°</output>
              </label>
              <input id="sm-rotation" type="range" min="-20" max="20" step="1" value="0" />
            </div>

            <div class="field">
              <label for="sm-size">저장 크기</label>
              <select id="sm-size">
                <option value="600">600 × 600px</option>
                <option value="1200" selected>1200 × 1200px</option>
              </select>
              <span class="hint">배경은 투명한 PNG로 저장됩니다.</span>
            </div>
          </div>

          <div id="sm-sign-panel" hidden>
            <div class="sm-row">
              <div class="field sm-color-field">
                <label for="sm-pen-color">펜 색</label>
                <input id="sm-pen-color" type="color" value="#111827" />
              </div>
              <div class="field">
                <label for="sm-pen-width">
                  펜 굵기 <output id="sm-pen-width-value">4</output>
                </label>
                <input id="sm-pen-width" type="range" min="1" max="14" step="1" value="4" />
              </div>
            </div>
            <p class="hint">오른쪽 서명판에 마우스나 손가락으로 서명하세요.</p>
            <div class="tool-actions">
              <button id="sm-undo" class="btn btn-secondary" type="button">한 획 되돌리기</button>
              <button id="sm-clear" class="btn btn-secondary" type="button">전체 지우기</button>
            </div>
          </div>
        </div>

        <div class="sm-preview">
          <div id="sm-stage" class="sm-stage">
            <canvas
              id="sm-canvas"
              width="800"
              height="800"
              aria-label="도장 미리보기"
            ></canvas>
          </div>

          <div class="tool-actions sm-actions">
            <button id="sm-download" class="btn" type="button" disabled>PNG 내려받기</button>
            <button id="sm-reset" class="btn btn-secondary" type="button">처음으로</button>
          </div>

          <p id="sm-status" class="status" role="status" aria-live="polite"></p>
          <p id="sm-error" class="error" role="alert" hidden></p>
          <p class="hint">
            배경은 투명합니다. 만든 PNG는
            <a href="/tools/pdf-sign/">PDF 서명·도장</a> 도구에서 PDF에 바로 넣을 수 있습니다.
          </p>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>계약서·견적서에 넣을 개인 서명 이미지가 필요할 때</li>
        <li>회사 이름이나 직함이 들어간 간단한 도장을 만들 때</li>
        <li>PDF에 넣을 투명 PNG 도장·서명을 빠르게 준비할 때</li>
        <li>이미지 편집 프로그램 없이 서명을 남기고 싶을 때</li>
      </ul>

      <h2>만드는 방법</h2>
      <ul>
        <li><strong>글자 도장</strong> — 글자를 입력하고 모양·색·테두리·기울기를 고릅니다.</li>
        <li><strong>손글씨 서명</strong> — 오른쪽 서명판에 직접 그립니다. 한 획씩 되돌릴 수 있습니다.</li>
        <li>결과는 배경이 투명한 PNG라서 PDF·문서·이미지 위에 자연스럽게 올라갑니다.</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>이 도구는 <strong>개인용·참고용</strong> 이미지를 만듭니다. 법인 인감·공식 도장의 법적 효력을 대신하지 않습니다.</li>
        <li>공식 인감은 관할 기관의 등록 절차를 따라야 합니다.</li>
        <li>이미지·글자는 브라우저 안에서만 처리되며 서버로 전송되지 않습니다.</li>
        <li>인쇄물에 사용할 때는 실제 크기와 해상도를 확인하세요.</li>
      </ul>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initSealMaker } from '../../scripts/seal-maker';

  initSealMaker();
</script>

<style>
  .mode-switch {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.3rem;
    margin: 0 0 1.2rem;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-muted);
  }

  .mode-switch label {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
  }

  .mode-switch input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .mode-switch label:has(input:checked) {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .mode-switch label:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .sm-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
    gap: 1.25rem;
    align-items: start;
  }

  .sm-controls {
    display: grid;
    gap: 0.85rem;
  }

  .sm-preview {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 0.7rem;
  }

  .sm-stage {
    display: grid;
    place-items: center;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: #fff;
    background-image:
      linear-gradient(45deg, #ebebeb 25%, transparent 25%),
      linear-gradient(-45deg, #ebebeb 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #ebebeb 75%),
      linear-gradient(-45deg, transparent 75%, #ebebeb 75%);
    background-position:
      0 0,
      0 8px,
      8px -8px,
      -8px 0;
    background-size: 16px 16px;
  }

  .sm-stage canvas {
    display: block;
    width: min(100%, 280px);
    height: auto;
    touch-action: none;
  }

  .sm-stage[data-mode='sign'] canvas {
    width: min(100%, 360px);
    cursor: crosshair;
  }

  .sm-stage canvas:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .sm-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: end;
  }

  .sm-color-field input[type='color'] {
    width: 100%;
    min-height: 46px;
    padding: 0.25rem;
    cursor: pointer;
  }

  .sm-actions {
    margin-top: 0;
  }

  .sm-controls output {
    color: var(--accent-strong);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 820px) {
    .sm-layout {
      grid-template-columns: 1fr;
    }

    .sm-preview {
      position: static;
      order: -1;
    }
  }
</style>
