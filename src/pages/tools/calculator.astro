---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('calculator');
if (!tool) throw new Error('calculator 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/calculator/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '계산기', path },
  ]),
];

/** 공학 키: [표시, 넣을 식 | 동작, 접근성 이름] */
type Key = { label: string; insert?: string; action?: string; aria?: string };
const sciKeys: Key[] = [
  { label: '(', insert: '(' },
  { label: ')', insert: ')' },
  { label: '2nd', action: 'second', aria: '역삼각함수로 바꾸기' },
  { label: 'Deg', action: 'angle' },
  { label: 'π', insert: 'π', aria: '파이' },
  { label: 'x²', insert: '^2', aria: '제곱' },
  { label: 'xʸ', insert: '^', aria: '거듭제곱' },
  { label: '√', insert: '√(', aria: '제곱근' },
  { label: '∛', insert: '∛(', aria: '세제곱근' },
  { label: '1/x', insert: '^(−1)', aria: '역수' },
  { label: 'sin', insert: 'sin(' },
  { label: 'cos', insert: 'cos(' },
  { label: 'tan', insert: 'tan(' },
  { label: 'ln', insert: 'ln(', aria: '자연로그' },
  { label: 'log', insert: 'log(', aria: '상용로그' },
  { label: 'eˣ', insert: 'e^(', aria: 'e의 거듭제곱' },
  { label: '10ˣ', insert: '10^(', aria: '10의 거듭제곱' },
  { label: 'x!', insert: '!', aria: '팩토리얼' },
  { label: 'e', insert: 'e', aria: '자연상수 e' },
  { label: 'Ans', action: 'ans', aria: '직전 결과' },
];

/** 기본 키 — 아이폰 계산기와 같은 4열 배치 */
const basicKeys: (Key & { kind: 'fn' | 'num' | 'op' | 'eq'; wide?: boolean })[] = [
  { label: 'AC', action: 'clear', kind: 'fn', aria: 'AC 모두 지우기' },
  { label: '⌫', action: 'back', kind: 'fn', aria: '한 글자 지우기' },
  { label: '%', insert: '%', kind: 'fn', aria: '퍼센트' },
  { label: '÷', insert: '÷', kind: 'op', aria: '나누기' },
  { label: '7', insert: '7', kind: 'num' },
  { label: '8', insert: '8', kind: 'num' },
  { label: '9', insert: '9', kind: 'num' },
  { label: '×', insert: '×', kind: 'op', aria: '곱하기' },
  { label: '4', insert: '4', kind: 'num' },
  { label: '5', insert: '5', kind: 'num' },
  { label: '6', insert: '6', kind: 'num' },
  { label: '−', insert: '−', kind: 'op', aria: '빼기' },
  { label: '1', insert: '1', kind: 'num' },
  { label: '2', insert: '2', kind: 'num' },
  { label: '3', insert: '3', kind: 'num' },
  { label: '+', insert: '+', kind: 'op', aria: '더하기' },
  { label: '±', action: 'negate', kind: 'num', aria: '부호 바꾸기' },
  { label: '0', insert: '0', kind: 'num' },
  { label: '.', insert: '.', kind: 'num', aria: '소수점' },
  { label: '=', action: 'equals', kind: 'eq', aria: '계산' },
];
---

<BaseLayout
  title="계산기 — 기본·공학 계산기 (sin·log·제곱근)"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="calc-wrap" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">계산기</h2>

      <div id="calc" class="calc" data-mode="basic">
        <div class="calc-top">
          <div class="calc-modes" role="group" aria-label="계산기 종류">
            <button type="button" data-mode-tab="basic" aria-pressed="true">기본</button>
            <button type="button" data-mode-tab="sci" aria-pressed="false">공학</button>
          </div>
          <button id="calc-copy" type="button" class="calc-copy">결과 복사</button>
        </div>

        <div class="calc-display">
          <div id="calc-expr" class="calc-expr">&nbsp;</div>
          <output id="calc-result" class="calc-result" aria-live="polite" data-state="input"
            >0</output
          >
        </div>

        <div class="calc-keys">
          <div class="calc-sci" aria-label="공학 키">
            {
              sciKeys.map((key) => (
                <button
                  type="button"
                  class="key key-sci"
                  data-insert={key.insert}
                  data-action={key.action}
                  aria-label={key.aria}
                  aria-pressed={key.action === 'second' ? 'false' : undefined}
                >
                  {key.label}
                </button>
              ))
            }
          </div>
          <div class="calc-basic">
            {
              basicKeys.map((key) => (
                <button
                  type="button"
                  class={`key key-${key.kind}`}
                  data-insert={key.insert}
                  data-action={key.action}
                  aria-label={key.aria}
                >
                  {key.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <aside class="calc-history-wrap" aria-labelledby="calc-history-title">
        <div class="calc-history-head">
          <h3 id="calc-history-title">기록</h3>
          <button id="calc-history-clear" type="button" class="calc-history-clear" hidden
            >기록 지우기</button
          >
        </div>
        <p id="calc-history-empty" class="muted">= 을 누르면 식과 결과가 최근 10개까지 남습니다.</p>
        <ol id="calc-history" class="calc-history"></ol>
        <p class="hint">기록은 이 탭에만 있고, 페이지를 닫으면 사라집니다.</p>
      </aside>
    </section>

    <div class="prose">
      <h2>기본 계산기와 공학 계산기</h2>
      <p>
        처음에는 사칙연산과 퍼센트만 있는 <strong>기본 계산기</strong>가 나옵니다. 위의
        <strong>공학</strong>을 누르면 삼각함수·로그·거듭제곱·제곱근·팩토리얼 키가 더해진
        <strong>공학 계산기</strong>로 바뀝니다. 마지막으로 고른 종류는 이 브라우저에 기억되어 다음에
        열 때 그대로 나옵니다.
      </p>
      <p>
        아이폰 계산기처럼, 입력하는 동안에는 큰 글씨로 식이 그대로 보이고 미리 계산하지 않습니다.
        <kbd>=</kbd>을 누르면 식은 위 줄로 올라가고 결과가 나오며 기록에 남습니다. 결과 다음에 숫자를 누르면 새 계산을
        시작하고, 연산자를 누르면 앞의 식을 그대로 살려 이어서 계산합니다. 예를 들어
        <code>5154×6</code> 다음에 <code>×6</code>을 누르면 위 줄에 <code>5154 × 6 × 6 =</code>이
        보이고, 기록에는 <code>5154 × 6 = 30,924</code>, <code>× 6 = 185,544</code>처럼 단계별로
        묶여 남습니다. <code>2+3</code> 다음에 <code>×4</code>를 누르면 <code>(2+3) × 4</code>로
        괄호를 넣어 계산 순서가 바뀌지 않게 합니다.
      </p>

      <h2>키 설명</h2>
      <ul>
        <li>
          <strong>% </strong>— 아이폰 계산기와 같습니다. <code>200×15%</code>는 30,
          <code>10000+10%</code>는 11,000(10% 더하기), <code>10000−10%</code>는 9,000입니다.
        </li>
        <li><strong>±</strong> — 마지막 숫자의 부호를 바꿉니다.</li>
        <li><strong>2nd</strong> — sin·cos·tan을 역함수(sin⁻¹·cos⁻¹·tan⁻¹)로 바꿉니다.</li>
        <li>
          <strong>Deg / Rad</strong> — 삼각함수의 각도 단위입니다. 기본은 도(Deg)이고, 누르면
          라디안(Rad)으로 바뀝니다.
        </li>
        <li><strong>ln / log</strong> — 자연로그(밑 e)와 상용로그(밑 10)입니다.</li>
        <li><strong>Ans</strong> — 직전 결과를 식에 넣습니다.</li>
        <li><code>2π</code>, <code>3(4+5)</code>처럼 곱하기를 생략해도 곱셈으로 계산합니다.</li>
      </ul>

      <h2>키보드로 쓰기</h2>
      <p>
        숫자와 <kbd>+</kbd> <kbd>-</kbd> <kbd>*</kbd> <kbd>/</kbd> <kbd>^</kbd> <kbd>(</kbd>
        <kbd>)</kbd> <kbd>%</kbd> <kbd>!</kbd>를 그대로 칠 수 있습니다. <kbd>Enter</kbd>는 계산,
        <kbd>Backspace</kbd>는 한 글자 지우기, <kbd>Esc</kbd>는 모두 지우기입니다.
      </p>

      <h2>알아두세요</h2>
      <ul>
        <li>
          계산은 연산자 우선순위를 따릅니다. <code>1+2×3</code>은 7입니다. 아이폰 기본 계산기와 같고,
          누른 순서대로 계산하는 일부 탁상 계산기와는 다릅니다.
        </li>
        <li>
          <code>0.1+0.2</code>처럼 컴퓨터가 정확히 나타내지 못하는 소수는 12자리에서 정리해 0.3으로
          보여 줍니다.
        </li>
        <li><code>-2^2</code>는 -(2²) = -4입니다. 음수를 제곱하려면 <code>(-2)^2</code>로 쓰세요.</li>
        <li>회계·세금처럼 원 단위 반올림 규칙이 중요한 계산은 퍼센트·부가세 계산기를 쓰세요.</li>
      </ul>

      <h2>입력한 식은 서버로 가지 않습니다</h2>
      <p>
        계산은 모두 이 브라우저 안에서 실행되고, 식과 결과는 어디에도 전송되지 않습니다. 기록도
        이 탭에서만 유지되고 페이지를 닫으면 지워집니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initCalculator } from '../../scripts/calculator';

  initCalculator();
</script>

<style>
  .calc-wrap {
    display: grid;
    gap: 1rem;
    justify-items: center;
  }

  .calc {
    width: 100%;
    max-width: 380px;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .calc[data-mode='sci'] {
    max-width: 820px;
  }

  .calc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .calc-modes {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--surface-muted);
  }

  .calc-modes button {
    min-width: 64px;
    min-height: 32px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-weight: 600;
    cursor: pointer;
  }

  .calc-modes button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .calc-copy {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    padding: 0.25rem 0.75rem;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .calc-copy:hover,
  .calc-copy:focus-visible {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .calc-display {
    margin: 1rem 0 0.9rem;
    padding: 0.5rem 0.25rem;
    text-align: right;
    min-width: 0;
  }

  .calc-expr {
    min-height: 1.5em;
    color: var(--muted);
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  /* 이어 쓴 식이 길면 앞부분을 흐리게: 끝(최근 연산)이 또렷하게 보인다 */
  .calc-expr[data-overflow],
  .calc-result[data-overflow] {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 2.5rem);
    mask-image: linear-gradient(to right, transparent, #000 2.5rem);
  }

  .calc-expr::-webkit-scrollbar,
  .calc-result::-webkit-scrollbar {
    display: none;
  }

  /* 큰 줄은 언제나 한 줄. 넘치면 스크립트가 글자 크기를 줄인다. */
  .calc-result {
    display: block;
    margin-top: 0.15rem;
    min-height: 1.2em;
    font-size: clamp(2.2rem, 7vw, 3rem);
    font-weight: 300;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
    color: var(--ink);
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .calc-result[data-state='error'] {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 2.6rem;
    color: var(--danger, #e5484d);
  }

  .calc-copy:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .calc-keys {
    display: grid;
    gap: 0.6rem;
  }

  .calc[data-mode='basic'] .calc-sci {
    display: none;
  }

  .calc[data-mode='sci'] .calc-keys {
    grid-template-columns: 5fr 4fr;
    align-items: start;
  }

  .calc-sci,
  .calc-basic {
    display: grid;
    gap: 0.5rem;
  }

  .calc-sci {
    grid-template-columns: repeat(5, 1fr);
  }

  .calc-basic {
    grid-template-columns: repeat(4, 1fr);
  }

  .key {
    min-height: 56px;
    border: 0;
    border-radius: 999px;
    font-size: 1.35rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      filter 0.12s ease,
      transform 0.06s ease;
  }

  .key:hover {
    filter: brightness(1.12);
  }

  .key:active {
    transform: scale(0.96);
  }

  .key:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .key-num {
    background: var(--surface-muted);
    color: var(--ink);
  }

  .key-fn {
    background: var(--line);
    color: var(--ink);
  }

  .key-op,
  .key-eq {
    background: var(--warn);
    color: var(--bg);
    font-size: 1.6rem;
  }

  .key-eq {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .key-sci {
    min-height: 46px;
    border-radius: 14px;
    background: var(--surface-muted);
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .key-sci[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .calc[data-mode='sci'] .calc-basic .key {
    min-height: 46px;
    border-radius: 14px;
    font-size: 1.15rem;
  }

  /* 좁은 화면: 공학 키를 기본 키 위에 쌓는다 */
  @media (max-width: 720px) {
    .calc[data-mode='sci'] {
      max-width: 420px;
    }

    .calc[data-mode='sci'] .calc-keys {
      grid-template-columns: 1fr;
    }

    .key-sci {
      min-height: 40px;
      font-size: 0.9rem;
    }
  }

  .calc-history-wrap {
    width: 100%;
    max-width: 380px;
  }

  .calc[data-mode='sci'] + .calc-history-wrap {
    max-width: 820px;
  }

  .calc-history-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .calc-history-head h3 {
    margin: 0;
    font-size: 0.95rem;
  }

  .calc-history-clear {
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    padding: 0.25rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .calc-history-clear:hover,
  .calc-history-clear:focus-visible {
    color: var(--ink);
    background: var(--surface-muted);
  }

  /* 기록은 계산기 카드와 같은 톤의 목록: 윗줄 "식 =", 아랫줄 결과(오른쪽 정렬) */
  .calc-history {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .calc-history:empty {
    display: none;
  }

  /* 기록 줄은 스크립트가 만들므로 범위 스타일이 닿지 않는다 → :global */
  .calc-history :global(li + li) {
    border-top: 1px solid var(--line);
  }

  .calc-history :global(.calc-history-item) {
    display: grid;
    width: 100%;
    gap: 0.15rem;
    padding: 0.65rem 0.9rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    text-align: right;
    cursor: pointer;
  }

  /* 이어서 한 계산 단계: 같은 칸 안에서 점선으로 잇는다 */
  .calc-history :global(.calc-history-item.is-step) {
    position: relative;
    padding-top: 0.45rem;
  }

  .calc-history :global(.calc-history-item.is-step)::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0.9rem;
    left: 0.9rem;
    border-top: 1px dashed var(--line);
  }

  .calc-history :global(.calc-history-item:hover),
  .calc-history :global(.calc-history-item:focus-visible) {
    background: var(--surface-muted);
  }

  .calc-history :global(.calc-history-item:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .calc-history :global(.calc-history-expr) {
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .calc-history :global(.calc-history-value) {
    font-size: 1.25rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .calc-history-wrap .hint {
    margin-top: 0.5rem;
  }
</style>
