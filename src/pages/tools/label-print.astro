---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';
import { LABEL_PRESETS } from '@/lib/label-print';

const tool = getTool('label-print');
if (!tool) throw new Error('label-print 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/label-print/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '라벨·봉투 인쇄', path },
  ]),
];
---

<BaseLayout
  title="라벨·봉투 인쇄 — CSV 주소를 A4 PDF로"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">라벨·봉투 인쇄</h2>

      <div class="lp-layout">
        <div class="lp-controls">
          <section class="lp-block" aria-labelledby="lp-layout-title">
            <div class="lp-block-head">
              <h3 id="lp-layout-title">1. 라벨 규격</h3>
              <span id="lp-size-note" class="hint"></span>
            </div>

            <div class="lp-grid">
              <div class="field">
                <label for="lp-preset">규격</label>
                <select id="lp-preset">
                  {
                    LABEL_PRESETS.map((preset) => (
                      <option value={preset.id} selected={preset.id === 'sheet-3x8'}>
                        {preset.label}
                      </option>
                    ))
                  }
                </select>
                <span id="lp-preset-note" class="hint"></span>
              </div>
              <div class="field">
                <label for="lp-start">시작 위치</label>
                <input id="lp-start" type="number" min="1" max="24" value="1" />
                <span class="hint">앞의 빈 칸을 건너뜁니다.</span>
              </div>
            </div>

            <div id="lp-custom" class="lp-grid" hidden>
              <div class="field">
                <label for="lp-columns">열</label>
                <input id="lp-columns" type="number" min="1" max="8" value="3" />
              </div>
              <div class="field">
                <label for="lp-rows-count">행</label>
                <input id="lp-rows-count" type="number" min="1" max="12" value="8" />
              </div>
              <div class="field">
                <label for="lp-margin">여백(mm)</label>
                <input id="lp-margin" type="number" min="0" max="30" value="10" />
              </div>
              <div class="field">
                <label for="lp-gap">간격(mm)</label>
                <input id="lp-gap" type="number" min="0" max="10" value="2" />
              </div>
            </div>

            <div class="lp-grid">
              <div class="field">
                <label for="lp-font">글자 크기</label>
                <select id="lp-font">
                  <option value="8">작게</option>
                  <option value="9.5" selected>보통</option>
                  <option value="11">크게</option>
                </select>
              </div>
              <label class="lp-check">
                <input id="lp-border" type="checkbox" />
                <span>라벨 테두리 인쇄</span>
              </label>
            </div>
          </section>

          <section class="lp-block" aria-labelledby="lp-content-title">
            <div class="lp-block-head">
              <h3 id="lp-content-title">2. 라벨 내용</h3>
              <span id="lp-count" class="badge">0개</span>
            </div>

            <div class="lp-tools">
              <label class="btn btn-secondary" for="lp-file">CSV·XLSX 불러오기</label>
              <input
                id="lp-file"
                class="visually-hidden"
                type="file"
                accept=".csv,.tsv,.xlsx,.xls"
              />
              <button id="lp-sample" class="btn btn-secondary" type="button">예시 채우기</button>
              <button id="lp-add" class="btn btn-secondary" type="button">+ 라벨 추가</button>
            </div>
            <p id="lp-import-note" class="hint"></p>
            <div id="lp-rows" class="lp-rows"></div>
          </section>

          <div class="tool-actions">
            <button id="lp-generate" class="btn" type="button">PDF 만들기</button>
            <button id="lp-reset" class="btn btn-secondary" type="button">새로 작성</button>
          </div>

          <p id="lp-status" class="status" role="status" aria-live="polite"></p>
          <p id="lp-error" class="error" role="alert" hidden></p>
        </div>

        <aside class="lp-preview-side" aria-label="라벨 미리보기">
          <div class="lp-preview-head">
            <h3>미리보기</h3>
            <span id="lp-page-note" class="hint"></span>
          </div>
          <div id="lp-preview" class="lp-preview" aria-hidden="true"></div>
          <p class="hint">
            실제 인쇄는 프린터에서 <strong>실제 크기(100%)</strong>로 설정하세요. 라벨지 규격은
            구매한 제품의 안내를 먼저 확인하세요.
          </p>

          <div id="lp-result" class="result-panel" tabindex="-1" hidden>
            <p class="result-value">라벨 PDF가 준비됐습니다</p>
            <dl class="stat-grid">
              <div class="stat"><dt>파일 크기</dt><dd id="lp-result-size">-</dd></div>
              <div class="stat"><dt>형식</dt><dd>A4 PDF</dd></div>
            </dl>
            <div class="tool-actions">
              <a id="lp-download" class="btn" href="#" hidden>PDF 내려받기</a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <div class="prose">
      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>거래처 주소를 라벨지에 인쇄할 때</li>
        <li>우편 발송용 주소 라벨을 만들 때</li>
        <li>행사 이름표·택배 라벨을 한 번에 만들 때</li>
        <li>DL 봉투에 받는 사람 주소를 바로 인쇄할 때</li>
      </ul>

      <h2>CSV 준비</h2>
      <p>
        첫 행에 <strong>이름·우편번호·주소·연락처</strong> 중 하나 이상이 있으면 열 이름을 보고
        자동으로 맞춥니다. 머리글이 없으면 첫 열을 이름, 둘째 열을 주소, 셋째 열을 연락처로
        읽습니다. 주소만 있는 한 열짜리 목록도 사용할 수 있습니다.
      </p>

      <h2>인쇄 전 확인</h2>
      <ul>
        <li>프린터 설정에서 <strong>실제 크기(100%)</strong>를 고르세요. ‘페이지에 맞춤’은 라벨이 어긋납니다.</li>
        <li>라벨지의 행·열·여백은 제품마다 조금씩 다릅니다. 먼저 한 장만 테스트 인쇄하세요.</li>
        <li>DL 봉투는 프린터의 봉투 급지 방향과 용지 설정을 확인하세요.</li>
        <li>테두리는 기본으로 인쇄하지 않습니다. 위치 확인이 필요할 때만 켜세요.</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>주소·이름은 브라우저 안에서만 처리되며 서버로 전송되지 않습니다.</li>
        <li>한 번에 최대 200개 라벨까지 만들 수 있습니다.</li>
        <li>PDF는 나눔고딕으로 그려 한글이 깨지지 않습니다.</li>
        <li>QR 코드·로고·바코드는 1차 버전에서 지원하지 않습니다.</li>
      </ul>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initLabelPrint } from '../../scripts/label-print';

  initLabelPrint();
</script>

<style>
  .lp-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    gap: 1.25rem;
    align-items: start;
  }

  .lp-controls {
    display: grid;
    gap: 1rem;
  }

  .lp-block {
    display: grid;
    gap: 0.7rem;
  }

  .lp-block + .lp-block {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .lp-block-head,
  .lp-preview-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .lp-block-head h3,
  .lp-preview-head h3 {
    margin: 0;
    font-size: 0.96rem;
    font-weight: 800;
  }

  .lp-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    align-items: end;
  }

  .lp-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    align-self: end;
    min-height: 46px;
    color: var(--ink-soft);
    font-size: 0.84rem;
    cursor: pointer;
  }

  .lp-check input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--accent);
  }

  .lp-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .lp-tools .btn {
    min-height: 40px;
    padding: 0.45rem 0.75rem;
    font-size: 0.82rem;
  }

  .lp-rows {
    display: grid;
    gap: 0.55rem;
  }

  :global(.lp-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.5rem 9rem 2.25rem;
    grid-template-areas:
      'name postal phone remove'
      'address address address address';
    gap: 0.45rem;
    padding: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--surface-muted);
  }

  :global(.lp-row .lp-field) {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  :global(.lp-row .lp-field label) {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 600;
  }

  :global(.lp-row .lp-field input),
  :global(.lp-row .lp-field textarea) {
    width: 100%;
    min-width: 0;
    min-height: 38px;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--surface);
    font-size: 0.82rem;
  }

  :global(.lp-row .lp-field textarea) {
    resize: vertical;
    line-height: 1.4;
  }

  :global(.lp-name) {
    grid-area: name;
  }

  :global(.lp-postal) {
    grid-area: postal;
  }

  :global(.lp-phone) {
    grid-area: phone;
  }

  :global(.lp-address) {
    grid-area: address;
  }

  :global(.lp-remove) {
    grid-area: remove;
    width: 2.25rem;
    height: 38px;
    align-self: end;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  :global(.lp-remove:hover) {
    border-color: var(--warn);
    background: var(--warn-soft);
    color: var(--warn);
  }

  .lp-preview-side {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 0.7rem;
  }

  .lp-preview {
    position: relative;
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #fff;
    box-shadow: var(--shadow-sm);
  }

  :global(.lp-preview .lp-cell) {
    position: absolute;
    box-sizing: border-box;
    padding: 2%;
    overflow: hidden;
    border: 1px dashed #d9d9d9;
    background: #fff;
    color: #111;
    font-size: clamp(0.4rem, 0.55vw, 0.62rem);
    line-height: 1.25;
  }

  :global(.lp-preview .lp-cell.is-empty) {
    border-color: #eee;
    background: #fbfbfb;
  }

  :global(.lp-preview .lp-cell strong) {
    display: block;
    overflow: hidden;
    font-size: 1.12em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.lp-preview .lp-cell span) {
    display: block;
    overflow-wrap: anywhere;
  }

  :global(.lp-preview .lp-cell small) {
    display: block;
    color: #555;
    font-size: 0.9em;
  }

  .lp-preview-side .result-panel {
    margin-top: 0.2rem;
  }

  @media (max-width: 900px) {
    .lp-layout {
      grid-template-columns: 1fr;
    }

    .lp-preview-side {
      position: static;
    }

    .lp-preview {
      max-width: 420px;
    }
  }

  @media (max-width: 620px) {
    :global(.lp-row) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 2.25rem;
      grid-template-areas:
        'name name remove'
        'postal phone phone'
        'address address address';
    }

    .lp-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
