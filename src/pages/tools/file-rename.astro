---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('file-rename');
if (!tool) throw new Error('file-rename 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/file-rename/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '파일 이름 일괄 변경', path },
  ]),
];
---

<BaseLayout title="파일 이름 일괄 변경 — 순번·날짜·찾아 바꾸기로 한 번에" description={tool.description.ko} path={path} jsonLd={jsonLd}>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">파일 이름 일괄 변경</h2>
      <label class="dropzone" id="fr-drop" for="fr-input">
        <span class="dropzone-icon" aria-hidden="true">🏷️</span>
        <strong>이름을 바꿀 파일들을 끌어다 놓으세요</strong>
        <small>파일 종류 상관없이 최대 500개 · 500MB</small>
        <input id="fr-input" class="visually-hidden" type="file" multiple />
      </label>

      <p id="fr-status" class="status" role="status" aria-live="polite"></p>
      <p id="fr-error" class="error" role="alert" hidden></p>

      <div id="fr-panel" class="stack" hidden>
        <div class="field">
          <label for="fr-template">새 이름 틀</label>
          <input id="fr-template" type="text" value="{name}" autocomplete="off" spellcheck="false" />
          <div class="kit-row">
            <button class="btn btn-secondary fr-token" type="button" data-fr-token="{name}">+ 원래 이름</button>
            <button class="btn btn-secondary fr-token" type="button" data-fr-token="{n}">+ 순번</button>
            <button class="btn btn-secondary fr-token" type="button" data-fr-token="{date}">+ 오늘 날짜</button>
          </div>
          <span class="hint">예: <code>제주여행_{'{n}'}</code> → 제주여행_01.jpg, 제주여행_02.jpg … 확장자는 그대로 둡니다.</span>
        </div>
        <div class="kit-grid">
          <div class="field">
            <label for="fr-find">찾을 글자</label>
            <input id="fr-find" type="text" autocomplete="off" spellcheck="false" placeholder="예: IMG_" />
          </div>
          <div class="field">
            <label for="fr-replace">바꿀 글자</label>
            <input id="fr-replace" type="text" autocomplete="off" spellcheck="false" placeholder="비우면 지웁니다" />
          </div>
          <div class="field">
            <label for="fr-start">순번 시작</label>
            <input id="fr-start" type="number" min="0" value="1" inputmode="numeric" />
          </div>
          <div class="field">
            <label for="fr-digits">순번 자리 수</label>
            <select id="fr-digits">
              <option value="1">1 → 1, 2, 3</option>
              <option value="2" selected>2 → 01, 02</option>
              <option value="3">3 → 001, 002</option>
              <option value="4">4 → 0001</option>
            </select>
          </div>
          <div class="field">
            <label for="fr-case">대소문자</label>
            <select id="fr-case">
              <option value="keep">그대로</option>
              <option value="lower">모두 소문자</option>
              <option value="upper">모두 대문자</option>
            </select>
          </div>
          <div class="field">
            <label for="fr-order">순번 매길 순서</label>
            <select id="fr-order">
              <option value="added">넣은 순서</option>
              <option value="name">이름순</option>
              <option value="date">수정한 날짜순</option>
            </select>
          </div>
        </div>

        <div class="fr-table-wrap">
          <table class="fr-table">
            <thead>
              <tr><th>지금 이름</th><th>새 이름</th></tr>
            </thead>
            <tbody id="fr-rows"></tbody>
          </table>
        </div>

        <div class="tool-actions">
          <button id="fr-apply" class="btn" type="button">새 이름으로 ZIP 만들기</button>
          <button id="fr-reset" class="btn btn-secondary" type="button">처음부터</button>
        </div>

        <div id="fr-result" class="result-panel" tabindex="-1" hidden>
          <p class="result-value">이름을 바꿨습니다</p>
          <p id="fr-result-note" class="kit-info"></p>
          <div class="tool-actions">
            <a id="fr-download" class="btn" href="#">ZIP 내려받기</a>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>이렇게 바꿉니다</h2>
      <p>
        <strong>새 이름 틀</strong>에 원하는 이름을 적고, 바꿔 넣을 자리에 표시를 넣습니다. <code>{'{name}'}</code>은 원래
        이름, <code>{'{n}'}</code>은 순번, <code>{'{date}'}</code>는 오늘 날짜(예: 20261111)로 바뀝니다. 찾아 바꾸기는 틀을
        적용하기 전에 원래 이름에서 먼저 실행합니다. 바꾼 결과는 아래 표에서 바로 확인할 수 있습니다.
      </p>
      <table>
        <thead>
          <tr><th>하고 싶은 일</th><th>설정</th><th>결과</th></tr>
        </thead>
        <tbody>
          <tr><td>사진에 순번 붙이기</td><td>틀 <code>제주_{'{n}'}</code></td><td>제주_01.jpg, 제주_02.jpg</td></tr>
          <tr><td>앞에 날짜 붙이기</td><td>틀 <code>{'{date}'}_{'{name}'}</code></td><td>20261111_회의록.docx</td></tr>
          <tr><td>IMG_ 지우기</td><td>찾을 글자 <code>IMG_</code>, 바꿀 글자 비움</td><td>1234.jpg</td></tr>
          <tr><td>띄어쓰기를 밑줄로</td><td>찾을 글자 공백 한 칸, 바꿀 글자 <code>_</code></td><td>2026_보고서.pdf</td></tr>
        </tbody>
      </table>

      <h2>왜 ZIP으로 받나요</h2>
      <p>
        웹 브라우저는 보안 때문에 내 컴퓨터에 있는 파일의 이름을 직접 바꿀 수 없습니다. 그래서 새 이름을 붙인 사본을
        ZIP 하나에 담아 드립니다. 압축하지 않고 담기만 하므로 빠르고, 파일 내용은 한 바이트도 바뀌지 않습니다.
        압축을 풀면 새 이름의 파일이 나오니 원래 폴더의 파일과 바꿔 쓰세요.
      </p>

      <h2>알아두세요</h2>
      <ul>
        <li>확장자(.jpg, .pdf)는 바꾸지 않습니다. 확장자가 바뀌면 파일이 열리지 않기 때문입니다.</li>
        <li>\ / : * ? " &lt; &gt; | 처럼 파일 이름에 쓸 수 없는 글자는 밑줄(_)로 바꿉니다.</li>
        <li>새 이름이 겹치면 뒤에 (2), (3)을 붙여 덮어쓰지 않게 합니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        파일을 읽고 처리하고 내려받는 과정이 모두 이 브라우저 안에서 끝납니다. 회사 문서나 개인 사진도
        외부 서버에 올리지 않습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initFileRename } from '../../scripts/file-rename';

  initFileRename();
</script>

<style>
  .fr-token {
    min-height: 32px;
    padding: 0.25rem 0.6rem;
    font-size: 0.8rem;
  }

  .fr-table-wrap {
    max-height: 22rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .fr-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }

  .fr-table th,
  .fr-table :global(td) {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    overflow-wrap: anywhere;
  }

  .fr-table th {
    position: sticky;
    top: 0;
    background: var(--surface-muted);
  }

  .fr-table :global(.fr-changed) {
    color: var(--accent-strong);
    font-weight: 700;
  }
</style>
