---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('file-rename');
if (!tool) throw new Error('file-rename 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/file-rename/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '파일 이름 일괄 변경', path },
  ]),
];
---

<BaseLayout title="파일 이름 일괄 변경 — 찾아 바꾸기·앞뒤 붙이기·순번으로 한 번에" description={tool.description.ko} path={path} jsonLd={jsonLd}>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">파일 이름 일괄 변경</h2>
      <label class="dropzone" id="fr-drop" for="fr-input">
        <span class="dropzone-icon" aria-hidden="true">🏷️</span>
        <strong>이름을 바꿀 파일들을 끌어다 놓으세요</strong>
        <small>파일 종류 상관없이 최대 500개 · 500MB</small>
        <input id="fr-input" class="visually-hidden" type="file" multiple />
      </label>

      <p id="fr-status" class="status" role="status" aria-live="polite"></p>
      <p id="fr-error" class="error" role="alert" hidden></p>

      <div id="fr-panel" class="stack" hidden>
        <div class="fr-presets" aria-label="자주 하는 작업">
          <span class="fr-presets-label">빠른 시작</span>
          <button class="fr-preset" type="button" data-fr-preset="strip">IMG_ 지우기</button>
          <button class="fr-preset" type="button" data-fr-preset="date">앞에 날짜 붙이기</button>
          <button class="fr-preset" type="button" data-fr-preset="number">뒤에 순번 붙이기</button>
          <button class="fr-preset" type="button" data-fr-preset="space">공백을 밑줄로</button>
        </div>

        <fieldset class="fr-modes">
          <legend>바꾸는 방법</legend>
          <label class="fr-mode">
            <input type="radio" name="fr-mode" value="replace" checked />
            <span>
              <strong>찾아 바꾸기</strong>
              <small>IMG_ → 여행_</small>
            </span>
          </label>
          <label class="fr-mode">
            <input type="radio" name="fr-mode" value="affix" />
            <span>
              <strong>앞·뒤에 붙이기</strong>
              <small>파일명 앞에 날짜</small>
            </span>
          </label>
          <label class="fr-mode">
            <input type="radio" name="fr-mode" value="number" />
            <span>
              <strong>순번 붙이기</strong>
              <small>여행_01, 여행_02</small>
            </span>
          </label>
          <label class="fr-mode">
            <input type="radio" name="fr-mode" value="template" />
            <span>
              <strong>직접 만들기</strong>
              <small>원하는 규칙 조합</small>
            </span>
          </label>
        </fieldset>

        <div class="fr-mode-panel" data-fr-panel="replace">
          <div class="kit-grid">
            <div class="field">
              <label for="fr-find">찾을 글자</label>
              <input id="fr-find" type="text" autocomplete="off" spellcheck="false" placeholder="예: IMG_" />
            </div>
            <div class="field">
              <label for="fr-replace">바꿀 글자</label>
              <input id="fr-replace" type="text" autocomplete="off" spellcheck="false" placeholder="비우면 지웁니다" />
            </div>
          </div>
          <p class="hint">찾을 글자가 없으면 이름을 그대로 둡니다. 여러 번 나오면 모두 바꿉니다.</p>
        </div>

        <div class="fr-mode-panel" data-fr-panel="affix" hidden>
          <div class="kit-grid">
            <div class="field">
              <label for="fr-affix-text">붙일 글자</label>
              <input id="fr-affix-text" type="text" autocomplete="off" spellcheck="false" placeholder="예: 2026_ 또는 _최종" />
            </div>
            <div class="field">
              <label for="fr-affix-position">붙일 위치</label>
              <select id="fr-affix-position">
                <option value="before">이름 앞에</option>
                <option value="after">이름 뒤에</option>
              </select>
            </div>
          </div>
          <p class="hint">확장자 앞에 붙습니다. 예: <code>보고서.pdf</code> → <code>2026_보고서.pdf</code></p>
        </div>

        <div class="fr-mode-panel" data-fr-panel="number" hidden>
          <div class="kit-grid">
            <div class="field">
              <label for="fr-number-base">새 이름</label>
              <input id="fr-number-base" type="text" autocomplete="off" spellcheck="false" placeholder="예: 여행 (비우면 원래 이름 유지)" />
            </div>
            <div class="field">
              <label for="fr-number-position">순번 위치</label>
              <select id="fr-number-position">
                <option value="after">이름 뒤에 (여행_01)</option>
                <option value="before">이름 앞에 (01_여행)</option>
              </select>
            </div>
          </div>
          <label class="fr-check">
            <input id="fr-number-keep" type="checkbox" />
            <span>새 이름 뒤에 원래 이름도 남기기 (여행_원래이름_01)</span>
          </label>
          <p class="hint">새 이름을 비우면 원래 이름 뒤에 순번만 붙습니다.</p>
        </div>

        <div class="fr-mode-panel" data-fr-panel="template" hidden>
          <div class="field">
            <label for="fr-template">새 이름 틀</label>
            <input id="fr-template" type="text" value="{name}" autocomplete="off" spellcheck="false" />
            <div class="kit-row">
              <button class="btn btn-secondary fr-token" type="button" data-fr-token="{name}">+ 원래 이름</button>
              <button class="btn btn-secondary fr-token" type="button" data-fr-token="{n}">+ 순번</button>
              <button class="btn btn-secondary fr-token" type="button" data-fr-token="{date}">+ 오늘 날짜</button>
            </div>
            <span class="hint">
              <code>{'{name}'}</code> 원래 이름 · <code>{'{n}'}</code> 순번 · <code>{'{date}'}</code> 오늘 날짜(20261117)
            </span>
          </div>
          <div class="kit-grid">
            <div class="field">
              <label for="fr-find-template">찾을 글자</label>
              <input id="fr-find-template" type="text" autocomplete="off" spellcheck="false" placeholder="틀을 적용하기 전에 바꿉니다" />
            </div>
            <div class="field">
              <label for="fr-replace-template">바꿀 글자</label>
              <input id="fr-replace-template" type="text" autocomplete="off" spellcheck="false" placeholder="비우면 지웁니다" />
            </div>
          </div>
        </div>

        <div class="kit-grid" data-fr-number-settings hidden>
          <div class="field">
            <label for="fr-start">순번 시작</label>
            <input id="fr-start" type="number" min="0" value="1" inputmode="numeric" />
          </div>
          <div class="field">
            <label for="fr-digits">순번 자리 수</label>
            <select id="fr-digits">
              <option value="1">1 → 1, 2, 3</option>
              <option value="2" selected>2 → 01, 02</option>
              <option value="3">3 → 001, 002</option>
              <option value="4">4 → 0001</option>
            </select>
          </div>
        </div>

        <details class="fr-advanced">
          <summary>고급 설정 <span>대소문자 · 순번 매길 순서</span></summary>
          <div class="kit-grid">
            <div class="field">
              <label for="fr-case">대소문자</label>
              <select id="fr-case">
                <option value="keep">그대로</option>
                <option value="lower">모두 소문자</option>
                <option value="upper">모두 대문자</option>
              </select>
            </div>
            <div class="field">
              <label for="fr-order">순번 매길 순서</label>
              <select id="fr-order">
                <option value="added">넣은 순서</option>
                <option value="name">이름순</option>
                <option value="date">수정한 날짜순</option>
              </select>
            </div>
          </div>
        </details>

        <div class="fr-example" aria-live="polite">
          <span class="fr-example-label">결과 미리보기</span>
          <code id="fr-example-before">IMG_0001.jpg</code>
          <span class="fr-example-arrow" aria-hidden="true">→</span>
          <strong id="fr-example-after">IMG_0001.jpg</strong>
          <span id="fr-example-note" class="fr-example-note"></span>
        </div>

        <div class="fr-table-wrap">
          <table class="fr-table">
            <thead>
              <tr><th>지금 이름</th><th>새 이름</th></tr>
            </thead>
            <tbody id="fr-rows"></tbody>
          </table>
        </div>

        <div class="tool-actions">
          <button id="fr-apply" class="btn" type="button">새 이름으로 ZIP 만들기</button>
          <button id="fr-reset" class="btn btn-secondary" type="button">처음부터</button>
        </div>

        <div id="fr-result" class="result-panel" tabindex="-1" hidden>
          <p class="result-value">이름을 바꿨습니다</p>
          <p id="fr-result-note" class="kit-info"></p>
          <div class="tool-actions">
            <a id="fr-download" class="btn" href="#">ZIP 내려받기</a>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>방식을 고르고, 결과를 확인하고, 적용합니다</h2>
      <p>
        Finder의 이름 변경처럼 <strong>하려는 일을 먼저 고르는 방식</strong>으로 만들었습니다. 복잡한 규칙을 외우지
        않아도 되고, 바뀐 이름은 표에서 바로 확인한 뒤 적용할 수 있습니다.
      </p>
      <table>
        <thead>
          <tr><th>하고 싶은 일</th><th>고르는 방법</th><th>결과</th></tr>
        </thead>
        <tbody>
          <tr><td>IMG_ 같은 접두어 지우기</td><td>찾아 바꾸기</td><td>IMG_1234.jpg → 1234.jpg</td></tr>
          <tr><td>앞에 날짜나 프로젝트명 붙이기</td><td>앞·뒤에 붙이기</td><td>보고서.pdf → 2026_보고서.pdf</td></tr>
          <tr><td>사진에 순번 붙이기</td><td>순번 붙이기</td><td>제주_01.jpg, 제주_02.jpg</td></tr>
          <tr><td>여러 규칙을 조합하기</td><td>직접 만들기</td><td>20261117_제주_01.jpg</td></tr>
        </tbody>
      </table>

      <h2>실수 없이 바꾸는 순서</h2>
      <ol>
        <li>이름을 바꿀 파일을 끌어다 놓습니다.</li>
        <li>빠른 시작을 누르거나 방식을 고릅니다.</li>
        <li>결과 미리보기와 표에서 새 이름을 확인합니다.</li>
        <li>문제가 없으면 <strong>새 이름으로 ZIP 만들기</strong>를 누릅니다.</li>
      </ol>

      <h2>직접 만들기 표시</h2>
      <p>
        직접 만들기에서는 이름 틀에 글자와 표시를 조합합니다. <code>{'{name}'}</code>은 원래 이름,
        <code>{'{n}'}</code>은 순번, <code>{'{date}'}</code>는 오늘 날짜로 바뀝니다. 찾아 바꾸기는 틀을 적용하기
        전에 원래 이름에서 먼저 실행합니다.
      </p>
      <p>
        예: <code>제주_{'{n}'}</code> → 제주_01.jpg, 제주_02.jpg … 확장자는 그대로 둡니다.
      </p>

      <h2>왜 ZIP으로 받나요</h2>
      <p>
        웹 브라우저는 보안 때문에 내 컴퓨터에 있는 파일의 이름을 직접 바꿀 수 없습니다. 그래서 새 이름을 붙인 사본을
        ZIP 하나에 담아 드립니다. 압축하지 않고 담기만 하므로 빠르고, 파일 내용은 한 바이트도 바뀌지 않습니다.
        압축을 풀면 새 이름의 파일이 나오니 원래 폴더의 파일과 바꿔 쓰세요.
      </p>

      <h2>알아두세요</h2>
      <ul>
        <li>확장자(.jpg, .pdf)는 바꾸지 않습니다. 확장자가 바뀌면 파일이 열리지 않기 때문입니다.</li>
        <li>\ / : * ? " &lt; &gt; | 처럼 파일 이름에 쓸 수 없는 글자는 밑줄(_)로 바꿉니다.</li>
        <li>새 이름이 겹치면 뒤에 (2), (3)을 붙여 덮어쓰지 않게 합니다.</li>
        <li>원본 파일은 그대로 남습니다. ZIP을 풀어 새 이름의 파일을 사용하세요.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        파일을 읽고 처리하고 내려받는 과정이 모두 이 브라우저 안에서 끝납니다. 회사 문서나 개인 사진도
        외부 서버에 올리지 않습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initFileRename } from '../../scripts/file-rename';

  initFileRename();
</script>

<style>
  .fr-presets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .fr-presets-label {
    margin-right: 0.15rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .fr-preset {
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }

  .fr-preset:hover,
  .fr-preset:focus-visible {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .fr-modes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .fr-modes legend {
    margin-bottom: 0.45rem;
    padding: 0;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .fr-mode {
    position: relative;
    cursor: pointer;
  }

  .fr-mode input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .fr-mode span {
    display: grid;
    gap: 0.15rem;
    height: 100%;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink-soft);
  }

  .fr-mode strong {
    color: var(--ink);
    font-size: 0.82rem;
  }

  .fr-mode small {
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .fr-mode input:checked + span {
    border-color: var(--accent);
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .fr-mode input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .fr-mode-panel {
    display: grid;
    gap: 0.7rem;
  }

  .fr-mode-panel > .hint {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .fr-check {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
    cursor: pointer;
  }

  .fr-check input {
    width: 16px;
    height: 16px;
    accent-color: var(--accent);
  }

  .fr-advanced {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .fr-advanced summary {
    padding: 0.6rem 0.75rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
  }

  .fr-advanced summary span {
    margin-left: 0.35rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .fr-advanced .kit-grid {
    padding: 0 0.75rem 0.75rem;
  }

  .fr-example {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    font-size: 0.84rem;
  }

  .fr-example-label {
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .fr-example code,
  .fr-example strong {
    color: var(--ink);
    font-size: 0.84rem;
    overflow-wrap: anywhere;
  }

  .fr-example-arrow {
    color: var(--accent-strong);
    font-weight: 800;
  }

  .fr-example-note {
    margin-left: auto;
    color: var(--ink-soft);
    font-size: 0.74rem;
  }

  .fr-token {
    min-height: 32px;
    padding: 0.25rem 0.6rem;
    font-size: 0.8rem;
  }

  .fr-table-wrap {
    max-height: 22rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .fr-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }

  .fr-table th,
  .fr-table :global(td) {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    overflow-wrap: anywhere;
  }

  .fr-table th {
    position: sticky;
    top: 0;
    background: var(--surface-muted);
  }

  .fr-table :global(.fr-changed) {
    color: var(--accent-strong);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .fr-modes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fr-example-note {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
