---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('pdf-resize');
if (!tool) throw new Error('pdf-resize 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/pdf-resize/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'PDF 페이지 크기', path },
  ]),
];
---

<BaseLayout
  title="PDF 페이지 크기 변경 — A4·A3·Letter로 맞추기"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">PDF 페이지 크기 변경</h2>

      <label class="dropzone" id="pr-drop" for="pr-input">
        <span class="dropzone-icon" aria-hidden="true">📐</span>
        <strong>크기를 바꿀 PDF를 끌어다 놓으세요</strong>
        <small>PDF 한 개 · 최대 300쪽 · 50MB</small>
        <input id="pr-input" class="visually-hidden" type="file" accept="application/pdf,.pdf" />
      </label>

      <p id="pr-status" class="status" role="status" aria-live="polite"></p>
      <p id="pr-error" class="error" role="alert" hidden></p>

      <div id="pr-panel" hidden>
        <p id="pr-file-info" class="file-info-line"></p>

        <div class="pr-layout">
          <div>
            <div id="pr-preview-wrap" class="preview-wrap">
              <canvas id="pr-canvas" aria-label="페이지 크기 미리보기"></canvas>
            </div>
            <p id="pr-preview-label" class="preview-label">1쪽 미리보기</p>
          </div>

          <div class="pr-controls">
            <div class="field">
              <label for="pr-size">새 용지</label>
              <select id="pr-size"></select>
            </div>
            <div class="field">
              <label for="pr-orientation">방향</label>
              <select id="pr-orientation">
                <option value="portrait" selected>세로</option>
                <option value="landscape">가로</option>
              </select>
            </div>
            <div class="field">
              <label for="pr-margin">여백 <span id="pr-margin-value">18pt</span></label>
              <input id="pr-margin" type="range" min="0" max="72" step="2" value="18" />
            </div>
            <p class="hint">
              원본 비율을 유지한 채 새 용지 안에 맞춥니다. 남는 공간은 흰 여백이 됩니다.
            </p>
          </div>
        </div>

        <div class="tool-actions">
          <button id="pr-apply" class="btn" type="button">페이지 크기 바꾸기</button>
          <button id="pr-reset" class="btn btn-secondary" type="button">다른 PDF 선택</button>
        </div>

        <div id="pr-result" class="result-panel" tabindex="-1" hidden>
          <p class="result-value">크기 변경 결과</p>
          <dl class="stat-grid">
            <div class="stat">
              <dt>페이지</dt>
              <dd id="pr-result-pages">-</dd>
            </div>
            <div class="stat">
              <dt>파일 크기</dt>
              <dd id="pr-result-size">-</dd>
            </div>
          </dl>
          <div class="tool-actions">
            <a id="pr-download" class="btn" href="#" hidden>크기 변경 PDF 내려받기</a>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>페이지를 다시 그리지 않습니다</h2>
      <p>
        원본 페이지를 PDF 페이지 객체로 새 용지에 배치합니다. 이미지로 변환하지 않아
        <strong>글자·표·이미지 품질이 유지</strong>됩니다. 스캔본이든 텍스트 문서든 크기만 새 용지에
        맞춰집니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>제출처가 A4만 받는데 원본이 Letter·A3일 때</li>
        <li>스캔본마다 제각각인 용지 크기를 통일할 때</li>
        <li>인쇄용으로 여백을 두고 A4에 맞출 때</li>
        <li>모아찍기 전에 페이지 크기를 먼저 맞출 때</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>원본 비율을 유지하므로 용지 비율이 다르면 위·아래 또는 좌·우에 여백이 생깁니다.</li>
        <li>여백 값을 0으로 하면 페이지가 용지 끝까지 닿습니다. 프린터의 인쇄 불가 영역은 별도입니다.</li>
        <li>페이지 회전 값을 반영해 바로 선 방향으로 배치합니다.</li>
        <li>링크·주석·입력 폼은 새 페이지에 복사되지 않습니다.</li>
        <li>한 번에 최대 <strong>300쪽·50MB</strong>까지 처리합니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        PDF 해석과 재배치가 브라우저에서 실행됩니다. 제출용 계약서·증명서도 서버에 올리지 않고 용지
        크기를 맞출 수 있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initPdfResize } from '../../scripts/pdf-resize';

  initPdfResize();
</script>

<style>
  .pr-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(250px, 0.9fr);
    gap: 1.2rem;
    align-items: start;
  }

  .preview-wrap {
    display: grid;
    place-items: center;
    padding: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }

  #pr-canvas {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 520px;
    background: #fff;
    box-shadow: 0 1px 6px rgba(20, 24, 31, 0.12);
  }

  .preview-label {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.74rem;
    text-align: center;
  }

  .pr-controls {
    display: grid;
    gap: 0.7rem;
  }

  .pr-controls .hint {
    display: block;
    margin-top: 0.2rem;
  }

  @media (max-width: 820px) {
    .pr-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
