---
/**
 * 목적별 페이지(변형). 데이터는 src/data/variants.ts, 작업 영역은 원본 도구와 같은 컴포넌트를 쓴다.
 */
import ImageConvertPanel from '@/components/panels/ImageConvertPanel.astro';
import JpgToPdfPanel from '@/components/panels/JpgToPdfPanel.astro';
import PdfOrganizePanel from '@/components/panels/PdfOrganizePanel.astro';
import ToolLayout from '@/components/ToolLayout.astro';
import { SITE } from '@/consts';
import { getTool, type Tool } from '@/data/tools';
import { VARIANTS, type Variant } from '@/data/variants';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

// 도구 → 작업 영역. 여기 없는 도구의 변형은 빌드에서 막힌다(tests/variants.test.ts).
const PANELS = {
  'image-convert': ImageConvertPanel,
  'jpg-to-pdf': JpgToPdfPanel,
  'pdf-organize': PdfOrganizePanel,
} as const;

export function getStaticPaths() {
  return VARIANTS.map((variant) => ({
    params: { tool: variant.tool, variant: variant.slug },
    props: { variant },
  }));
}

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const tool = getTool(variant.tool);
if (!tool) throw new Error(`${variant.tool} 도구를 찾을 수 없습니다.`);
const Panel = PANELS[variant.tool as keyof typeof PANELS];
if (!Panel) throw new Error(`${variant.tool} 작업 영역이 등록되지 않았습니다.`);

const site = Astro.site ?? new URL(SITE.url);
const path = `/tools/${variant.tool}/${variant.slug}/`;
const schemaTool: Tool = {
  ...tool,
  title: { ko: variant.h1 },
  description: { ko: variant.description },
  updated: variant.updated,
};
const jsonLd = [
  toolSchema(schemaTool, site, path),
  faqSchema(variant.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: tool.title.ko, path: `/tools/${tool.slug}/` },
    { name: variant.h1, path },
  ]),
];
---

<BaseLayout title={variant.title} description={variant.description} path={path} jsonLd={jsonLd}>
  <ToolLayout tool={tool} variant={variant}>
    <Panel {...variant.preset} />

    <div class="prose">
      {
        variant.sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </>
        ))
      }
      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        파일을 읽고 바꾸고 내려받는 과정이 모두 이 브라우저 안에서 끝납니다. 회사 자료나 개인 사진도
        외부 서버에 올리지 않고 처리할 수 있습니다. 다른 설정이 필요하면
        <a href={`/tools/${tool.slug}/`}>{tool.title.ko}</a>에서 모든 기능을 쓸 수 있습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>
