---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('image-filter');
if (!tool) throw new Error('image-filter 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/image-filter/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '이미지 필터', path },
  ]),
];
---

<BaseLayout
  title="이미지 필터 — 밝기·대비·채도·흑백·세피아"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">이미지 필터</h2>

      <label class="dropzone" id="if-drop" for="if-input">
        <span class="dropzone-icon" aria-hidden="true">🎨</span>
        <strong>필터를 적용할 이미지를 끌어다 놓으세요</strong>
        <small>JPG · PNG · WebP · 50MB</small>
        <input id="if-input" class="visually-hidden" type="file" accept="image/*" />
      </label>

      <p id="if-status" class="status" role="status" aria-live="polite"></p>
      <p id="if-error" class="error" role="alert" hidden></p>

      <div id="if-panel" hidden>
        <div class="if-layout">
          <div id="if-preview-wrap" class="if-preview">
            <canvas id="if-canvas" aria-label="필터 미리보기"></canvas>
          </div>

          <div class="if-controls">
            <div class="field">
              <label for="if-brightness">밝기 <span id="if-brightness-value">100%</span></label>
              <input id="if-brightness" type="range" min="0" max="200" step="1" value="100" />
            </div>
            <div class="field">
              <label for="if-contrast">대비 <span id="if-contrast-value">100%</span></label>
              <input id="if-contrast" type="range" min="0" max="200" step="1" value="100" />
            </div>
            <div class="field">
              <label for="if-saturation">채도 <span id="if-saturation-value">100%</span></label>
              <input id="if-saturation" type="range" min="0" max="200" step="1" value="100" />
            </div>
            <div class="field">
              <label for="if-grayscale">흑백 <span id="if-grayscale-value">0%</span></label>
              <input id="if-grayscale" type="range" min="0" max="100" step="1" value="0" />
            </div>
            <div class="field">
              <label for="if-sepia">세피아 <span id="if-sepia-value">0%</span></label>
              <input id="if-sepia" type="range" min="0" max="100" step="1" value="0" />
            </div>
            <div class="field">
              <label for="if-blur">블러 <span id="if-blur-value">0px</span></label>
              <input id="if-blur" type="range" min="0" max="20" step="1" value="0" />
            </div>
            <button id="if-reset-filters" class="btn btn-secondary" type="button">필터 초기화</button>
          </div>
        </div>

        <div class="if-output">
          <div class="field">
            <label for="if-format">저장 형식</label>
            <select id="if-format">
              <option value="image/jpeg" selected>JPG</option>
              <option value="image/png">PNG</option>
              <option value="image/webp">WebP</option>
            </select>
          </div>
          <div class="field">
            <label for="if-quality">화질 <span id="if-quality-value">92%</span></label>
            <input id="if-quality" type="range" min="0.6" max="0.95" step="0.05" value="0.92" />
          </div>
        </div>

        <div class="tool-actions">
          <button id="if-apply" class="btn" type="button">필터 적용해 저장</button>
          <button id="if-reset" class="btn btn-secondary" type="button">다른 이미지 선택</button>
        </div>

        <div id="if-result" class="result-panel" tabindex="-1" hidden>
          <p class="result-value">필터 결과</p>
          <img id="if-result-image" class="result-image" alt="필터를 적용한 이미지 미리보기" />
          <p id="if-result-summary" class="notice"></p>
          <div class="tool-actions">
            <a id="if-download" class="btn" href="#" hidden>결과 내려받기</a>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>간단한 보정은 브라우저에서</h2>
      <p>
        밝기·대비·채도·흑백·세피아·블러를 슬라이더로 조절합니다. 원본 해상도로 저장하며, 이미지를 서버로
        보내지 않습니다. 사진 보정 프로그램 없이 문서·보고서용 이미지를 빠르게 다듬을 때 적합합니다.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>어둡게 찍힌 사진을 밝게 보정</li>
        <li>스캔본의 대비를 높여 글자를 선명하게</li>
        <li>흑백으로 바꿔 인쇄 잉크 절약</li>
        <li>배경을 흐리게 해서 주요 피사체 강조</li>
        <li>오래된 사진 느낌의 세피아 톤</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>필터는 저장 시 이미지에 <strong>적용(구워짐)</strong>되며 나중에 되돌릴 수 없습니다. 원본을 보관하세요.</li>
        <li>JPG·WebP는 저장할 때 재압축됩니다. 최고 화질은 PNG를 선택하세요.</li>
        <li>블러는 가장자리까지 번지므로 인물 사진보다 배경·그래픽에 적합합니다.</li>
        <li>HEIC는 JPG로 변환한 뒤 사용하세요.</li>
        <li>화면 미리보기와 저장 결과의 색이 기기·브라우저에 따라 약간 다를 수 있습니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        이미지 보정이 브라우저에서 실행됩니다. 사내 사진·제품 이미지도 서버에 올리지 않고 보정할 수
        있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initImageFilter } from '../../scripts/image-filter';

  initImageFilter();
</script>

<style>
  .if-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(250px, 0.8fr);
    gap: 1.2rem;
    align-items: start;
  }

  .if-preview {
    display: grid;
    place-items: center;
    min-height: 200px;
    padding: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }

  #if-canvas {
    display: block;
    max-width: 100%;
    max-height: 460px;
  }

  .if-controls {
    display: grid;
    gap: 0.55rem;
  }

  .if-output {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  @media (max-width: 820px) {
    .if-layout {
      grid-template-columns: 1fr;
    }

    .if-output {
      grid-template-columns: 1fr;
    }
  }
</style>
