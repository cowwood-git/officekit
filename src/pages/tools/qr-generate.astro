---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('qr-generate');
if (!tool) throw new Error('qr-generate 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/qr-generate/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'QR 코드 만들기', path },
  ]),
];
---

<BaseLayout
  title="QR 코드 만들기 — 링크·텍스트를 PNG·SVG로"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">QR 코드 생성</h2>

      <div class="qr-layout">
        <div class="qr-form">
          <div class="field">
            <label for="qr-preset">종류</label>
            <select id="qr-preset">
              <option value="text" selected>텍스트</option>
              <option value="url">URL</option>
              <option value="wifi">WiFi</option>
              <option value="vcard">명함 (vCard)</option>
              <option value="email">이메일</option>
              <option value="phone">전화번호</option>
              <option value="sms">SMS</option>
            </select>
          </div>

          <div id="qr-group-text">
            <div class="field">
              <label for="qr-text">내용</label>
              <textarea
                id="qr-text"
                rows="4"
                placeholder="https://example.com 또는 안내 문구"
                spellcheck="false"
              ></textarea>
              <span class="hint">URL·텍스트를 그대로 담습니다. URL은 https://를 자동으로 붙입니다.</span>
            </div>
          </div>

          <div id="qr-group-wifi" class="qr-group" hidden>
            <div class="field">
              <label for="qr-wifi-ssid">WiFi 이름 (SSID)</label>
              <input id="qr-wifi-ssid" type="text" autocomplete="off" />
            </div>
            <div class="qr-options">
              <div class="field">
                <label for="qr-wifi-encryption">보안 방식</label>
                <select id="qr-wifi-encryption">
                  <option value="WPA" selected>WPA/WPA2</option>
                  <option value="WEP">WEP</option>
                  <option value="nopass">없음 (개방)</option>
                </select>
              </div>
              <div class="field">
                <label for="qr-wifi-password">비밀번호</label>
                <input id="qr-wifi-password" type="text" autocomplete="off" />
              </div>
            </div>
            <label class="check"><input id="qr-wifi-hidden" type="checkbox" /> 숨김 네트워크</label>
          </div>

          <div id="qr-group-vcard" class="qr-group" hidden>
            <div class="qr-options">
              <div class="field">
                <label for="qr-vcard-name">이름</label>
                <input id="qr-vcard-name" type="text" autocomplete="off" />
              </div>
              <div class="field">
                <label for="qr-vcard-org">회사</label>
                <input id="qr-vcard-org" type="text" autocomplete="off" />
              </div>
            </div>
            <div class="qr-options">
              <div class="field">
                <label for="qr-vcard-title">직함</label>
                <input id="qr-vcard-title" type="text" autocomplete="off" />
              </div>
              <div class="field">
                <label for="qr-vcard-phone">전화</label>
                <input id="qr-vcard-phone" type="tel" autocomplete="off" />
              </div>
            </div>
            <div class="qr-options">
              <div class="field">
                <label for="qr-vcard-email">이메일</label>
                <input id="qr-vcard-email" type="email" autocomplete="off" />
              </div>
              <div class="field">
                <label for="qr-vcard-url">웹사이트</label>
                <input id="qr-vcard-url" type="url" autocomplete="off" />
              </div>
            </div>
          </div>

          <div id="qr-group-email" class="qr-group" hidden>
            <div class="field">
              <label for="qr-email-to">받는 사람</label>
              <input id="qr-email-to" type="email" autocomplete="off" />
            </div>
            <div class="qr-options">
              <div class="field">
                <label for="qr-email-subject">제목</label>
                <input id="qr-email-subject" type="text" autocomplete="off" />
              </div>
              <div class="field">
                <label for="qr-email-body">내용</label>
                <input id="qr-email-body" type="text" autocomplete="off" />
              </div>
            </div>
          </div>

          <div id="qr-group-phone" class="qr-group" hidden>
            <div class="field">
              <label for="qr-phone-number">전화번호</label>
              <input id="qr-phone-number" type="tel" autocomplete="off" />
            </div>
          </div>

          <div id="qr-group-sms" class="qr-group" hidden>
            <div class="field">
              <label for="qr-sms-number">받는 번호</label>
              <input id="qr-sms-number" type="tel" autocomplete="off" />
            </div>
            <div class="field">
              <label for="qr-sms-message">문자 내용</label>
              <textarea id="qr-sms-message" rows="3" spellcheck="false"></textarea>
            </div>
          </div>

          <div class="field">
            <label for="qr-payload">QR에 담길 내용</label>
            <pre id="qr-payload" class="qr-payload" hidden></pre>
          </div>

          <div class="qr-options">
            <div class="field">
              <label for="qr-size">크기</label>
              <select id="qr-size">
                <option value="256">256px</option>
                <option value="512" selected>512px</option>
                <option value="1024">1024px</option>
              </select>
            </div>
            <div class="field">
              <label for="qr-ecc">오류 정정</label>
              <select id="qr-ecc">
                <option value="L">L · 7%</option>
                <option value="M" selected>M · 15%</option>
                <option value="Q">Q · 25%</option>
                <option value="H">H · 30%</option>
              </select>
            </div>
          </div>

          <p id="qr-error" class="error" role="alert" hidden></p>
        </div>

        <div class="qr-preview">
          <div class="canvas-frame">
            <canvas id="qr-canvas" width="512" height="512" aria-label="생성된 QR 코드"></canvas>
            <p id="qr-empty" class="muted">내용을 입력하면 QR 코드가 생성됩니다.</p>
          </div>
          <div class="tool-actions">
            <button id="qr-download-png" class="btn" type="button" disabled>PNG 저장</button>
            <button id="qr-download-svg" class="btn btn-secondary" type="button" disabled>
              SVG 저장
            </button>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>인쇄 품질 팁</h2>
      <ul>
        <li>인쇄물에는 SVG를 쓰세요. 확대해도 깨지지 않습니다.</li>
        <li>QR 주변에 최소 4칸(모듈)의 여백을 두세요.</li>
        <li>배경과 코드의 명암 대비를 높게 유지하세요. 회색·파스텔은 인식률이 떨어집니다.</li>
        <li>작게 인쇄할수록 오류 정정 수준을 높이고 내용을 짧게 줄이세요.</li>
      </ul>

      <h2>지원하는 QR 종류</h2>
      <table>
        <thead>
          <tr><th>종류</th><th>담기는 내용</th></tr>
        </thead>
        <tbody>
          <tr><td>URL</td><td>웹 주소 (https 자동 보완)</td></tr>
          <tr><td>WiFi</td><td>SSID·보안 방식·비밀번호</td></tr>
          <tr><td>명함</td><td>이름·회사·직함·전화·이메일·웹사이트 (vCard)</td></tr>
          <tr><td>이메일</td><td>받는 사람·제목·내용 (mailto)</td></tr>
          <tr><td>전화·SMS</td><td>번호와 문자 내용</td></tr>
        </tbody>
      </table>

      <h2>정적 QR입니다</h2>
      <p>
        이 도구는 입력한 내용을 그대로 담는 정적 QR을 만듭니다. 링크를 나중에 바꾸려면 QR을 다시
        만들어 교체해야 합니다. 클릭 수 추적이나 리디렉션은 넣지 않았습니다.
      </p>

      <h2>주의</h2>
      <p>
        QR에 담긴 내용은 스캔하는 사람에게 그대로 보입니다. 사내 문서·명함에 넣기 전 개인정보가
        포함되지 않았는지 확인하세요.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initQrGenerator } from '../../scripts/qr';

  initQrGenerator();
</script>

<style>
  .qr-layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
    align-items: start;
  }

  .qr-form {
    display: grid;
    gap: 1rem;
  }

  .qr-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  textarea {
    min-height: 90px;
    resize: vertical;
  }

  .qr-group {
    display: grid;
    gap: 0.7rem;
  }

  .qr-group[hidden] {
    display: none;
  }

  .qr-payload {
    max-height: 140px;
    margin: 0.3rem 0 0;
    padding: 0.6rem 0.7rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .qr-preview {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }

  .canvas-frame {
    display: grid;
    place-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }

  canvas {
    width: min(100%, 260px);
    height: auto;
    border-radius: 8px;
    background: #fff;
  }

  #qr-empty {
    font-size: 0.82rem;
    text-align: center;
  }

  @media (max-width: 780px) {
    .qr-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
