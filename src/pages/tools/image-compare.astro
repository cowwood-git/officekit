---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('image-compare');
if (!tool) throw new Error('image-compare 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/image-compare/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '이미지 비교', path },
  ]),
];
---

<BaseLayout title="이미지 비교 — 두 사진의 다른 곳 찾기, 전후 비교 슬라이더" description={tool.description.ko} path={path} jsonLd={jsonLd}>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">이미지 비교</h2>
      <div class="ic-drops">
        <label class="dropzone" id="ic-drop-0" for="ic-input-0">
          <strong>① 기준 이미지</strong>
          <small id="ic-name-0">원본·수정 전 이미지를 넣으세요</small>
          <input id="ic-input-0" class="visually-hidden" type="file" accept="image/*,.heic,.heif" multiple />
        </label>
        <label class="dropzone" id="ic-drop-1" for="ic-input-1">
          <strong>② 비교 이미지</strong>
          <small id="ic-name-1">수정 후·비교할 이미지를 넣으세요</small>
          <input id="ic-input-1" class="visually-hidden" type="file" accept="image/*,.heic,.heif" />
        </label>
      </div>

      <p id="ic-status" class="status" role="status" aria-live="polite"></p>
      <p id="ic-error" class="error" role="alert" hidden></p>

      <div id="ic-panel" class="stack" hidden>
        <fieldset class="kit-row">
          <legend class="kit-info">보는 방법</legend>
          <label class="kit-check"><input type="radio" name="ic-mode" value="slider" checked /> 밀어서 비교</label>
          <label class="kit-check"><input type="radio" name="ic-mode" value="diff" /> 다른 곳 강조</label>
          <label class="kit-check"><input type="radio" name="ic-mode" value="side" /> 나란히</label>
        </fieldset>
        <div id="ic-split-field" class="field">
          <label for="ic-split">경계 위치 (왼쪽 ①, 오른쪽 ②)</label>
          <input id="ic-split" type="range" min="0" max="100" value="50" />
        </div>
        <div id="ic-sensitivity-field" class="field" hidden>
          <label for="ic-sensitivity">민감도 (높을수록 작은 차이도 표시)</label>
          <input id="ic-sensitivity" type="range" min="0" max="100" value="70" />
        </div>
        <div class="kit-preview"><canvas id="ic-view" aria-label="비교 결과"></canvas></div>
        <p id="ic-stat" class="result-value" aria-live="polite"></p>
        <div class="tool-actions">
          <button id="ic-save" class="btn" type="button">지금 화면 PNG로 저장</button>
          <button id="ic-swap" class="btn btn-secondary" type="button">①② 바꾸기</button>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>세 가지 보는 법</h2>
      <ul>
        <li><strong>밀어서 비교</strong> — 두 이미지를 겹쳐 놓고 경계를 좌우로 밀어 봅니다. 보정 전후, 압축 전후 화질을 볼 때 좋습니다.</li>
        <li><strong>다른 곳 강조</strong> — 달라진 픽셀만 빨갛게 칠하고 나머지는 흐리게 둡니다. 디자인 시안 수정본, 문서 캡처의 바뀐 글자를 찾을 때 씁니다.</li>
        <li><strong>나란히</strong> — 두 이미지를 옆에 붙여 보여 줍니다. 저장하면 보고서에 바로 붙일 수 있는 비교 이미지가 됩니다.</li>
      </ul>

      <h2>민감도 맞추기</h2>
      <p>
        JPG로 다시 저장한 이미지는 눈에 보이지 않는 미세한 색 차이가 곳곳에 생깁니다. 다른 곳 강조에서 화면 전체가
        빨갛게 보이면 민감도를 낮추세요. 반대로 아주 작은 글자 하나가 바뀐 것을 찾을 때는 민감도를 높이면 됩니다.
        아래에 표시되는 "다른 픽셀" 비율로 두 이미지가 얼마나 다른지 숫자로 확인할 수 있습니다.
      </p>

      <h2>알아두세요</h2>
      <ul>
        <li>두 번째 이미지는 첫 번째 이미지 크기에 맞춰 늘리거나 줄여서 비교합니다. 비율이 다르면 안내가 나옵니다.</li>
        <li>큰 이미지는 긴 변 2000px로 줄여 비교합니다. 원본 파일은 바뀌지 않습니다.</li>
        <li>한 칸에 두 장을 한꺼번에 끌어다 놓으면 ①②에 순서대로 들어갑니다.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        파일을 읽고 처리하고 내려받는 과정이 모두 이 브라우저 안에서 끝납니다. 회사 문서나 개인 사진도
        외부 서버에 올리지 않습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initImageCompare } from '../../scripts/image-compare';

  initImageCompare();
</script>

<style>
  .ic-drops {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .ic-drops .dropzone[data-filled='true'] {
    border-style: solid;
    border-color: var(--accent);
  }

  #ic-view {
    width: 100%;
    height: auto;
  }

  @media (max-width: 600px) {
    .ic-drops {
      grid-template-columns: 1fr;
    }
  }
</style>
