---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('percent-calc');
if (!tool) throw new Error('percent-calc 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/percent-calc/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '퍼센트·부가세 계산기', path },
  ]),
];
---

<BaseLayout
  title="퍼센트·부가세 계산기 — 비율·증감률·VAT 역산"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">퍼센트와 부가세 계산</h2>

      <div class="pcv-grid">
        <article class="pcv-card">
          <h3>X의 Y%</h3>
          <p class="pcv-desc">금액의 일정 비율을 계산합니다.</p>
          <div class="pcv-row">
            <div class="field">
              <label for="pcv-of-value">금액</label>
              <input id="pcv-of-value" type="text" inputmode="decimal" placeholder="1000000" />
            </div>
            <div class="field">
              <label for="pcv-of-percent">비율 (%)</label>
              <input id="pcv-of-percent" type="text" inputmode="decimal" placeholder="15" />
            </div>
          </div>
          <p class="pcv-result"><span id="pcv-of-result">-</span></p>
        </article>

        <article class="pcv-card">
          <h3>몇 %인가요</h3>
          <p class="pcv-desc">부분이 전체에서 차지하는 비율을 계산합니다.</p>
          <div class="pcv-row">
            <div class="field">
              <label for="pcv-ratio-part">부분</label>
              <input id="pcv-ratio-part" type="text" inputmode="decimal" placeholder="25000" />
            </div>
            <div class="field">
              <label for="pcv-ratio-whole">전체</label>
              <input id="pcv-ratio-whole" type="text" inputmode="decimal" placeholder="200000" />
            </div>
          </div>
          <p class="pcv-result"><span id="pcv-ratio-result">-</span></p>
        </article>

        <article class="pcv-card">
          <h3>증감률</h3>
          <p class="pcv-desc">이전 값에서 얼마나 늘거나 줄었는지 계산합니다.</p>
          <div class="pcv-row">
            <div class="field">
              <label for="pcv-change-from">이전</label>
              <input id="pcv-change-from" type="text" inputmode="decimal" placeholder="100000" />
            </div>
            <div class="field">
              <label for="pcv-change-to">이후</label>
              <input id="pcv-change-to" type="text" inputmode="decimal" placeholder="120000" />
            </div>
          </div>
          <p class="pcv-result"><span id="pcv-change-result">-</span></p>
          <p id="pcv-change-note" class="pcv-note"></p>
        </article>

        <article class="pcv-card pcv-vat">
          <h3>부가세 (VAT)</h3>
          <p class="pcv-desc">공급가액에서 부가세를 더하거나, 포함 금액에서 역산합니다.</p>
          <div class="pcv-vat-row">
            <div class="field">
              <label for="pcv-vat-amount">금액</label>
              <input id="pcv-vat-amount" type="text" inputmode="decimal" placeholder="1000000" />
            </div>
            <div class="field">
              <label for="pcv-vat-mode">금액 기준</label>
              <select id="pcv-vat-mode">
                <option value="supply" selected>공급가액</option>
                <option value="included">부가세 포함</option>
              </select>
            </div>
            <div class="field">
              <label for="pcv-vat-rate">세율</label>
              <select id="pcv-vat-rate">
                <option value="10" selected>10%</option>
                <option value="0">0% (면세)</option>
              </select>
            </div>
          </div>
          <dl class="pcv-vat-stats">
            <div><dt>공급가액</dt><dd id="pcv-vat-supply">-</dd></div>
            <div><dt>부가세</dt><dd id="pcv-vat-tax">-</dd></div>
            <div><dt>합계</dt><dd id="pcv-vat-total">-</dd></div>
          </dl>
          <p id="pcv-vat-note" class="pcv-note"></p>
        </article>
      </div>

      <div class="tool-actions">
        <button id="pcv-copy" class="btn btn-secondary" type="button">결과 복사</button>
        <span id="pcv-status" class="status" role="status" aria-live="polite"></span>
      </div>
    </section>

    <div class="prose">
      <h2>계산 공식</h2>
      <ul>
        <li><strong>X의 Y%</strong> = X × Y ÷ 100</li>
        <li><strong>몇 %인가요</strong> = 부분 ÷ 전체 × 100</li>
        <li><strong>증감률</strong> = (이후 − 이전) ÷ |이전| × 100</li>
        <li><strong>공급가액 기준 부가세</strong> = 공급가액 × 세율 ÷ 100</li>
        <li><strong>부가세 포함 역산</strong> = 포함 금액 ÷ (1 + 세율 ÷ 100)</li>
      </ul>

      <h2>부가세 계산에서 주의할 점</h2>
      <p>
        부가세는 원 단위에서 <strong>반올림</strong>합니다. 공급가액과 부가세를 각각 반올림한 뒤 더하면
        합계가 1원 어긋날 수 있습니다. 이 도구는 공급가액 기준일 때 부가세를 반올림하고, 포함 금액
        기준일 때 공급가액을 반올림한 뒤 나머지를 부가세로 잡아 합계가 입력값과 일치하도록 맞춥니다.
        세금계산서·신고서에서는 국세청 고시와 회계 프로그램의 계산 결과를 우선 확인하세요.
      </p>

      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>견적서에 부가세 10%를 더하거나 포함 금액에서 분리</li>
        <li>매출·비용의 증감률 확인</li>
        <li>할인율·수수료·이자율 계산</li>
        <li>보고서의 구성비·점유율 정리</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>면세·영세율·간이과세는 세율만으로 판단할 수 없습니다. 과세 유형을 먼저 확인하세요.</li>
        <li>금액은 원 단위로 반올림해 표시합니다. 소수점이 필요한 비율 계산은 % 결과를 사용하세요.</li>
        <li>입력값은 서버로 전송되지 않으며 저장되지 않습니다.</li>
        <li>이 계산기는 참고용이며 세무 신고·법적 판단을 대신하지 않습니다.</li>
      </ul>

      <h2>계산은 서버로 가지 않습니다</h2>
      <p>
        모든 계산이 브라우저에서 실행됩니다. 매출·단가 같은 민감한 숫자도 서버에 올리지 않고 확인할 수
        있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initPercentCalc } from '../../scripts/percent-calc';

  initPercentCalc();
</script>

<style>
  .pcv-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .pcv-card {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .pcv-card h3 {
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .pcv-desc {
    margin: 0.2rem 0 0.8rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .pcv-row,
  .pcv-vat-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
  }

  .pcv-vat-row {
    grid-template-columns: 1.2fr 1fr 0.8fr;
  }

  .pcv-result {
    margin-top: 0.9rem;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .pcv-note {
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.5;
  }

  .pcv-vat {
    grid-column: 1 / -1;
  }

  .pcv-vat-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  .pcv-vat-stats div {
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .pcv-vat-stats dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .pcv-vat-stats dd {
    margin-top: 0.15rem;
    font-size: 1.05rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1040px) {
    .pcv-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 820px) {
    .pcv-grid {
      grid-template-columns: 1fr;
    }

    .pcv-vat-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .pcv-row {
      grid-template-columns: 1fr;
    }

    .pcv-vat-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
