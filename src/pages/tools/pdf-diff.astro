---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('pdf-diff');
if (!tool) throw new Error('pdf-diff 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/pdf-diff/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'PDF 텍스트 비교', path },
  ]),
];
---

<BaseLayout
  title="PDF 텍스트 비교 — 두 PDF의 바뀐 쪽 찾기"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">PDF 텍스트 비교</h2>

      <div class="pd-pair">
        <div>
          <label class="dropzone" id="pd-old-drop" for="pd-old-input">
            <span class="dropzone-icon" aria-hidden="true">📄</span>
            <strong>원본 PDF</strong>
            <small>수정 전 문서 · 최대 100쪽</small>
            <input
              id="pd-old-input"
              class="visually-hidden"
              type="file"
              accept="application/pdf,.pdf"
            />
          </label>
          <p id="pd-old-info" class="pd-file-info"></p>
        </div>

        <div>
          <label class="dropzone" id="pd-new-drop" for="pd-new-input">
            <span class="dropzone-icon" aria-hidden="true">📝</span>
            <strong>수정본 PDF</strong>
            <small>수정 후 문서 · 최대 100쪽</small>
            <input
              id="pd-new-input"
              class="visually-hidden"
              type="file"
              accept="application/pdf,.pdf"
            />
          </label>
          <p id="pd-new-info" class="pd-file-info"></p>
        </div>
      </div>

      <p id="pd-status" class="status" role="status" aria-live="polite"></p>
      <p id="pd-error" class="error" role="alert" hidden></p>

      <div id="pd-panel" hidden>
        <div class="tool-actions pd-actions">
          <label class="kit-check"><input id="pd-only-changed" type="checkbox" checked /> 바뀐 쪽만 보기</label>
          <button id="pd-run" class="btn" type="button" disabled>텍스트 비교하기</button>
          <button id="pd-clear" class="btn btn-secondary" type="button">처음부터</button>
        </div>

        <div id="pd-result" class="pd-result" hidden>
          <dl class="stat-grid pd-stats">
            <div class="stat"><dt>바뀐 쪽</dt><dd id="pd-stat-changed">0</dd></div>
            <div class="stat"><dt>추가된 쪽</dt><dd id="pd-stat-added">0</dd></div>
            <div class="stat"><dt>삭제된 쪽</dt><dd id="pd-stat-removed">0</dd></div>
            <div class="stat"><dt>그대로인 쪽</dt><dd id="pd-stat-unchanged">0</dd></div>
          </dl>
          <p id="pd-result-summary" class="pd-summary" aria-live="polite"></p>
          <div id="pd-pages" class="pd-pages"></div>
          <div class="tool-actions">
            <a id="pd-download" class="btn" href="#" hidden>비교 결과 TXT 내려받기</a>
          </div>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>비교하는 순서</h2>
      <ol>
        <li>수정 전 PDF와 수정 후 PDF를 각각 엽니다.</li>
        <li><strong>텍스트 비교하기</strong>를 누르면 쪽마다 텍스트를 추출합니다.</li>
        <li>같은 쪽은 그대로, 바뀐 쪽은 줄 단위 차이로 보여 줍니다.</li>
        <li>필요하면 바뀐 쪽만 모아 TXT로 내려받습니다.</li>
      </ol>

      <h2>어떻게 맞추나요</h2>
      <p>
        먼저 두 PDF의 쪽 텍스트를 비교해 같은 쪽·추가된 쪽·삭제된 쪽을 맞춥니다. 중간에 쪽이 하나
        끼어들어도 뒤의 쪽을 잘못 밀리지 않게 <strong>LCS(최장 공통 부분 수열)</strong>로 대응을
        찾습니다. 대응된 쪽은 다시 줄 단위 Myers diff로 비교해 바뀐 줄을 표시합니다.
      </p>
      <p>
        PDF에서 추출한 텍스트는 프로그램마다 줄바꿈과 공백이 조금씩 달라집니다. 그래서 쪽 대응과 줄
        비교 모두 <strong>공백 차이는 무시</strong>합니다. 글자만 바뀐 경우는 정확히 잡아냅니다.
      </p>

      <h2>알아두세요</h2>
      <ul>
        <li>글자 정보가 있는 PDF만 비교합니다. 스캔 이미지 PDF는 OCR로 글자를 먼저 인식하세요.</li>
        <li>PDF 한 개당 최대 100쪽까지 비교합니다.</li>
        <li>이미지·도표·레이아웃·글꼴 변경은 비교하지 않습니다. 글자 내용만 봅니다.</li>
        <li>쪽 순서가 바뀌면 추가·삭제로 표시될 수 있습니다.</li>
        <li>바뀐 쪽의 줄이 많으면 화면에는 일부만 표시하고, 전체 결과는 TXT로 내려받을 수 있습니다.</li>
        <li>암호가 걸린 PDF는 열 수 없습니다. 먼저 암호를 풀어 주세요.</li>
      </ul>

      <h2>파일은 서버로 가지 않습니다</h2>
      <p>
        PDF 텍스트 추출과 비교가 모두 브라우저에서 실행됩니다. 계약서·보고서도 서버에 올리지 않고
        수정 전후를 확인할 수 있습니다. 자세한 원리는 <a href="/method/">작동 원리</a>에 정리했습니다.
      </p>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initPdfDiff } from '../../scripts/pdf-diff';

  initPdfDiff();
</script>

<style>
  .pd-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .pd-pair .dropzone {
    min-height: 150px;
  }

  .pd-file-info {
    min-height: 1.4em;
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }

  .pd-actions {
    justify-content: space-between;
  }

  .pd-result {
    margin-top: 1.25rem;
  }

  .pd-stats {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .pd-summary {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .pd-pages {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .pd-page {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .pd-page summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.8rem;
    cursor: pointer;
    list-style: none;
  }

  .pd-page summary::-webkit-details-marker {
    display: none;
  }

  .pd-page summary::before {
    content: '▸';
    color: var(--muted);
    font-size: 0.8rem;
  }

  .pd-page[open] summary::before {
    content: '▾';
  }

  .pd-badge {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .pd-page-changed .pd-badge {
    background: color-mix(in srgb, #f59e0b 18%, var(--surface));
    color: color-mix(in srgb, #b45309 80%, var(--ink));
  }

  .pd-page-added .pd-badge {
    background: color-mix(in srgb, #16a34a 18%, var(--surface));
    color: color-mix(in srgb, #15803d 80%, var(--ink));
  }

  .pd-page-removed .pd-badge {
    background: color-mix(in srgb, #dc2626 16%, var(--surface));
    color: color-mix(in srgb, #b91c1c 80%, var(--ink));
  }

  .pd-page-label {
    font-size: 0.85rem;
    font-weight: 700;
  }

  .pd-page-meta {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.74rem;
  }

  .pd-page-text {
    max-height: 300px;
    margin: 0;
    padding: 0.8rem;
    overflow: auto;
    border-top: 1px solid var(--line);
    background: var(--surface-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .pd-same-note,
  .pd-empty {
    padding: 0.8rem;
    font-size: 0.82rem;
  }

  .pd-empty {
    margin: 0;
  }

  /* 목록은 스크립트가 만들므로 :global 로 스타일을 적용한다. */
  :global(.td-diff) {
    max-height: 420px;
    margin: 0;
    padding: 0;
    overflow: auto;
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    list-style: none;
  }

  :global(.td-diff .td-row) {
    display: grid;
    grid-template-columns: 3rem 3rem minmax(0, 1fr);
    border-bottom: 1px solid var(--line);
  }

  :global(.td-diff .td-row:last-child) {
    border-bottom: 0;
  }

  :global(.td-diff .td-no) {
    padding: 0.22rem 0.4rem;
    border-right: 1px solid var(--line);
    background: var(--surface-muted);
    color: var(--muted);
    text-align: right;
    font-variant-numeric: tabular-nums;
    user-select: none;
  }

  :global(.td-diff .td-content) {
    display: grid;
    gap: 0.1rem;
    padding: 0.22rem 0.55rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  :global(.td-diff .td-row-change) {
    background: color-mix(in srgb, #f59e0b 7%, var(--surface));
  }

  :global(.td-diff .td-row-add) {
    background: color-mix(in srgb, #16a34a 10%, var(--surface));
  }

  :global(.td-diff .td-row-remove) {
    background: color-mix(in srgb, #dc2626 10%, var(--surface));
  }

  :global(.td-diff .td-old) {
    color: color-mix(in srgb, #dc2626 72%, var(--ink));
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  :global(.td-diff .td-new) {
    color: color-mix(in srgb, #15803d 76%, var(--ink));
  }

  :global(.td-diff .td-mark) {
    display: inline-block;
    width: 0.9rem;
    font-weight: 800;
    text-align: center;
  }

  @media (max-width: 720px) {
    .pd-pair {
      grid-template-columns: 1fr;
    }

    .pd-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
