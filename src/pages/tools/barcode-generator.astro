---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';
import { BARCODE_FORMATS } from '@/lib/barcode';

const tool = getTool('barcode-generator');
if (!tool) throw new Error('barcode-generator 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/barcode-generator/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '바코드 만들기', path },
  ]),
];
---

<BaseLayout
  title="바코드 만들기 — Code 128·EAN-13·UPC·라벨 PDF"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">바코드 만들기</h2>

      <fieldset class="mode-switch">
        <legend class="visually-hidden">바코드 만들기 방식</legend>
        <label>
          <input id="bc-mode-single" type="radio" name="bc-mode" value="single" checked />
          <span>하나 만들기</span>
        </label>
        <label>
          <input id="bc-mode-batch" type="radio" name="bc-mode" value="batch" />
          <span>대량·라벨</span>
        </label>
      </fieldset>

      <div id="bc-single-panel">
        <div class="bc-layout">
          <div class="bc-form">
            <div class="field">
              <label for="bc-format">바코드 형식</label>
              <select id="bc-format">
                {
                  BARCODE_FORMATS.map((format) => (
                    <option value={format.id} selected={format.id === 'CODE128'}>
                      {format.label}
                    </option>
                  ))
                }
              </select>
              <span id="bc-format-note" class="hint"></span>
            </div>

            <div class="field">
              <label for="bc-value">값</label>
              <div class="bc-value-row">
                <input id="bc-value" type="text" autocomplete="off" spellcheck="false" />
                <button id="bc-sample" class="bc-mini" type="button">예시</button>
              </div>
              <span id="bc-check" class="bc-check" aria-live="polite"></span>
            </div>

            <div class="bc-options">
              <div class="field">
                <label for="bc-width">굵기 <output id="bc-width-value">2</output></label>
                <input id="bc-width" type="range" min="1" max="4" step="0.5" value="2" />
              </div>
              <div class="field">
                <label for="bc-height">높이 <output id="bc-height-value">80</output></label>
                <input id="bc-height" type="range" min="40" max="160" step="10" value="80" />
              </div>
              <div class="field">
                <label for="bc-margin">여백 <output id="bc-margin-value">10</output></label>
                <input id="bc-margin" type="range" min="0" max="20" step="2" value="10" />
              </div>
            </div>

            <div class="bc-options bc-options-small">
              <label class="bc-check-line">
                <input id="bc-display" type="checkbox" checked />
                <span>숫자 표시</span>
              </label>
              <div class="field bc-color">
                <label for="bc-dark">바코드 색</label>
                <input id="bc-dark" type="color" value="#111111" />
              </div>
              <div class="field bc-color">
                <label for="bc-light">배경색</label>
                <input id="bc-light" type="color" value="#ffffff" />
              </div>
            </div>

            <div id="bc-bearer-wrap" class="bc-bearer" hidden>
              <label class="bc-check-line">
                <input id="bc-bearer" type="checkbox" />
                <span>ITF-14 테두리(Bearer bar) 추가</span>
              </label>
            </div>

            <div class="tool-actions">
              <button id="bc-png" class="btn" type="button" disabled>PNG 내려받기</button>
              <button id="bc-svg" class="btn btn-secondary" type="button" disabled>SVG 내려받기</button>
            </div>
          </div>

          <aside class="bc-preview-side" aria-label="바코드 미리보기">
            <div class="bc-preview-frame">
              <svg id="bc-preview" role="img" aria-label="바코드 미리보기"></svg>
            </div>
            <p id="bc-preview-note" class="hint"></p>
            <p class="hint">
              생성한 바코드는 <a href="/tools/qr-reader/">QR·바코드 읽기</a>로 스캔 테스트를 해 볼 수
              있습니다.
            </p>
          </aside>
        </div>
      </div>

      <div id="bc-batch-panel" hidden>
        <label class="dropzone" id="bc-drop" for="bc-file">
          <span class="dropzone-icon" aria-hidden="true">🏷️</span>
          <strong>상품 코드가 담긴 CSV·엑셀 파일을 끌어다 놓으세요</strong>
          <small>코드 · 상품명 · 가격 · 최대 200개 · 서버 전송 없음</small>
          <input
            id="bc-file"
            class="visually-hidden"
            type="file"
            accept=".csv,.tsv,.xlsx,.xls,.ods"
          />
        </label>

        <div id="bc-batch-inner" hidden>
          <div class="bc-batch-layout">
            <div class="bc-batch-main">
              <div class="bc-batch-head">
                <strong>상품 목록</strong>
                <span id="bc-count" class="badge">0개</span>
              </div>
              <div class="bc-batch-table-wrap">
                <table id="bc-batch-table" class="bc-batch-table"></table>
              </div>
              <p id="bc-batch-note" class="hint"></p>

              <div class="bc-batch-options">
                <div class="field">
                  <label for="bc-batch-format">바코드 형식</label>
                  <select id="bc-batch-format">
                    {
                      BARCODE_FORMATS.map((format) => (
                        <option value={format.id} selected={format.id === 'CODE128'}>
                          {format.label}
                        </option>
                      ))
                    }
                  </select>
                </div>
                <div class="field">
                  <label for="bc-batch-preset">라벨 규격</label>
                  <select id="bc-batch-preset">
                    <option value="sheet-3x8" selected>A4 3×8 · 24칸</option>
                    <option value="sheet-2x6">A4 2×6 · 12칸</option>
                  </select>
                </div>
                <label class="bc-check-line">
                  <input id="bc-batch-price" type="checkbox" checked />
                  <span>가격 표시</span>
                </label>
              </div>
              <div id="bc-batch-bearer-wrap" hidden>
                <label class="bc-check-line">
                  <input id="bc-batch-bearer" type="checkbox" />
                  <span>ITF-14 테두리(Bearer bar) 추가</span>
                </label>
              </div>

              <div class="tool-actions">
                <button id="bc-batch-zip" class="btn" type="button">PNG ZIP</button>
                <button id="bc-batch-pdf" class="btn btn-secondary" type="button">라벨 PDF</button>
                <button id="bc-batch-reset" class="btn btn-secondary" type="button">다른 파일</button>
              </div>
            </div>

            <aside class="bc-batch-side" aria-label="라벨 미리보기">
              <h3>미리보기</h3>
              <div id="bc-batch-preview" class="bc-batch-preview"></div>
              <p class="hint">앞 3개만 보여 줍니다. 라벨 PDF에는 전체 상품이 들어갑니다.</p>
            </aside>
          </div>
        </div>
      </div>

      <p id="bc-status" class="status" role="status" aria-live="polite"></p>
      <p id="bc-error" class="error" role="alert" hidden></p>
    </section>

    <div class="prose">
      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>상품·재고·자산에 붙일 바코드를 만들 때</li>
        <li>Code 128로 사내 관리 번호를 만들 때</li>
        <li>EAN-13·UPC-A 상품 바코드를 확인할 때</li>
        <li>CSV 상품 목록을 A4 라벨 PDF로 인쇄할 때</li>
      </ul>

      <h2>형식 선택</h2>
      <ul>
        <li><strong>Code 128</strong> — 자유로운 내부 코드. 가장 실용적입니다.</li>
        <li><strong>GS1-128</strong> — AI 데이터. <code>(01)12345678901231|(10)LOT-001</code>처럼 입력하고, <code>|</code>는 FNC1 구분자로 바뀝니다.</li>
        <li><strong>EAN-13·UPC-A·EAN-8</strong> — 상품 바코드. 12·11·7자리를 넣으면 체크 디지트를 자동으로 붙입니다.</li>
        <li><strong>Code 39</strong> — 영문·숫자·일부 기호. 사번·티켓에 적합합니다.</li>
        <li><strong>ITF-14</strong> — 골판지 상자·물류 포장용 14자리. 테두리(Bearer bar)를 추가할 수 있습니다.</li>
      </ul>

      <h2>상품 코드 주의</h2>
      <p>
        EAN-13·UPC-A는 GS1에서 부여받은 상품 코드 접두어가 필요합니다. 이 도구는 코드를
        <strong>생성·검증</strong>할 뿐 GS1 등록을 대신하지 않습니다. 내부 관리용 번호는 Code 128을
        사용하세요.
      </p>

      <h2>인쇄 팁</h2>
      <ul>
        <li>바코드 주변의 <strong>여백(quiet zone)</strong>을 충분히 두세요. 여백이 없으면 스캐너가 읽지 못할 수 있습니다.</li>
        <li>라벨 PDF는 A4 3×8·2×6 규격입니다. 프린터에서 실제 크기(100%)로 인쇄하세요.</li>
        <li>잉크가 번지거나 대비가 낮으면 인식률이 떨어집니다.</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>대량 생성은 CSV·XLSX를 사용하며 최대 200개입니다.</li>
        <li>생성한 바코드는 자동 디코더 테스트로 실제 스캔 가능성을 확인합니다.</li>
        <li>형식에 맞지 않는 코드는 건너뛰고 오류로 알려 줍니다.</li>
        <li>입력값과 결과는 브라우저 안에서만 처리되며 서버로 전송되지 않습니다.</li>
      </ul>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initBarcodeGenerator } from '../../scripts/barcode-generator';

  initBarcodeGenerator();
</script>

<style>
  .mode-switch {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.3rem;
    margin: 0 0 1.2rem;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-muted);
  }

  .mode-switch label {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
  }

  .mode-switch input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .mode-switch label:has(input:checked) {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .mode-switch label:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .bc-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.8fr);
    gap: 1.25rem;
    align-items: start;
  }

  .bc-form {
    display: grid;
    gap: 0.85rem;
  }

  .bc-value-row {
    display: flex;
    gap: 0.4rem;
  }

  .bc-value-row input {
    flex: 1;
    min-width: 0;
  }

  .bc-mini {
    flex: none;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .bc-mini:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  .bc-check {
    min-height: 1.4em;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .bc-check[data-state='error'] {
    color: #b91c1c;
  }

  .bc-check[data-state='ok'] {
    color: var(--accent-strong);
  }

  .bc-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    align-items: end;
  }

  .bc-options-small {
    grid-template-columns: minmax(0, 1fr) minmax(7rem, 0.5fr) minmax(7rem, 0.5fr);
  }

  .bc-color input[type='color'] {
    width: 100%;
    min-height: 42px;
    padding: 0.25rem;
    cursor: pointer;
  }

  .bc-check-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 42px;
    color: var(--ink-soft);
    font-size: 0.82rem;
    cursor: pointer;
  }

  .bc-check-line input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--accent);
  }

  .bc-bearer {
    margin-top: -0.2rem;
  }

  .bc-preview-side {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 0.7rem;
  }

  .bc-preview-frame {
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }

  .bc-preview-frame svg {
    max-width: 100%;
    height: auto;
  }

  .bc-batch-table-wrap {
    max-height: 320px;
    margin-top: 0.5rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .bc-batch-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.76rem;
    white-space: nowrap;
  }

  .bc-batch-table th,
  .bc-batch-table td {
    padding: 0.4rem 0.55rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .bc-batch-table thead th {
    position: sticky;
    top: 0;
    background: var(--surface-muted);
    color: var(--muted);
    font-weight: 700;
  }

  .bc-batch-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .bc-batch-table .is-invalid {
    color: #b91c1c;
  }

  .bc-batch-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: 1.25rem;
    align-items: start;
  }

  .bc-batch-main {
    display: grid;
    gap: 0.7rem;
  }

  .bc-batch-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  .bc-batch-head strong {
    font-size: 0.9rem;
  }

  .bc-batch-options {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: end;
  }

  .bc-batch-side {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 0.6rem;
  }

  .bc-batch-side h3 {
    margin: 0;
    font-size: 0.95rem;
  }

  .bc-batch-preview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    min-height: 120px;
    padding: 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }

  :global(.bc-card) {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: #fff;
  }

  :global(.bc-card svg) {
    width: 100%;
    height: auto;
  }

  :global(.bc-card span) {
    overflow: hidden;
    color: #444;
    font-size: 0.6rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.bc-card.is-error) {
    place-items: center;
    color: #b91c1c;
    font-size: 0.68rem;
    text-align: center;
  }

  .bc-batch-empty {
    grid-column: 1 / -1;
    align-self: center;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    text-align: center;
  }

  @media (max-width: 900px) {
    .bc-layout,
    .bc-batch-layout {
      grid-template-columns: 1fr;
    }

    .bc-preview-side,
    .bc-batch-side {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .bc-options,
    .bc-options-small,
    .bc-batch-options {
      grid-template-columns: 1fr;
    }

    .bc-preview-frame {
      min-height: 150px;
    }
  }
</style>
