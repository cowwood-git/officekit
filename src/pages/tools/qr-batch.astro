---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('qr-batch');
if (!tool) throw new Error('qr-batch 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/qr-batch/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: 'QR 코드 대량 생성', path },
  ]),
];
---

<BaseLayout
  title="QR 코드 대량 생성 — CSV·목록을 PNG ZIP으로"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">QR 코드 대량 생성</h2>

      <div class="qb-layout">
        <div class="qb-controls">
          <section class="qb-block" aria-labelledby="qb-content-title">
            <div class="qb-block-head">
              <h3 id="qb-content-title">1. QR 내용</h3>
              <span id="qb-count" class="badge">0개</span>
            </div>

            <div class="qb-tools">
              <label class="btn btn-secondary" for="qb-file">CSV·XLSX 불러오기</label>
              <input
                id="qb-file"
                class="visually-hidden"
                type="file"
                accept=".csv,.tsv,.xlsx,.xls"
              />
              <button id="qb-sample" class="btn btn-secondary" type="button">예시 채우기</button>
              <button id="qb-add" class="btn btn-secondary" type="button">+ 항목 추가</button>
            </div>
            <p id="qb-import-note" class="hint"></p>
            <div id="qb-rows" class="qb-rows"></div>
          </section>

          <section class="qb-block" aria-labelledby="qb-options-title">
            <h3 id="qb-options-title">2. QR 설정</h3>
            <div class="qb-options">
              <div class="field">
                <label for="qb-size">크기</label>
                <select id="qb-size">
                  <option value="256">256px</option>
                  <option value="512" selected>512px</option>
                  <option value="1024">1024px</option>
                </select>
              </div>
              <div class="field">
                <label for="qb-margin">여백</label>
                <select id="qb-margin">
                  <option value="0">0</option>
                  <option value="1">1</option>
                  <option value="2" selected>2</option>
                  <option value="4">4</option>
                </select>
              </div>
              <div class="field">
                <label for="qb-ecc">오류 정정</label>
                <select id="qb-ecc">
                  <option value="L">L · 낮음</option>
                  <option value="M" selected>M · 보통</option>
                  <option value="Q">Q · 높음</option>
                  <option value="H">H · 매우 높음</option>
                </select>
              </div>
            </div>
            <div class="qb-colors">
              <div class="field">
                <label for="qb-dark">QR 색</label>
                <input id="qb-dark" type="color" value="#111111" />
              </div>
              <div class="field">
                <label for="qb-light">배경색</label>
                <input id="qb-light" type="color" value="#ffffff" />
              </div>
            </div>
            <p class="hint">인쇄용은 여백 2~4, 화면용은 1~2를 권장합니다. 배경과 대비가 충분해야 인식됩니다.</p>
          </section>

          <div class="tool-actions">
            <button id="qb-generate" class="btn" type="button">PNG ZIP 만들기</button>
            <button id="qb-reset" class="btn btn-secondary" type="button">새로 작성</button>
          </div>

          <p id="qb-status" class="status" role="status" aria-live="polite"></p>
          <p id="qb-error" class="error" role="alert" hidden></p>
        </div>

        <aside class="qb-side" aria-label="QR 미리보기">
          <div class="qb-side-head">
            <h3>미리보기</h3>
            <span id="qb-page-note" class="hint">앞 3개</span>
          </div>
          <div id="qb-preview" class="qb-preview"></div>
          <p class="hint">미리보기는 앞 3개만 보여 줍니다. ZIP에는 전체 항목이 들어갑니다.</p>

          <div id="qb-result" class="result-panel" tabindex="-1" hidden>
            <p class="result-value">QR ZIP이 준비됐습니다</p>
            <dl class="stat-grid">
              <div class="stat"><dt>파일 크기</dt><dd id="qb-result-size">-</dd></div>
              <div class="stat"><dt>형식</dt><dd>PNG ZIP</dd></div>
            </dl>
            <div class="tool-actions">
              <a id="qb-download" class="btn" href="#" hidden>ZIP 내려받기</a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <div class="prose">
      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>행사 안내·명단 링크를 QR로 한 번에 만들 때</li>
        <li>제품·자산마다 다른 QR 코드를 대량으로 만들 때</li>
        <li>CSV에 정리한 링크를 QR 이미지 ZIP으로 받을 때</li>
        <li>홍보물·포스터에 붙일 QR을 여러 개 준비할 때</li>
      </ul>

      <h2>CSV 준비</h2>
      <p>
        첫 열에 QR에 담을 내용(URL·텍스트), 둘째 열에 원하는 파일 이름을 넣으세요. 첫 행에
        <strong>내용·URL·파일명</strong> 같은 머리글이 있으면 자동으로 건너뜁니다. 파일 이름을
        비우면 <code>qr-001.png</code>처럼 번호가 붙습니다.
      </p>

      <h2>QR 설정</h2>
      <ul>
        <li><strong>크기</strong> — 256·512·1024px. 인쇄는 512px 이상을 권장합니다.</li>
        <li><strong>여백</strong> — QR 주변의 빈 칸입니다. 인쇄물에서는 2~4를 권장합니다.</li>
        <li><strong>오류 정정</strong> — 코드 일부가 가려져도 읽히는 정도입니다. 높을수록 촘촘해집니다.</li>
        <li><strong>색</strong> — 어두운 색과 밝은 배경의 대비가 충분해야 합니다.</li>
      </ul>

      <h2>알아두세요</h2>
      <ul>
        <li>한 번에 최대 200개까지 만들 수 있습니다.</li>
        <li>내용이 너무 길면 QR로 만들지 못할 수 있습니다. 오류 정정을 낮추거나 내용을 줄이세요.</li>
        <li>ZIP 생성과 QR 렌더링은 브라우저 안에서 실행되며 내용은 서버로 전송되지 않습니다.</li>
        <li>인쇄용 라벨 시트는 1차 버전에서 지원하지 않습니다. PNG를 라벨 프로그램에 배치하세요.</li>
      </ul>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initQrBatch } from '../../scripts/qr-batch';

  initQrBatch();
</script>

<style>
  .qb-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: 1.25rem;
    align-items: start;
  }

  .qb-controls {
    display: grid;
    gap: 1rem;
  }

  .qb-block {
    display: grid;
    gap: 0.7rem;
  }

  .qb-block + .qb-block {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .qb-block-head,
  .qb-side-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .qb-block h3,
  .qb-side-head h3 {
    margin: 0;
    font-size: 0.96rem;
    font-weight: 800;
  }

  .qb-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .qb-tools .btn {
    min-height: 40px;
    padding: 0.45rem 0.75rem;
    font-size: 0.82rem;
  }

  .qb-rows {
    display: grid;
    gap: 0.5rem;
  }

  :global(.qb-row) {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr) 2.25rem;
    gap: 0.45rem;
    padding: 0.55rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-muted);
    align-items: end;
  }

  :global(.qb-row .qb-field) {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  :global(.qb-row .qb-field span) {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 600;
  }

  :global(.qb-row input) {
    width: 100%;
    min-width: 0;
    min-height: 38px;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--surface);
    font-size: 0.8rem;
  }

  :global(.qb-remove) {
    width: 2.25rem;
    height: 38px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  :global(.qb-remove:hover) {
    border-color: var(--warn);
    background: var(--warn-soft);
    color: var(--warn);
  }

  .qb-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .qb-colors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .qb-colors input[type='color'] {
    width: 100%;
    min-height: 46px;
    padding: 0.25rem;
    cursor: pointer;
  }

  .qb-side {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 0.7rem;
  }

  .qb-preview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    min-height: 130px;
    padding: 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
  }

  :global(.qb-card) {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: #fff;
  }

  :global(.qb-card img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    image-rendering: pixelated;
  }

  :global(.qb-card span) {
    overflow: hidden;
    color: #444;
    font-size: 0.58rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.qb-card.is-error) {
    display: grid;
    place-items: center;
    min-height: 100px;
    color: #b91c1c;
    font-size: 0.68rem;
    text-align: center;
  }

  .qb-empty {
    grid-column: 1 / -1;
    align-self: center;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    text-align: center;
  }

  .qb-side .result-panel {
    margin-top: 0.2rem;
  }

  @media (max-width: 900px) {
    .qb-layout {
      grid-template-columns: 1fr;
    }

    .qb-side {
      position: static;
    }
  }

  @media (max-width: 560px) {
    :global(.qb-row) {
      grid-template-columns: minmax(0, 1fr) 2.25rem;
      grid-template-areas:
        'content remove'
        'name name';
    }

    :global(.qb-content) {
      grid-area: content;
    }

    :global(.qb-name) {
      grid-area: name;
    }

    :global(.qb-remove) {
      grid-area: remove;
    }

    .qb-options {
      grid-template-columns: 1fr;
    }
  }
</style>
