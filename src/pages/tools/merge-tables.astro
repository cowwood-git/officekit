---
import ToolLayout from '@/components/ToolLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTool } from '@/data/tools';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema, toolSchema } from '@/lib/schema';
import { hubCrumb } from '@/lib/related-tools';

const tool = getTool('merge-tables');
if (!tool) throw new Error('merge-tables 도구를 찾을 수 없습니다.');
const site = Astro.site ?? new URL(SITE.url);
const path = '/tools/merge-tables/';
const jsonLd = [
  toolSchema(tool, site, path),
  faqSchema(tool.faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...hubCrumb(tool.slug),
    { name: '여러 표 합치기', path },
  ]),
];
---

<BaseLayout
  title="여러 표 합치기 — CSV·엑셀 파일을 한 표로"
  description={tool.description.ko}
  path={path}
  jsonLd={jsonLd}
>
  <ToolLayout tool={tool}>
    <section class="tool-panel" aria-labelledby="panel-title">
      <h2 id="panel-title" class="visually-hidden">여러 표 합치기</h2>

      <label class="dropzone" id="mt-drop" for="mt-input">
        <span class="dropzone-icon" aria-hidden="true">🧩</span>
        <strong>합칠 CSV·엑셀 파일을 끌어다 놓으세요</strong>
        <small>여러 파일 · CSV · TSV · XLSX · XLS · 최대 50MB</small>
        <input
          id="mt-input"
          class="visually-hidden"
          type="file"
          multiple
          accept=".csv,.tsv,.xlsx,.xls,.ods"
        />
      </label>

      <p id="mt-status" class="status" role="status" aria-live="polite"></p>
      <p id="mt-error" class="error" role="alert" hidden></p>

      <div id="mt-panel" hidden>
        <div class="mt-file-head">
          <strong>합칠 파일</strong>
          <div class="mt-file-actions">
            <span id="mt-file-count" class="badge">0개</span>
            <label class="btn btn-secondary mt-add" for="mt-input">파일 추가</label>
          </div>
        </div>
        <ul id="mt-files" class="mt-files" aria-label="합칠 파일 목록"></ul>

        <div class="mt-options">
          <label class="mt-check">
            <input id="mt-header" type="checkbox" checked />
            <span>첫 행을 열 이름으로 사용</span>
          </label>
          <label class="mt-check">
            <input id="mt-dedupe" type="checkbox" />
            <span>중복 행 제거</span>
          </label>
        </div>

        <div class="tool-actions">
          <button id="mt-run" class="btn" type="button">표 합치기</button>
          <button id="mt-reset" class="btn btn-secondary" type="button">모두 지우기</button>
        </div>

        <div id="mt-result" tabindex="-1" hidden>
          <div class="mt-result-head">
            <p id="mt-summary" class="hint"></p>
            <div class="tool-actions">
              <a id="mt-csv" class="btn btn-secondary" href="#" hidden>CSV 내려받기</a>
              <a id="mt-xlsx" class="btn btn-secondary" href="#" hidden>XLSX 내려받기</a>
            </div>
          </div>
          <div class="mt-preview-wrap">
            <table id="mt-preview" class="mt-preview"></table>
          </div>
          <p class="hint">미리보기는 앞 50행만 보여 줍니다. 내려받는 파일에는 전체 행이 들어갑니다.</p>
        </div>
      </div>
    </section>

    <div class="prose">
      <h2>이럴 때 씁니다</h2>
      <ul>
        <li>월별로 나뉜 매출·재고 CSV를 하나로 합칠 때</li>
        <li>부서별로 받은 엑셀 파일을 한 표로 모을 때</li>
        <li>열 순서가 조금씩 다른 파일을 열 이름 기준으로 맞출 때</li>
        <li>합친 뒤 중복 행을 한 번에 정리할 때</li>
      </ul>

      <h2>합치는 방식</h2>
      <p>
        파일마다 첫 행을 열 이름으로 보고, 열 이름의 합집합을 만듭니다. 같은 이름의 열은 하나로
        모으고, 한 파일에만 있는 열은 빈 칸으로 채웁니다. 예를 들어 A 파일에 ‘이름·부서’, B 파일에
        ‘이름·지역’이 있으면 결과는 ‘이름·부서·지역’이 됩니다.
      </p>

      <h2>시트 선택</h2>
      <p>
        엑셀 파일에 시트가 여러 개면 파일 목록에서 사용할 시트를 고르세요. CSV·TSV는 시트가 하나라
        자동으로 선택됩니다.
      </p>

      <h2>알아두세요</h2>
      <ul>
        <li>한 번에 최대 20개 파일, 10만 행까지 합칩니다.</li>
        <li>파일 크기는 각각 50MB 이하를 권장합니다.</li>
        <li>수식은 계산된 표시값으로 읽습니다.</li>
        <li>열 이름의 앞뒤 공백은 정리하지만, 대소문자는 구분합니다.</li>
        <li>파일과 결과는 브라우저 안에서만 처리되며 서버로 전송되지 않습니다.</li>
      </ul>
    </div>
  </ToolLayout>
</BaseLayout>

<script>
  import { initMergeTables } from '../../scripts/merge-tables';

  initMergeTables();
</script>

<style>
  .mt-file-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0.9rem 0 0.5rem;
  }

  .mt-file-head strong {
    font-size: 0.9rem;
  }

  .mt-file-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .mt-add {
    min-height: 34px;
    padding: 0.3rem 0.6rem;
    font-size: 0.74rem;
  }

  .mt-files {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.mt-file) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(9rem, 0.7fr) auto;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-muted);
  }

  :global(.mt-file-name) {
    min-width: 0;
    overflow: hidden;
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.mt-file select) {
    width: 100%;
    min-width: 0;
    min-height: 36px;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--surface);
    font-size: 0.76rem;
  }

  :global(.mt-remove) {
    width: 30px;
    height: 30px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }

  :global(.mt-remove:hover) {
    border-color: var(--warn);
    color: var(--warn);
  }

  .mt-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
    margin-top: 0.9rem;
  }

  .mt-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.84rem;
    cursor: pointer;
  }

  .mt-check input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--accent);
  }

  .mt-result-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 1rem 0 0.7rem;
  }

  .mt-result-head .tool-actions {
    margin-top: 0;
  }

  .mt-result-head .btn {
    min-height: 38px;
    padding: 0.4rem 0.7rem;
    font-size: 0.78rem;
  }

  .mt-preview-wrap {
    max-height: 420px;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .mt-preview-wrap table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.76rem;
    white-space: nowrap;
  }

  .mt-preview-wrap th,
  .mt-preview-wrap td {
    padding: 0.4rem 0.55rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .mt-preview-wrap thead th {
    position: sticky;
    top: 0;
    background: var(--surface-muted);
    color: var(--muted);
    font-weight: 700;
    text-align: left;
  }

  .mt-preview-wrap tbody tr:last-child td {
    border-bottom: 0;
  }

  @media (max-width: 620px) {
    :global(.mt-file) {
      grid-template-columns: minmax(0, 1fr) 2rem;
      grid-template-areas:
        'name remove'
        'sheet sheet';
    }

    :global(.mt-file-name) {
      grid-area: name;
    }

    :global(.mt-file select) {
      grid-area: sheet;
    }

    :global(.mt-remove) {
      grid-area: remove;
      justify-self: end;
    }
  }
</style>
