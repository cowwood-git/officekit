---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import HubHeader from '@/components/HubHeader.astro';
import { FORM_FAMILIES, FORMS } from '@/data/forms';
import { FORM_CATEGORIES, formsInCategory } from '@/data/form-categories';
import { SITE } from '@/consts';
import { breadcrumbSchema } from '@/lib/schema';

const site = Astro.site ?? new URL(SITE.url);
const path = '/forms/';
const categoryGroups = FORM_CATEGORIES.map((category) => ({
  ...category,
  forms: formsInCategory(FORMS, category.id),
}));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '업무 양식',
    description:
      '휴가신청서·회의록·견적서처럼 매일 쓰는 업무 양식을 브라우저에서 작성하고 A4 PDF로 저장합니다.',
    url: new URL(path, site).toString(),
    inLanguage: 'ko',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: site.toString() },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '업무 양식 목록',
    itemListElement: FORMS.map((form, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: form.title,
      url: new URL(`/forms/${form.slug}/`, site).toString(),
    })),
  },
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    { name: '양식', path },
  ]),
];
---

<BaseLayout
  title="업무 양식 — 작성하고 바로 PDF로 저장"
  description="휴가신청서·회의록·견적서·거래명세서처럼 매일 쓰는 업무 양식을 브라우저에서 작성하고 A4 PDF로 저장합니다. 입력값은 서버로 전송되지 않습니다."
  path={path}
  jsonLd={jsonLd}
>
  <article class="forms-page">
    <div class="container">
      <Breadcrumbs items={[{ label: '홈', href: '/' }, { label: '양식' }]} />

      <HubHeader
        eyebrow="FORMS"
        title="업무 양식"
        lead="휴가신청서·회의록·견적서처럼 매일 쓰는 업무 양식을 브라우저에서 바로 작성합니다. 빈 양식으로 인쇄하거나, 작성한 내용을 A4 PDF로 내려받으세요."
      />

      <section class="forms-section" id="all" aria-labelledby="forms-title">
        <h2 id="forms-title" class="visually-hidden">양식 목록</h2>

        <div class="forms-search">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-3.5-3.5"></path>
          </svg>
          <label class="visually-hidden" for="forms-search">양식 이름이나 쓰임새 검색</label>
          <input
            id="forms-search"
            type="search"
            placeholder="양식 이름이나 쓰임새를 검색하세요. 예: 휴가, 견적서, 출장"
            autocomplete="off"
            aria-controls="forms-list"
            aria-describedby="forms-search-count"
          />
          <button
            id="forms-search-clear"
            class="forms-search-clear"
            type="button"
            aria-label="양식 검색어 지우기"
            hidden
          >
            ✕
          </button>
        </div>
        <p id="forms-search-count" class="forms-search-count" role="status" aria-live="polite">
          {FORMS.length}개 양식
        </p>

        <nav class="form-category-nav" aria-label="양식 카테고리">
          <button type="button" class="form-category-chip" data-form-filter="all" aria-pressed="true">
            전체 <span>{FORMS.length}</span>
          </button>
          {categoryGroups.map((category) => (
            <button
              type="button"
              class="form-category-chip"
              data-form-filter={category.id}
              aria-pressed="false"
            >
              {category.label} <span>{category.forms.length}</span>
            </button>
          ))}
        </nav>

        <div class="form-category-list" id="forms-list">
          {categoryGroups.map((category) => (
            <section
              class="form-category"
              id={category.id}
              data-form-category={category.id}
              aria-labelledby={`${category.id}-title`}
            >
              <div class="form-category-head">
                <div>
                  <h3 id={`${category.id}-title`}>{category.label}</h3>
                  <p>{category.description}</p>
                </div>
                <span>{category.forms.length}종</span>
              </div>
              <ul class="form-grid" role="list">
                {category.forms.map((form) => (
                  <li data-form-item>
                    <a
                      class="form-card"
                      data-form-card
                      data-category={category.id}
                      data-haystack={`${form.title} ${form.lead} ${form.keywords.join(' ')} ${category.label}`}
                      href={`/forms/${form.slug}/`}
                    >
                      <span class="paper" aria-hidden="true">
                        <span class="paper-line accent" />
                        <span class="paper-title">{form.title}</span>
                        <span class="paper-line" />
                        <span class="paper-line" />
                        <span class="paper-line short" />
                        <span class="paper-sign">(서명)</span>
                      </span>
                      <span class="card-body">
                        <span class="card-kicker">{FORM_FAMILIES[form.family]}</span>
                        <strong>{form.title}</strong>
                        <span class="card-desc">{form.lead}</span>
                        <span class="card-cta">작성하기 →</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <p id="forms-empty" class="forms-empty" hidden>
          <strong>검색 결과가 없습니다.</strong> 다른 단어로 찾아보거나
          <button type="button" data-forms-reset>전체 양식 보기</button>
        </p>
      </section>

      <section class="forms-section travel-pack" aria-labelledby="travel-pack-title">
        <div class="section-head">
          <h2 id="travel-pack-title">출장 팩</h2>
          <p>신청 → 보고 → 정산을 한 흐름으로.</p>
        </div>
        <ol class="pack-steps">
          <li>
            <a href="/forms/travel-request/">
              <span>01</span>
              <strong>출장신청서</strong>
              <small>계획·예상 경비</small>
            </a>
          </li>
          <li>
            <a href="/forms/travel-report/">
              <span>02</span>
              <strong>출장보고서</strong>
              <small>활동·결과·후속 조치</small>
            </a>
          </li>
          <li>
            <a href="/forms/travel-expense/">
              <span>03</span>
              <strong>출장비 정산서</strong>
              <small>지출·잔액·영수증</small>
            </a>
          </li>
        </ol>
      </section>

      <div class="prose forms-notes">
        <h2>양식을 고르는 기준</h2>
        <p>
          업무에서 반복해서 쓰고, 파일이 서버로 가면 부담이 되는 양식부터 엽니다. 화면에서
          바로 작성할 수 있고, 인쇄해서 손으로 쓸 수 있으며, 결과를 PDF로 남길 수 있는 것을
          우선합니다.
        </p>

        <h2>문서 스타일</h2>
        <p>
          모든 양식은 <strong>옷깃 페이퍼</strong>라는 하나의 문서 스타일을 씁니다. 상단의 짧은
          강조선과 회색 괘선, 가운데 제목, 점선으로 이어지는 라벨, 가로선 중심의 표가
          특징입니다. 양식마다 디자인이 달라 보이지 않도록 같은 여백과 활자를 씁니다.
        </p>

        <h2>빈 양식과 작성본</h2>
        <p>
          각 양식은 작성본과 빈 양식을 모두 제공합니다. 빈 양식은 인쇄해서 손으로 쓰기 좋게
          점선과 서명란을 배치하고, 작성본은 입력한 값을 같은 자리에 그대로 인쇄합니다.
        </p>

        <h2>입력값은 어디로 가나요</h2>
        <p>
          입력과 PDF 생성은 모두 브라우저 안에서 이루어집니다. 파일은 서버로 전송되지 않으며,
          입력값은 이 브라우저에만 임시 저장됩니다. 공용 PC에서는 사용 후 초기화하세요.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import { FORM_CATEGORIES } from '@/data/form-categories';

  const input = document.getElementById('forms-search') as HTMLInputElement | null;
  const clearButton = document.getElementById('forms-search-clear');
  const count = document.getElementById('forms-search-count');
  const empty = document.getElementById('forms-empty');
  const list = document.getElementById('forms-list');

  if (input && count && empty && list) {
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-form-card]'));
    const items = cards.map((card) => card.closest<HTMLElement>('[data-form-item]'));
    const sections = Array.from(
      list.querySelectorAll<HTMLElement>('[data-form-category]'),
    );
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-form-filter]'),
    );
    const labels = new Map<string, string>(
      FORM_CATEGORIES.map((category) => [category.id, category.label]),
    );
    const params = new URL(window.location.href).searchParams;
    const hash = window.location.hash.slice(1);
    let active = params.get('category') ?? (hash || 'all');
    if (active !== 'all' && !labels.has(active)) active = 'all';
    input.value = params.get('q') ?? '';

    const normalize = (value: string) => value.toLowerCase().replace(/\s+/g, ' ').trim();
    const haystacks = cards.map((card) => normalize(card.dataset.haystack ?? ''));

    const syncUrl = () => {
      const url = new URL(window.location.href);
      if (input.value.trim()) url.searchParams.set('q', input.value.trim());
      else url.searchParams.delete('q');
      url.searchParams.delete('category');
      url.hash = active === 'all' ? '' : active;
      window.history.replaceState(null, '', url);
    };

    const apply = () => {
      const query = normalize(input.value);
      const searching = query !== '';
      const words = query.split(' ').filter(Boolean);
      let visible = 0;

      cards.forEach((card, index) => {
        const haystack = haystacks[index] ?? '';
        const compact = haystack.replace(/\s+/g, '');
        const matchedText =
          !searching ||
          words.every(
            (word) => haystack.includes(word) || compact.includes(word.replace(/\s+/g, '')),
          );
        const matchedCategory =
          active === 'all' || card.dataset.category === active;
        const show = matchedText && matchedCategory;
        const item = items[index];
        if (item) item.hidden = !show;
        else card.hidden = !show;
        if (show) visible += 1;
      });

      for (const section of sections) {
        const hasVisible = Array.from(
          section.querySelectorAll<HTMLElement>('[data-form-item]'),
        ).some((item) => !item.hidden);
        section.hidden = !hasVisible;
      }

      const parts = [
        active === 'all' ? '' : labels.get(active),
        searching ? `“${input.value.trim()}”` : '',
      ].filter(Boolean);
      count.textContent = `${visible}개 양식${parts.length > 0 ? ` · ${parts.join(' · ')}` : ''}`;
      empty.hidden = visible > 0;
      if (clearButton) clearButton.hidden = !searching;

      for (const button of buttons) {
        button.setAttribute(
          'aria-pressed',
          String((button.dataset.formFilter ?? 'all') === active),
        );
      }
      syncUrl();
    };

    const reset = () => {
      active = 'all';
      input.value = '';
      apply();
      input.focus();
    };

    input.addEventListener('input', apply);
    input.addEventListener('search', apply);
    clearButton?.addEventListener('click', reset);
    empty.querySelector<HTMLButtonElement>('[data-forms-reset]')?.addEventListener('click', reset);
    for (const button of buttons) {
      button.addEventListener('click', () => {
        active = button.dataset.formFilter ?? 'all';
        apply();
      });
    }

    apply();
  }
</script>

<style>
  .forms-page {
    padding-block: 1.6rem 3rem;
  }

  .container {
    width: min(100% - (var(--gutter) * 2), 1080px);
    margin-inline: auto;
  }

  .forms-section {
    margin-top: 1rem;
  }

  .forms-section + .forms-section {
    margin-top: 2.4rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-head h2 {
    margin: 0;
    font-size: var(--step-1);
  }

  .section-head p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .forms-search {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.5rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--surface);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .forms-search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .forms-search svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .forms-search input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.94rem;
  }

  .forms-search input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .forms-search-clear {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--surface-muted);
    color: var(--muted);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .forms-search-clear:hover {
    background: var(--line);
    color: var(--ink);
  }

  .forms-search-count {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }

  .form-category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.4rem;
  }

  .form-category-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .form-category-chip span {
    color: var(--muted);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .form-category-chip:hover,
  .form-category-chip:focus-visible {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .form-category-chip[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .forms-empty {
    margin: 1.5rem 0 0;
    padding: 1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink-soft);
    font-size: 0.88rem;
    text-align: center;
  }

  .forms-empty button {
    margin-left: 0.35rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent-strong);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  .form-category {
    scroll-margin-top: 5.5rem;
  }

  .form-category + .form-category {
    margin-top: 2.2rem;
  }

  .form-category-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .form-category-head h3 {
    margin: 0;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
  }

  .form-category-head p {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .form-category-head > span {
    flex: none;
    color: var(--muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .pack-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }

  .pack-steps a {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.16s ease;
  }

  .pack-steps a:hover {
    border-color: var(--accent);
  }

  .pack-steps span {
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .pack-steps strong {
    font-size: 0.95rem;
  }

  .pack-steps small {
    color: var(--muted);
    font-size: 0.76rem;
  }

  @media (max-width: 720px) {
    .pack-steps {
      grid-template-columns: 1fr;
    }
  }

  .form-card {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    height: 100%;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }

  .form-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .paper {
    display: grid;
    align-content: start;
    gap: 7px;
    aspect-ratio: 210 / 297;
    padding: 14px 12px;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 8px 18px -14px rgb(20 24 31 / 0.45);
  }

  .paper-line {
    display: block;
    height: 1px;
    background: #d9d5cb;
  }

  .paper-line.accent {
    width: 34%;
    height: 2px;
    background: #0b6b5b;
  }

  .paper-line.short {
    width: 62%;
  }

  .paper-title {
    margin: 4px 0 2px;
    color: #14181f;
    font-size: 0.62rem;
    font-weight: 800;
    text-align: center;
  }

  .paper-sign {
    align-self: end;
    justify-self: end;
    margin-top: auto;
    color: #8a929c;
    font-size: 0.5rem;
  }

  .card-body {
    display: grid;
    gap: 0.32rem;
    min-width: 0;
  }

  .card-kicker {
    color: var(--accent-strong);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .card-body strong {
    font-size: 1.05rem;
  }

  .card-desc {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.55;
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .card-cta {
    margin-top: 0.3rem;
    color: var(--accent-strong);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .forms-notes {
    margin-top: 3.4rem;
    max-width: 820px;
  }

  @media (max-width: 560px) {
    .section-head {
      display: block;
    }

    .section-head p {
      margin-top: 0.25rem;
    }

    .form-card {
      grid-template-columns: 92px minmax(0, 1fr);
    }
  }
</style>
