---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import BundleCard from '@/components/forms/BundleCard.astro';
import { FORM_BUNDLES, getBundle } from '@/data/form-bundles';
import { getForm } from '@/data/forms';
import { formCategory, KIDS_CATEGORY } from '@/data/form-categories';
import { SITE } from '@/consts';
import {
  breadcrumbSchema,
  collectionPageSchema,
  faqSchema,
  howToSchema,
} from '@/lib/schema';
import type { FormBundle } from '@/data/form-bundles';

export function getStaticPaths() {
  return FORM_BUNDLES.map((bundle) => ({
    params: { slug: bundle.slug },
    props: { bundle },
  }));
}

interface Props {
  bundle: FormBundle;
}

const { bundle } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const path = `/forms/bundles/${bundle.slug}/`;
const category = formCategory(bundle.category);
/** 유아·어린이 공책 묶음은 /kids/ 섹션 아래로 보여 준다. */
const kids = bundle.category === KIDS_CATEGORY;
const steps = bundle.steps
  .map((step) => ({ ...step, form: getForm(step.slug) }))
  .filter((step) => step.form);
const relatedBundles = bundle.relatedBundles
  .map((slug) => getBundle(slug))
  .filter((item): item is FormBundle => Boolean(item));
const updatedLabel = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(`${bundle.updated}T00:00:00Z`));

const jsonLd = [
  collectionPageSchema(
    site,
    bundle.title,
    bundle.description,
    path,
    steps.map((step) => ({
      name: step.form?.title ?? step.slug,
      path: `/forms/${step.slug}/`,
      description: step.reason,
    })),
  ),
  howToSchema(
    site,
    bundle.title,
    bundle.lead,
    path,
    steps.map((step) => ({
      name: step.role,
      text: step.reason,
      path: `/forms/${step.slug}/`,
    })),
  ),
  faqSchema([...bundle.faq]),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    ...(kids
      ? [{ name: '유아·어린이 학습', path: '/kids/' }]
      : [
          { name: '양식', path: '/forms/' },
          { name: '문서 묶음', path: '/forms/bundles/' },
        ]),
    { name: bundle.shortTitle, path },
  ]),
];
---

<BaseLayout
  title={`${bundle.title} — 순서와 체크리스트 | 옷깃`}
  description={bundle.description}
  path={path}
  jsonLd={jsonLd}
>
  <article class="bundle-page">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: '홈', href: '/' },
          ...(kids
            ? [{ label: '유아·어린이 학습', href: '/kids/' }]
            : [
                { label: '양식', href: '/forms/' },
                { label: '문서 묶음', href: '/forms/bundles/' },
              ]),
          { label: bundle.shortTitle },
        ]}
      />

      <header class="bundle-head">
        <p class="eyebrow">{category.label} · 문서 묶음</p>
        <h1>{bundle.title}</h1>
        <p class="lead">{bundle.lead}</p>
        <p class="meta">
          <time datetime={bundle.updated}>최종 검토 {updatedLabel}</time>
          <span>·</span>
          <span>{steps.length}개 문서</span>
          <span>·</span>
          <span>입력값은 서버로 전송되지 않습니다</span>
        </p>
      </header>

      <section class="bundle-steps" aria-labelledby="bundle-steps-title">
        <div class="section-head">
          <div>
            <p class="section-kicker">FLOW</p>
            <h2 id="bundle-steps-title">{bundle.stepHeading}</h2>
          </div>
          <p>필요한 문서만 골라 작성해도 됩니다.</p>
        </div>

        <ol class="step-list">
          {
            steps.map((step, index) => (
              <li>
                <a class="step-card" href={`/forms/${step.slug}/`} data-bundle-step={step.slug}>
                  <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="step-body">
                    <span class="step-role">{step.role}</span>
                    <strong>{step.form?.title}</strong>
                    <span class="step-reason">{step.reason}</span>
                    {step.optional && <span class="step-optional">선택 사항</span>}
                  </span>
                  <span class="step-cta">작성하기 →</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="bundle-notes-grid">
        <section class="bundle-checklist" aria-labelledby="bundle-checklist-title">
          <h2 id="bundle-checklist-title">준비물 체크리스트</h2>
          <ul>
            {bundle.checklist.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="bundle-mistakes" aria-labelledby="bundle-mistakes-title">
          <h2 id="bundle-mistakes-title">자주 하는 실수</h2>
          <ul>
            {bundle.notes.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>

      <Faq items={[...bundle.faq]} />

      {
        relatedBundles.length > 0 && (
          <section class="bundle-related" aria-labelledby="bundle-related-title">
            <div class="section-head">
              <h2 id="bundle-related-title">다른 문서 묶음</h2>
              <a href="/forms/bundles/">전체 묶음 보기 →</a>
            </div>
            <ul class="related-grid" role="list">
              {relatedBundles.map((item) => (
                <li>
                  <BundleCard bundle={item} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <p class="bundle-disclaimer">
        이 묶음은 참고용입니다. 회사의 규정과 관련 법령을 함께 확인하고, 중요한 계약·노무
        사안은 전문가의 검토를 권장합니다.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .bundle-page {
    padding-block: 1.6rem 3rem;
  }

  .container {
    width: min(100% - (var(--gutter) * 2), 1080px);
    margin-inline: auto;
  }

  .bundle-head {
    max-width: 780px;
    margin: 1.1rem 0 2rem;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0.2rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .lead {
    max-width: 60ch;
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-head h2 {
    margin: 0;
    font-size: var(--step-2);
  }

  .section-head p {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .section-head a {
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .section-kicker {
    margin: 0 0 0.25rem;
    color: var(--accent-strong);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .step-list {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.16s ease,
      transform 0.16s ease;
  }

  .step-card:hover,
  .step-card:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .step-number {
    color: var(--accent-strong);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .step-body {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
  }

  .step-role {
    color: var(--accent-strong);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .step-body strong {
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .step-reason {
    color: var(--ink-soft);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .step-optional {
    justify-self: start;
    margin-top: 0.15rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.64rem;
    font-weight: 700;
  }

  .step-cta {
    align-self: center;
    color: var(--accent-strong);
    font-size: 0.76rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .bundle-notes-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.6rem;
  }

  .bundle-checklist,
  .bundle-mistakes {
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .bundle-checklist h2,
  .bundle-mistakes h2 {
    margin: 0 0 0.7rem;
    font-size: 1rem;
  }

  .bundle-checklist ul,
  .bundle-mistakes ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .bundle-related {
    margin-top: 3rem;
    padding-top: 1.8rem;
    border-top: 1px solid var(--line);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bundle-disclaimer {
    max-width: 820px;
    margin-top: 2.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .bundle-notes-grid {
      grid-template-columns: 1fr;
    }

    .step-card {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .step-cta {
      grid-column: 2;
      justify-self: start;
    }

    .section-head {
      display: block;
    }

    .section-head p,
    .section-head a {
      display: inline-block;
      margin-top: 0.35rem;
    }
  }

  @media (max-width: 620px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
