---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import DocPreview from '@/components/forms/DocPreview.astro';
import FormFields from '@/components/forms/FormFields.astro';
import LayoutMode from '@/components/forms/LayoutMode.astro';
import ConfirmDialog from '@/components/forms/ConfirmDialog.astro';
import CompanyPreset from '@/components/forms/CompanyPreset.astro';
import RelatedForms from '@/components/forms/RelatedForms.astro';
import ShareButton from '@/components/ShareButton.astro';
import { isKidsForm } from '@/data/form-categories';
import { FORM_FAMILIES, FORMS } from '@/data/forms';
import { bundlesForForm } from '@/data/form-bundles';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';
import { formDisclaimer } from '@/lib/form-disclaimer';
import type { FormBlock, FormTemplate } from '@/lib/doc/types';

export function getStaticPaths() {
  return FORMS.map((form) => ({
    params: { slug: form.slug },
    props: { form },
  }));
}

interface Props {
  form: FormTemplate;
}

const { form } = Astro.props;
const headerBlock = form.blocks.find(
  (block): block is Extract<FormBlock, { kind: 'header' }> => block.kind === 'header',
);
const bundles = bundlesForForm(form.slug);
const primaryBundle = bundles[0];
const site = Astro.site ?? new URL(SITE.url);
const path = `/forms/${form.slug}/`;
const updatedLabel = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(`${form.updated}T00:00:00Z`));

/** 어린이 학습 공책은 업무 양식과 다른 섹션(/kids/)으로 보여 준다. 주소는 그대로. */
const kids = isKidsForm(form);
const section = kids ? { name: '어린이 학습 공책', path: '/kids/' } : { name: '양식', path: '/forms/' };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: form.title,
    description: form.description,
    url: new URL(path, site).toString(),
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    browserRequirements: 'JavaScript',
    inLanguage: 'ko',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    dateModified: form.updated,
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: site.toString(),
    },
  },
  faqSchema([...form.faq]),
  breadcrumbSchema(site, [{ name: '홈', path: '/' }, section, { name: form.title, path }]),
];
---

<BaseLayout
  title={`${form.title} 양식 — 작성하고 바로 PDF로`}
  description={form.description}
  path={path}
  jsonLd={jsonLd}
>
  <article class="form-page" data-form-page data-form-slug={form.slug}>
    <div class="container">
      <Breadcrumbs
        items={[
          { label: '홈', href: '/' },
          { label: section.name, href: section.path },
          { label: form.title },
        ]}
      />

      <header class="form-head">
        <p class="eyebrow">{kids ? '어린이 학습 · 공책' : `${FORM_FAMILIES[form.family]} · 양식`}</p>
        <div class="form-title-row">
          <h1>{form.title} 양식</h1>
          <div class="title-actions">
            <button
              type="button"
              class="form-favorite"
              data-form-favorite
              aria-pressed="false"
              aria-label="이 양식을 즐겨찾기에 추가"
            >
              <span data-favorite-icon aria-hidden="true">☆</span>
              <span data-favorite-label>즐겨찾기</span>
            </button>
            <ShareButton title={form.title} kind="form" />
          </div>
        </div>
        <p class="lead">{form.lead}</p>
        <p class="meta">
          <time datetime={form.updated}>최종 검토 {updatedLabel}</time>
          <span>·</span>
          <span>입력값은 서버로 전송되지 않습니다</span>
        </p>
        {primaryBundle && (
          <a class="bundle-chip" href={`/forms/bundles/${primaryBundle.slug}/`}>
            {primaryBundle.shortTitle} {primaryBundle.steps.length}종에 포함
            <span aria-hidden="true">→</span>
          </a>
        )}
      </header>

      <div class="form-toolbar">
        <button type="button" class="btn btn-secondary" data-fill-sample>예시 채우기</button>
        <button type="button" class="btn btn-secondary" data-reset>초기화</button>
        <details class="save-menu" data-save-menu>
          <summary class="btn btn-secondary">
            한글 파일
            <span class="save-menu-caret" aria-hidden="true">▾</span>
          </summary>
          <div class="save-menu-list" role="menu" aria-label="한글 파일 형식">
            <button type="button" role="menuitem" data-hwp-download="hwp">
              HWP로 저장
              <small>한글 2010+ 호환 · 기본</small>
            </button>
            <button type="button" role="menuitem" data-hwp-download="hwpx">
              HWPX로 저장
              <small>한글 2014+ 권장</small>
            </button>
          </div>
        </details>
        {form.groups && form.groups.length > 0 && (
          <button type="button" class="btn btn-secondary" data-xlsx-download>
            엑셀로 저장
          </button>
        )}
        <button type="button" class="btn" data-download>PDF 만들기</button>
      </div>

      <p class="form-hwp-note">
        한글 파일은 PDF와 같은 구성으로 글자·표를 직접 고칠 수 있게 만든 편집용입니다. 서체는 나눔고딕 기준이며, PC에 없으면 비슷한 고딕으로 보입니다.
        {form.groups && form.groups.length > 0 && ' 표 데이터는 엑셀로도 저장해 수식과 함께 이어 쓸 수 있습니다.'}
      </p>

      <p class="form-error" data-form-error role="alert" hidden></p>
      {form.warn && (
        <ul class="form-warning" data-form-warning role="status" aria-live="polite" hidden></ul>
      )}

      {form.companyParty && <CompanyPreset />}

      <div class="form-layout">
        <div class="form-input" data-form>
          <FormFields
            fields={form.fields}
            groups={form.groups ?? []}
            docNoField={headerBlock?.docNoField}
          />
          {form.groups && form.groups.length > 0 && form.buildBlocks && <LayoutMode />}
          <p class="save-note" data-save-note>
            입력값과 만든 파일은 서버로 보내지 않고, 이 브라우저에 7일간 자동 저장됩니다. 공용 PC에서는 사용 후 초기화하세요.
            {form.fields.some((field) => field.sensitive) && ' 계좌번호는 저장하지 않습니다.'}
          </p>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        </div>

        <div class="form-preview">
          <DocPreview />
        </div>
      </div>

      <ConfirmDialog />

      <div class="prose form-prose">
        <h2>이럴 때 씁니다</h2>
        <ul>
          {form.useCases.map((item) => <li>{item}</li>)}
        </ul>

        <h2>작성 요령</h2>
        <ol>
          {form.howTo.map((item) => <li>{item}</li>)}
        </ol>

        <h2>알아두세요</h2>
        <ul>
          {form.notes.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <RelatedForms form={form} bundles={bundles} />

      <Faq items={[...form.faq]} />

      <section class="sources">
        <h2>출처</h2>
        <ul>
          {form.sources.map((source) => (
            <li>
              <a href={source.href} rel="noopener noreferrer" target="_blank">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="notice">{formDisclaimer(form)}</p>
      </section>
    </div>
  </article>
</BaseLayout>

<script>
  import { loadForm } from '@/data/forms/loaders';
  import { initFormFavorite } from '@/scripts/form-library';
  import { initForm } from '@/scripts/form-runner';

  const slug = document.querySelector<HTMLElement>('[data-form-page]')?.dataset.formSlug;
  if (slug) {
    initFormFavorite(slug);
    void loadForm(slug).then((form) => {
      if (form) initForm(form);
    });
  }
</script>

<style>
  .form-page {
    padding-block: 1.6rem 3rem;
  }

  .container {
    width: min(100% - (var(--gutter) * 2), 1080px);
    margin-inline: auto;
  }

  .form-head {
    margin-block: 1rem 1.6rem;
    max-width: 760px;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .form-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
  }

  .title-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .form-favorite {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.1rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
  }

  .form-favorite:hover,
  .form-favorite[aria-pressed='true'] {
    border-bottom-color: var(--accent);
    color: var(--ink);
  }

  .form-favorite [data-favorite-icon] {
    color: var(--accent-strong);
    font-size: 0.95rem;
    line-height: 1;
  }

  h1 {
    margin: 0;
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }

  .lead {
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.65;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .bundle-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.7rem;
    padding: 0.28rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--accent-strong);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.16s ease;
  }

  .bundle-chip:hover,
  .bundle-chip:focus-visible {
    border-color: var(--accent);
  }

  .form-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.9rem;
  }

  .form-toolbar .btn {
    white-space: nowrap;
  }

  .save-menu {
    position: relative;
  }

  .save-menu > summary {
    display: inline-flex;
    list-style: none;
  }

  .save-menu > summary::-webkit-details-marker {
    display: none;
  }

  .save-menu > summary::marker {
    content: '';
  }

  .save-menu[open] > summary {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .save-menu-caret {
    color: var(--muted);
    font-size: 0.8em;
  }

  .save-menu-list {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    gap: 2px;
    min-width: 15.5rem;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 18px 44px -26px rgb(20 24 31 / 0.5);
  }

  .save-menu-list button {
    display: grid;
    gap: 1px;
    width: 100%;
    padding: 0.45rem 0.55rem;
    border: 0;
    border-radius: 7px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
    text-align: left;
    cursor: pointer;
  }

  .save-menu-list button:hover:not(:disabled) {
    background: var(--surface-muted);
  }

  .save-menu-list button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .save-menu-list small {
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 500;
  }

  .form-hwp-note {
    margin: -0.35rem 0 0.9rem;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
    text-align: right;
  }

  .form-error {
    margin: 0 0 0.9rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--warn) 45%, var(--line));
    border-radius: 8px;
    background: var(--warn-soft);
    color: var(--warn);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .form-warning {
    margin: 0 0 0.9rem;
    padding: 0.7rem 0.85rem 0.7rem 1.9rem;
    border: 1px solid color-mix(in srgb, var(--warn) 30%, var(--line));
    border-radius: 8px;
    background: var(--warn-soft);
    color: var(--ink);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .form-warning li + li {
    margin-top: 0.3rem;
  }

  .form-layout {
    display: grid;
    grid-template-columns: minmax(340px, 1.08fr) minmax(0, 0.92fr);
    gap: 1.2rem;
    align-items: start;
  }

  .form-input {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    min-width: 0;
    order: 2;
  }

  .save-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .form-status {
    min-height: 1.2rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .form-preview {
    position: sticky;
    top: 1rem;
    min-width: 0;
    order: 1;
  }

  .form-prose {
    margin-top: 3rem;
    max-width: 820px;
  }

  .sources {
    margin-top: 2.6rem;
    max-width: 820px;
  }

  .sources h2 {
    font-size: var(--step-1);
  }

  .sources ul {
    padding-left: 1.2rem;
    color: var(--ink-soft);
  }

  .notice {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    color: var(--ink-soft);
    font-size: 0.84rem;
  }

  @media (max-width: 1000px) {
    .form-layout {
      grid-template-columns: 1fr;
    }

    .form-input {
      order: 1;
    }

    .form-preview {
      order: 2;
      position: static;
    }
  }

  @media (max-width: 640px) {
    .form-page {
      padding-bottom: 6rem;
    }

    .form-hwp-note {
      display: none;
    }

    .form-toolbar {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 40;
      margin: 0;
      padding: 0.55rem var(--gutter) calc(0.55rem + env(safe-area-inset-bottom));
      border-top: 1px solid var(--line);
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      backdrop-filter: blur(8px);
      gap: 0.4rem;
    }

    .form-toolbar .btn {
      flex: 1 1 0;
      min-width: 0;
      padding-inline: 0.3rem;
      font-size: 0.88rem;
    }

    .save-menu-list {
      top: auto;
      right: auto;
      bottom: calc(100% + 0.4rem);
      left: 50%;
      min-width: min(15.5rem, calc(100vw - 1.5rem));
      transform: translateX(-50%);
    }
  }
</style>
