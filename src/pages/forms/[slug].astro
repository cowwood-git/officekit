---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import DocPreview from '@/components/forms/DocPreview.astro';
import FormFields from '@/components/forms/FormFields.astro';
import LayoutMode from '@/components/forms/LayoutMode.astro';
import ConfirmDialog from '@/components/forms/ConfirmDialog.astro';
import CompanyPreset from '@/components/forms/CompanyPreset.astro';
import { FORM_FAMILIES, FORMS } from '@/data/forms';
import { SITE } from '@/consts';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';
import type { FormTemplate } from '@/lib/doc/types';

export function getStaticPaths() {
  return FORMS.map((form) => ({
    params: { slug: form.slug },
    props: { form },
  }));
}

interface Props {
  form: FormTemplate;
}

const { form } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const path = `/forms/${form.slug}/`;
const updatedLabel = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(`${form.updated}T00:00:00Z`));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: form.title,
    description: form.description,
    url: new URL(path, site).toString(),
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    browserRequirements: 'JavaScript',
    inLanguage: 'ko',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    dateModified: form.updated,
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: site.toString(),
    },
  },
  faqSchema([...form.faq]),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    { name: '양식', path: '/forms/' },
    { name: form.title, path },
  ]),
];
---

<BaseLayout
  title={`${form.title} 양식 — 작성하고 바로 PDF로`}
  description={form.description}
  path={path}
  jsonLd={jsonLd}
>
  <article class="form-page" data-form-page data-form-slug={form.slug}>
    <div class="container">
      <Breadcrumbs
        items={[
          { label: '홈', href: '/' },
          { label: '양식', href: '/forms/' },
          { label: form.title },
        ]}
      />

      <header class="form-head">
        <p class="eyebrow">{FORM_FAMILIES[form.family]} · 양식</p>
        <h1>{form.title} 양식</h1>
        <p class="lead">{form.lead}</p>
        <p class="meta">
          <time datetime={form.updated}>최종 검토 {updatedLabel}</time>
          <span>·</span>
          <span>입력값은 서버로 전송되지 않습니다</span>
        </p>
      </header>

      <div class="form-toolbar">
        <button type="button" class="btn btn-secondary" data-fill-sample>예시 채우기</button>
        <button type="button" class="btn btn-secondary" data-reset>초기화</button>
        <details class="save-menu" data-save-menu>
          <summary class="btn btn-secondary">
            한글 파일
            <span class="save-menu-caret" aria-hidden="true">▾</span>
          </summary>
          <div class="save-menu-list" role="menu" aria-label="한글 파일 형식">
            <button type="button" role="menuitem" data-hwp-download="hwp">
              HWP로 저장
              <small>한글 2010+ 호환 · 기본</small>
            </button>
            <button type="button" role="menuitem" data-hwp-download="hwpx">
              HWPX로 저장
              <small>한글 2014+ 권장</small>
            </button>
          </div>
        </details>
        <button type="button" class="btn" data-download>PDF 만들기</button>
      </div>

      <p class="form-hwp-note">
        한글 파일은 PDF와 같은 구성으로 글자·표를 직접 고칠 수 있게 만든 편집용입니다. 서체는 나눔고딕 기준이며, PC에 없으면 비슷한 고딕으로 보입니다.
      </p>

      <p class="form-error" data-form-error role="alert" hidden></p>

      {form.companyParty && <CompanyPreset />}

      <div class="form-layout">
        <div class="form-input" data-form>
          <FormFields fields={form.fields} groups={form.groups ?? []} docPrefix={form.docPrefix} />
          {form.groups && form.groups.length > 0 && form.buildBlocks && <LayoutMode />}
          <p class="save-note" data-save-note>입력하면 이 브라우저에 자동 저장됩니다.</p>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        </div>

        <div class="form-preview">
          <DocPreview />
        </div>
      </div>

      <ConfirmDialog />

      <div class="prose form-prose">
        <h2>이럴 때 씁니다</h2>
        <ul>
          {form.useCases.map((item) => <li>{item}</li>)}
        </ul>

        <h2>작성 요령</h2>
        <ol>
          {form.howTo.map((item) => <li>{item}</li>)}
        </ol>

        <h2>알아두세요</h2>
        <ul>
          {form.notes.map((item) => <li>{item}</li>)}
        </ul>

        <h2>문서 스타일</h2>
        <p>
          모든 양식은 같은 문서 스타일로 만듭니다. 상단의 짧은 강조선과 회색 괘선, 가운데
          제목, 점선으로 이어지는 라벨이 그 특징입니다. 표와 서명란은 회색 선을 최소로 쓰고,
          숫자와 날짜는 오른쪽으로 맞춰 읽기 쉽게 배치합니다.
        </p>
        <p>
          작성본 PDF와 빈 양식 PDF는 같은 레이아웃을 씁니다. 미리보기에서 보이는 위치에 그대로
          인쇄되므로, 사내 결재 양식에 옮겨 적을 때도 배치를 다시 맞출 필요가 없습니다.
        </p>

        <h2>관련 양식과 도구</h2>
        <ul>
          {form.related?.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <Faq items={[...form.faq]} />

      <section class="sources">
        <h2>출처</h2>
        <ul>
          {form.sources.map((source) => (
            <li>
              <a href={source.href} rel="noopener noreferrer" target="_blank">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="notice">
          이 양식은 참고용입니다. 회사의 취업규칙·근무 규정과 관련 법령을 함께 확인하세요.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<script>
  import { loadForm } from '@/data/forms/loaders';
  import { initForm } from '@/scripts/form-runner';

  const slug = document.querySelector<HTMLElement>('[data-form-page]')?.dataset.formSlug;
  if (slug) {
    void loadForm(slug).then((form) => {
      if (form) initForm(form);
    });
  }
</script>

<style>
  .form-page {
    padding-block: 1.6rem 3rem;
  }

  .container {
    width: min(100% - (var(--gutter) * 2), 1080px);
    margin-inline: auto;
  }

  .form-head {
    margin-block: 1rem 1.6rem;
    max-width: 760px;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }

  .lead {
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.65;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .form-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.9rem;
  }

  .save-menu {
    position: relative;
  }

  .save-menu > summary {
    display: inline-flex;
    list-style: none;
  }

  .save-menu > summary::-webkit-details-marker {
    display: none;
  }

  .save-menu > summary::marker {
    content: '';
  }

  .save-menu[open] > summary {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .save-menu-caret {
    color: var(--muted);
    font-size: 0.8em;
  }

  .save-menu-list {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    gap: 2px;
    min-width: 15.5rem;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 18px 44px -26px rgb(20 24 31 / 0.5);
  }

  .save-menu-list button {
    display: grid;
    gap: 1px;
    width: 100%;
    padding: 0.45rem 0.55rem;
    border: 0;
    border-radius: 7px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
    text-align: left;
    cursor: pointer;
  }

  .save-menu-list button:hover:not(:disabled) {
    background: var(--surface-muted);
  }

  .save-menu-list button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .save-menu-list small {
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 500;
  }

  .form-hwp-note {
    margin: -0.35rem 0 0.9rem;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
    text-align: right;
  }

  .form-error {
    margin: 0 0 0.9rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--warn) 45%, var(--line));
    border-radius: 8px;
    background: var(--warn-soft);
    color: var(--warn);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .form-layout {
    display: grid;
    grid-template-columns: minmax(340px, 1.08fr) minmax(0, 0.92fr);
    gap: 1.2rem;
    align-items: start;
  }

  .form-input {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    min-width: 0;
    order: 2;
  }

  .save-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .form-status {
    min-height: 1.2rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .form-preview {
    position: sticky;
    top: 1rem;
    min-width: 0;
    order: 1;
  }

  .form-prose {
    margin-top: 3rem;
    max-width: 820px;
  }

  .sources {
    margin-top: 2.6rem;
    max-width: 820px;
  }

  .sources h2 {
    font-size: var(--step-1);
  }

  .sources ul {
    padding-left: 1.2rem;
    color: var(--ink-soft);
  }

  .notice {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    color: var(--ink-soft);
    font-size: 0.84rem;
  }

  @media (max-width: 1000px) {
    .form-layout {
      grid-template-columns: 1fr;
    }

    .form-input {
      order: 1;
    }

    .form-preview {
      order: 2;
      position: static;
    }
  }

  @media (max-width: 640px) {
    .form-page {
      padding-bottom: 6rem;
    }

    .form-hwp-note {
      display: none;
    }

    .form-toolbar {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 40;
      margin: 0;
      padding: 0.55rem var(--gutter) calc(0.55rem + env(safe-area-inset-bottom));
      border-top: 1px solid var(--line);
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      backdrop-filter: blur(8px);
      gap: 0.4rem;
    }

    .form-toolbar .btn {
      flex: 1 1 0;
      min-width: 0;
      padding-inline: 0.3rem;
      font-size: 0.88rem;
    }

    .save-menu-list {
      top: auto;
      right: auto;
      bottom: calc(100% + 0.4rem);
      left: 50%;
      min-width: min(15.5rem, calc(100vw - 1.5rem));
      transform: translateX(-50%);
    }
  }
</style>
