---
import AppIcon from '@/components/AppIcon.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { iconFor } from '@/data/app-icons';
import { getTool, type Tool } from '@/data/tools';
import { WORKFLOWS } from '@/data/workflows';
import { SITE } from '@/consts';
import { collectionPageSchema } from '@/lib/schema';

const site = Astro.site ?? new URL(SITE.url);
const path = '/workflows/';
const items = WORKFLOWS.map((workflow) => ({
  name: workflow.title,
  path: `/workflows/${workflow.slug}/`,
  description: workflow.description,
}));
const jsonLd = [
  collectionPageSchema(
    site,
    '작업 흐름',
    'PDF 제출, 문서 열기, 사진 제출, 표 정리처럼 여러 도구를 순서대로 묶은 작업 흐름입니다.',
    path,
    items,
  ),
];
---

<BaseLayout
  title="작업 흐름 — 결과까지 한 번에"
  description="제출용 PDF 만들기, 회사 문서 열기, 제출용 사진, 표 데이터 정리처럼 여러 도구를 순서대로 묶은 작업 흐름을 안내합니다."
  path={path}
  jsonLd={jsonLd}
>
  <div class="container workflows">
    <Breadcrumbs items={[{ label: '홈', href: '/' }, { label: '작업 흐름' }]} />

    <header class="workflows-head">
      <p class="eyebrow">WORKFLOWS</p>
      <h1>작업 흐름</h1>
      <p class="lead">
        도구를 하나씩 고르는 대신, 끝내고 싶은 결과부터 시작하세요. 필요한 도구를 순서대로 묶어
        안내합니다. 모든 단계는 브라우저에서 실행되고 파일은 서버로 전송되지 않습니다.
      </p>
    </header>

    <div class="workflow-grid">
      {
        WORKFLOWS.map((workflow, index) => {
          const tools = workflow.steps
            .map((step) => getTool(step.tool))
            .filter((tool): tool is Tool => Boolean(tool));
          return (
            <a class="workflow-card" href={`/workflows/${workflow.slug}/`}>
              <span class="workflow-index">{String(index + 1).padStart(2, '0')}</span>
              <strong>{workflow.title}</strong>
              <span class="workflow-lead">{workflow.lead}</span>
              <span class="workflow-meta">{workflow.steps.length}단계 · {workflow.audience}</span>
              <span class="workflow-tools" aria-hidden="true">
                {tools.slice(0, 4).map((tool) => (
                  <span class="workflow-tool">
                    <AppIcon name={iconFor(tool.slug)} size={16} />
                  </span>
                ))}
              </span>
            </a>
          );
        })
      }
    </div>

    <div class="prose workflows-prose">
      <h2>도구보다 결과부터</h2>
      <p>
        “PDF 합치기”를 이미 알고 있다면 도구 페이지로 바로 가면 됩니다. 하지만 “제출용 PDF를 만들어야
        한다”처럼 결과만 정해진 경우에는 순서가 더 중요합니다. 작업 흐름은 변환 → 합치기 → 압축 →
        보호처럼 실제로 이어지는 단계를 보여 줍니다.
      </p>
      <p>
        각 단계는 해당 도구로 연결되며, 중간 결과를 내려받아 다음 단계에 넣으면 됩니다. 파일은
        서버에 저장되지 않으므로 중간 산출물도 이 브라우저 안에서만 존재합니다.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .workflows {
    padding-block: 1.4rem 2rem;
  }

  .workflows-head {
    margin-top: 1rem;
  }

  .workflows-head h1 {
    margin: 0.2rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.04em;
  }

  .workflows-head .lead {
    max-width: 60ch;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 1.4rem;
  }

  .workflow-card {
    position: relative;
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .workflow-card:hover,
  .workflow-card:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .workflow-index {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .workflow-card strong {
    font-size: 1.02rem;
    letter-spacing: -0.02em;
  }

  .workflow-lead {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .workflow-meta {
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .workflow-tools {
    display: flex;
    gap: 0.3rem;
    margin-top: 0.35rem;
  }

  .workflow-tool {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface-muted);
    color: var(--ink-soft);
  }

  .workflows-prose {
    margin-top: 2.2rem;
  }

  @media (max-width: 760px) {
    .workflow-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
