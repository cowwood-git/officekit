---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import FormCard from '@/components/forms/FormCard.astro';
import HubHeader from '@/components/HubHeader.astro';
import { formCategory, KIDS_CATEGORY } from '@/data/form-categories';
import { KIDS_BUNDLES, KIDS_FORMS } from '@/data/form-sections';
import { getForm } from '@/data/forms';
import { SITE } from '@/consts';
import { breadcrumbSchema, collectionPageSchema, faqSchema } from '@/lib/schema';

/**
 * 유아·어린이 학습 공책 섹션. 업무 양식(/forms/)과 나눠 보여 준다(2026-11-20 운영 결정).
 * 공책 페이지 주소는 /forms/<slug>/ 그대로다(색인 유지). 이 섹션에는 광고를 싣지 않는다
 * (아이 대상 콘텐츠 — src/lib/ad-exclusions.ts).
 */
const site = Astro.site ?? new URL(SITE.url);
const path = '/kids/';
const category = formCategory(KIDS_CATEGORY);
const groups = KIDS_BUNDLES.map((bundle) => ({
  bundle,
  forms: bundle.steps
    .map((step) => getForm(step.slug))
    .filter((form): form is NonNullable<typeof form> => Boolean(form)),
}));
const grouped = new Set(groups.flatMap((group) => group.forms.map((form) => form.slug)));
const others = KIDS_FORMS.filter((form) => !grouped.has(form.slug));

const faq = [
  {
    q: '몇 칸 공책을 골라야 하나요?',
    a: '글씨를 처음 배우는 1학년은 칸이 큰 국어 8칸, 글씨가 손에 익은 1~2학년은 10칸, 받아쓰기를 많이 하는 2학년부터는 11칸을 주로 씁니다. 학교에서 정해 준 칸 수가 있으면 그것을 따르세요.',
  },
  {
    q: '실제 공책과 같은 크기로 나오나요?',
    a: '공책은 A4 용지 가운데에 190×260mm(16절) 실제 공책 크기로 놓입니다. 인쇄 창에서 배율을 100%(실제 크기)로 두어야 칸 크기가 맞습니다. "용지에 맞춤"을 고르면 칸이 조금 작아집니다.',
  },
  {
    q: '아이 이름을 넣어도 괜찮나요?',
    a: '이름·반·날짜는 이 브라우저 안에서만 PDF에 들어가고 서버로 보내지 않습니다. 비워 두면 손으로 쓸 수 있게 빈칸으로 인쇄됩니다.',
  },
  {
    q: '받아쓰기·단어장은 무엇이 다른가요?',
    a: '받아쓰기 노트와 영어 단어장은 낱말을 입력하면 그 글자가 연한 회색으로 인쇄되어, 아이가 위에 따라 쓰며 연습할 수 있습니다. 나머지 공책은 빈 칸·선만 인쇄합니다.',
  },
];

const jsonLd = [
  collectionPageSchema(
    site,
    category.label,
    '국어·영어·수학·음악·한자·받아쓰기 공책을 실제 공책 크기로 A4에 인쇄합니다.',
    path,
    KIDS_FORMS.map((form) => ({
      name: form.title,
      path: `/forms/${form.slug}/`,
      description: form.lead,
    })),
  ),
  faqSchema(faq),
  breadcrumbSchema(site, [
    { name: '홈', path: '/' },
    { name: category.label, path },
  ]),
];
---

<BaseLayout
  title="유아·어린이 학습 공책 — 국어·영어·받아쓰기 노트 인쇄"
  description="국어 8·10·11칸, 영어 3선·4선, 수학 모눈, 음악 오선지, 한자, 받아쓰기·영어 단어장 공책을 실제 공책 크기로 A4에 인쇄합니다. 이름은 서버로 보내지 않습니다."
  path={path}
  jsonLd={jsonLd}
>
  <article class="kids-page">
    <div class="container">
      <Breadcrumbs items={[{ label: '홈', href: '/' }, { label: category.label }]} />

      <HubHeader
        eyebrow="KIDS"
        title={category.label}
        lead="아이와 집·학교에서 쓰는 공책을 실제 공책 크기로 인쇄합니다. 칸 수와 줄 간격을 고르고, 이름을 넣거나 비워 둔 채 A4 한 장으로 내려받으세요."
        meta={`공책 ${KIDS_FORMS.length}종`}
      />

      {groups.map(({ bundle, forms }) => (
        <section class="kids-group" id={bundle.slug} aria-labelledby={`${bundle.slug}-title`}>
          <div class="kids-group-head">
            <h2 id={`${bundle.slug}-title`}>{bundle.shortTitle}</h2>
            <p>{bundle.description}</p>
            <a href={`/forms/bundles/${bundle.slug}/`}>고르는 순서와 인쇄 요령 →</a>
          </div>
          <ul class="kids-grid" role="list">
            {forms.map((form) => (
              <li>
                <FormCard form={form} categoryLabel={category.label} categoryId={category.id} />
              </li>
            ))}
          </ul>
        </section>
      ))}

      {others.length > 0 && (
        <section class="kids-group" aria-labelledby="kids-others-title">
          <div class="kids-group-head">
            <h2 id="kids-others-title">그 밖의 공책</h2>
          </div>
          <ul class="kids-grid" role="list">
            {others.map((form) => (
              <li>
                <FormCard form={form} categoryLabel={category.label} categoryId={category.id} />
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="prose kids-notes">
        <h2>학년에 맞게 고르기</h2>
        <p>
          국어 공책은 칸이 클수록 글씨를 처음 배우는 아이에게 맞습니다. 1학년 1학기에는 20mm 칸의
          8칸, 글씨가 손에 익으면 10칸, 받아쓰기와 일기를 많이 쓰는 2학년부터는 11칸을 흔히
          씁니다. 영어는 알파벳을 처음 익힐 때 줄 간격이 넓은 3선, 대소문자 높이를 구분해 쓰기
          시작하면 4선이 편합니다. 수학은 저학년 세로셈에 10mm 모눈, 고학년 도형·그래프에 5mm
          모눈을 많이 씁니다.
        </p>

        <h2>인쇄할 때</h2>
        <p>
          모든 공책은 A4 용지 가운데에 실제 공책 크기(190×260mm)로 놓입니다. 인쇄 배율을
          100%로 두어야 칸 크기가 맞고, 선은 흑백 프린터에서도 보이는 연한 회색입니다. 여러 장이
          필요하면 같은 PDF를 매수만 늘려 인쇄하세요.
        </p>

        <h2>아이 정보는 어디로 가나요</h2>
        <p>
          이름·반·날짜와 받아쓰기 낱말은 이 브라우저 안에서만 PDF로 만들어지고 서버로 보내지
          않습니다. 이 섹션에는 광고를 싣지 않습니다.
        </p>
      </div>

      <Faq items={faq} />
    </div>
  </article>
</BaseLayout>

<style>
  .kids-group {
    margin: 2rem 0 0;
  }

  .kids-group-head {
    margin-bottom: 1rem;
  }

  .kids-group-head h2 {
    margin: 0 0 0.3rem;
    font-size: 1.15rem;
  }

  .kids-group-head p {
    margin: 0 0 0.35rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .kids-group-head a {
    font-size: 0.88rem;
  }

  .kids-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .kids-notes {
    margin-top: 2.5rem;
  }

  @media (max-width: 400px) {
    .kids-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
