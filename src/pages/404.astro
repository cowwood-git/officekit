---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tools } from '@/data/tools';
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청한 페이지를 찾을 수 없습니다. 도구 화면에서 원하는 작업을 선택하세요."
  path="/404/"
  noindex
>
  <div class="container notfound">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없어요</h1>
    <p class="muted">주소가 바뀌었거나 삭제된 페이지입니다.</p>

    <div class="actions">
      <a class="btn" href="/">홈으로 돌아가기</a>
    </div>

    <ul class="links" role="list">
      {
        tools.map((tool) => (
          <li>
            <a href={`/tools/${tool.slug}/`}>
              <span aria-hidden="true">{tool.icon}</span>
              {tool.title.ko}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    max-width: 640px;
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  .code {
    color: var(--accent-strong);
    font-size: clamp(3.5rem, 12vw, 6rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  h1 {
    font-size: var(--step-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .links a:hover {
    border-color: var(--accent);
  }
</style>
