---
import SiteSearch from '@/components/SiteSearch.astro';
import { SITE } from '@/consts';
import { localePath } from '@/i18n/utils';
import { t } from '@/i18n/ui';

interface Props {
  locale?: 'ko' | 'en' | 'ja';
}

const { locale = 'ko' } = Astro.props;
const current = Astro.url.pathname;
const isActive = (path: string) => current === path || current.startsWith(`${path}`);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localePath(locale, '/')}>
      <span class="brand-text">
        <strong class="brand-name">
          <span class="brand-o">옷</span><span class="brand-kit">깃</span>
        </strong>
        <small class="brand-en" aria-hidden="true">
          <span class="brand-o">O</span><span class="brand-en-mid">ffice</span><span class="brand-kit">Kit</span>
        </small>
        <small class="brand-tagline">{t(locale, 'brandTagline')}</small>
      </span>
    </a>

    <SiteSearch />

    <div class="header-end">
      <nav class="nav" aria-label="주요 메뉴">
        <a href={localePath(locale, '/tools/')} aria-current={isActive('/tools/') ? 'page' : undefined}>
          {t(locale, 'navTools')}
        </a>
        <a href={localePath(locale, '/method/')} aria-current={isActive('/method/') ? 'page' : undefined}>
          {t(locale, 'navMethod')}
        </a>
        <a href={localePath(locale, '/about/')} aria-current={isActive('/about/') ? 'page' : undefined}>
          {t(locale, 'navAbout')}
        </a>
      </nav>

      <div class="bookmark">
        <button
          id="bookmark-toggle"
          class="bookmark-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="bookmark-hint"
          aria-label="즐겨찾기"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.8l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8Z"></path>
          </svg>
          <span>즐겨찾기</span>
        </button>
        <div id="bookmark-hint" class="bookmark-hint" role="status" hidden>
          <p class="bookmark-desktop">
            <kbd data-bookmark-key>Ctrl</kbd> + <kbd>D</kbd> 를 누르면<br />이 사이트가 즐겨찾기에 추가됩니다.
          </p>
          <p class="bookmark-mobile">
            브라우저 메뉴(공유 <span aria-hidden="true">⋯</span>)에서<br />
            <strong>북마크 추가</strong> 또는 <strong>홈 화면에 추가</strong>를 누르세요.
          </p>
        </div>
      </div>

      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="라이트 모드로 전환"
        aria-pressed="true"
      >
        <svg class="theme-icon theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="theme-icon theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 13.2A8.5 8.5 0 0 1 10.8 3 8.5 8.5 0 1 0 21 13.2Z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 0.55rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-text {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    line-height: 1;
  }

  .brand-text strong {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .brand-o {
    color: var(--brand-o);
  }

  .brand-kit {
    color: var(--brand-kit);
  }

  .brand-en {
    padding-bottom: 2px;
    color: var(--muted);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  .brand-en-mid {
    color: var(--muted);
  }

  .brand-tagline {
    padding-bottom: 1px;
    padding-left: 0.6rem;
    border-left: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .header-end {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 1rem;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.86rem;
    font-weight: 600;
  }

  .nav a {
    padding: 0.3rem 0.1rem;
    border-bottom: 2px solid transparent;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    border-bottom-color: var(--accent);
    color: var(--ink);
  }

  .bookmark {
    position: relative;
  }

  .bookmark-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.1rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
  }

  .bookmark-toggle:hover,
  .bookmark-toggle[aria-expanded='true'] {
    border-bottom-color: var(--accent);
    color: var(--ink);
  }

  .bookmark-toggle[aria-expanded='true'] svg {
    fill: currentColor;
  }

  .bookmark-hint {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 30;
    width: max-content;
    max-width: min(16rem, calc(100vw - 2rem));
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.14);
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .bookmark-hint p {
    margin: 0;
  }

  .bookmark-hint kbd {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--bg);
    color: var(--ink);
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .bookmark-hint strong {
    color: var(--ink);
  }

  .bookmark-mobile,
  .bookmark-hint[data-mobile='true'] .bookmark-desktop {
    display: none;
  }

  .bookmark-hint[data-mobile='true'] .bookmark-mobile {
    display: block;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .theme-toggle .theme-moon {
    display: none;
  }

  .theme-toggle[aria-pressed="false"] .theme-sun {
    display: none;
  }

  .theme-toggle[aria-pressed="false"] .theme-moon {
    display: block;
  }

  @media (max-width: 760px) {
    .header-inner {
      grid-template-columns: 1fr auto auto;
      gap: 0.5rem;
      padding-block: 0.5rem;
    }

    .brand-mark {
      width: 32px;
      height: 32px;
    }

    .brand-en,
    .brand-tagline,
    .nav {
      display: none;
    }

    .header-end {
      gap: 0.4rem;
    }

    .bookmark-toggle span {
      display: none;
    }

    .bookmark-toggle {
      width: 30px;
      height: 30px;
      justify-content: center;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--surface);
    }
  }
</style>

<script>
  // 브라우저는 스크립트로 즐겨찾기를 추가하지 못하게 막는다 → 단축키·메뉴 안내를 보여준다.
  (() => {
    const button = document.getElementById('bookmark-toggle');
    const hint = document.getElementById('bookmark-hint');
    if (!(button instanceof HTMLButtonElement) || !(hint instanceof HTMLDivElement)) return;

    const ua = navigator.userAgent;
    const mobile = /Android|iPhone|iPad|iPod/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    const mac = /Mac|iPhone|iPad/.test(navigator.platform || ua);
    hint.dataset.mobile = String(mobile);
    const key = hint.querySelector('[data-bookmark-key]');
    if (key && mac) key.textContent = '⌘';

    const setOpen = (open: boolean) => {
      hint.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('click', (event) => {
      if (!hint.hidden && !button.parentElement?.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !hint.hidden) {
        setOpen(false);
        button.focus();
      }
    });
  })();

  (() => {
    const toggle = document.getElementById('theme-toggle');
    if (!(toggle instanceof HTMLButtonElement)) return;

    const sync = (theme: 'dark' | 'light') => {
      toggle.setAttribute('aria-pressed', String(theme === 'dark'));
      toggle.setAttribute(
        'aria-label',
        theme === 'dark' ? '라이트 모드로 전환' : '다크 모드로 전환',
      );
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#101418' : '#fbfaf7');
    };

    const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    sync(current);

    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('officekit-theme', next);
      } catch {
        // 저장이 막힌 브라우저에서는 현재 세션에만 적용한다.
      }
      sync(next);
    });
  })();
</script>
