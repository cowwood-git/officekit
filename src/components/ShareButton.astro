---
import { SITE } from '@/consts';

interface Props {
  /** 문서 제목. 공유 문구와 접근성 이름에 쓴다. */
  title: string;
  kind: 'tool' | 'form';
}

const { title, kind } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const url = new URL(Astro.url.pathname, site).toString();
const noun = kind === 'tool' ? '도구' : '양식';
const heading = kind === 'tool' ? '이 도구 추천하기' : '이 양식 추천하기';
const shareText = `옷깃에서 ‘${title}’ ${noun}을 써봤어요. 설치 없이 브라우저에서 바로 됩니다.`;
const mailto = `mailto:?subject=${encodeURIComponent(`옷깃 ${noun} 추천 — ${title}`)}&body=${encodeURIComponent(`${shareText}\n\n${url}`)}`;
---

<div
  class="share"
  data-share
  data-share-title={title}
  data-share-text={shareText}
  data-share-url={url}
>
  <button
    type="button"
    class="share-toggle"
    aria-label={`${heading} — 링크 공유`}
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls={`share-panel-${kind}-${title.replaceAll(/\s+/g, '-')}`}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 15V3m0 0 4 4m-4-4L8 7M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" />
    </svg>
    <span>공유</span>
  </button>

  <div
    id={`share-panel-${kind}-${title.replaceAll(/\s+/g, '-')}`}
    class="share-panel"
    data-share-panel
    role="dialog"
    aria-label={heading}
    hidden
  >
    <p class="share-heading">{heading}</p>
    <p class="share-desc">링크를 복사해 카카오톡·문자·메일로 보내세요.</p>
    <div class="share-link">
      <input data-share-url-input readonly value={url} aria-label="공유 링크" />
      <button type="button" class="share-copy" data-share-copy>복사</button>
    </div>
    <div class="share-actions">
      <button type="button" class="share-native" data-share-native hidden>
        공유 시트 열기
      </button>
      <a class="share-mail" href={mailto}>메일로 보내기</a>
    </div>
    <p class="share-note">입력한 내용은 링크에 담기지 않습니다.</p>
    <p class="share-status" data-share-status role="status" aria-live="polite"></p>
  </div>
</div>

<style>
  .share {
    position: relative;
    display: inline-flex;
  }

  .share-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.1rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
  }

  .share-toggle:hover,
  .share-toggle[aria-expanded='true'] {
    border-bottom-color: var(--accent);
    color: var(--ink);
  }

  .share-toggle svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .share-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    left: auto;
    z-index: 45;
    display: grid;
    gap: 0.55rem;
    width: min(21rem, calc(100vw - 2rem));
    padding: 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: 0 16px 40px -18px rgb(0 0 0 / 0.35);
  }

  .share-panel[data-align='left'] {
    right: auto;
    left: 0;
  }

  .share-heading {
    margin: 0;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 800;
  }

  .share-desc,
  .share-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .share-link {
    display: flex;
    gap: 0.35rem;
  }

  .share-link input {
    flex: 1;
    min-width: 0;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface-muted);
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.75rem;
  }

  .share-copy {
    flex: none;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }

  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .share-native,
  .share-mail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .share-native:hover,
  .share-mail:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .share-status {
    min-height: 1em;
    margin: 0;
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .share-panel {
      position: fixed;
      top: auto;
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
      width: auto;
    }

    .share-toggle span {
      display: none;
    }

    .share-toggle {
      width: 30px;
      height: 30px;
      justify-content: center;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--surface);
    }

    .share-toggle svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script>
  (() => {
    const roots = document.querySelectorAll<HTMLElement>('[data-share]');

    const fallbackCopy = (text: string): boolean => {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    };

    const copyText = async (text: string): Promise<boolean> => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return fallbackCopy(text);
      }
    };

    for (const root of roots) {
      const toggle = root.querySelector<HTMLButtonElement>('.share-toggle');
      const panel = root.querySelector<HTMLElement>('[data-share-panel]');
      const input = root.querySelector<HTMLInputElement>('[data-share-url-input]');
      const copy = root.querySelector<HTMLButtonElement>('[data-share-copy]');
      const native = root.querySelector<HTMLButtonElement>('[data-share-native]');
      const status = root.querySelector<HTMLElement>('[data-share-status]');
      if (!toggle || !panel || !input || !copy || !status) continue;

      const title = root.dataset.shareTitle ?? document.title;
      const text = root.dataset.shareText ?? title;
      const url = root.dataset.shareUrl ?? location.href;

      const alignPanel = () => {
        const rect = toggle.getBoundingClientRect();
        panel.dataset.align =
          rect.left + rect.width / 2 < window.innerWidth / 2 ? 'left' : 'right';
      };

      const setOpen = (open: boolean) => {
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        status.textContent = '';
        if (open) {
          alignPanel();
          input.focus();
          input.select();
        }
      };

      toggle.addEventListener('click', () => setOpen(Boolean(panel.hidden)));

      copy.addEventListener('click', async () => {
        const ok = await copyText(url);
        if (ok) {
          copy.textContent = '복사됨';
          status.textContent = '링크를 복사했습니다. 카카오톡이나 문자에 붙여 넣으세요.';
          window.setTimeout(() => {
            copy.textContent = '복사';
          }, 2000);
        } else {
          status.textContent = '복사하지 못했습니다. 링크를 직접 선택해 복사해 주세요.';
          input.focus();
          input.select();
        }
      });

      if (native) {
        if (typeof navigator.share === 'function') {
          native.hidden = false;
          native.addEventListener('click', async () => {
            try {
              await navigator.share({ title, text, url });
              status.textContent = '공유 창을 열었습니다.';
            } catch (cause) {
              if ((cause as DOMException)?.name !== 'AbortError') {
                status.textContent = '공유하지 못했습니다. 링크를 복사해 주세요.';
              }
            }
          });
        } else {
          native.hidden = true;
        }
      }

      document.addEventListener('click', (event) => {
        if (!panel.hidden && !root.contains(event.target as Node)) setOpen(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !panel.hidden) {
          setOpen(false);
          toggle.focus();
        }
      });
      window.addEventListener('resize', () => {
        if (!panel.hidden) alignPanel();
      });
    }
  })();
</script>
