---
import AppIcon from '@/components/AppIcon.astro';
import FavoriteButton from '@/components/FavoriteButton.astro';
import { iconFor } from '@/data/app-icons';
import { demoTypeFor, formatFor } from '@/data/app-demos';
import { flowFor } from '@/data/app-flows';
import { capabilityFor, operationSearchText } from '@/data/tool-capabilities';
import type { Tool } from '@/data/tools';

interface Props {
  tool: Tool;
  category: string;
  /** 홈 카테고리 id(document·image·sheet·utility) — 아이콘 색을 정한다. */
  group?: string;
}

const { tool, category, group } = Astro.props;
const title = tool.title.ko;
const summary = tool.summary.ko;
const demo = demoTypeFor(tool.slug);
const format = formatFor(tool.slug);
const flow = flowFor(tool.slug);
const capability = capabilityFor(tool.slug);
const operationLabels = capability.operations.map(operationSearchText).join(' ');
---

<div class="app-tile-wrap" data-tile-wrap data-slug={tool.slug}>
<a
  class="app-tile"
  href={`/tools/${tool.slug}/`}
  data-app-tile
  data-slug={tool.slug}
  data-title={title}
  data-category={category}
  data-group={group}
  data-summary={summary}
  data-keywords={tool.keywords.join(' ')}
  data-format-id={capability.format}
  data-ops={capability.operations.join(' ')}
  data-op-labels={operationLabels}
  data-features={(capability.features ?? []).join(' ')}
  data-accepts={capability.accepts.join(' ')}
  data-produces={capability.produces.join(' ')}
  data-demo={demo}
  data-format={format || undefined}
  data-flow={flow || undefined}
>
  <span class="app-tile-icon">
    <AppIcon name={iconFor(tool.slug)} size={24} />
  </span>
  <span class="app-tile-label">{title}</span>
</a>
<FavoriteButton slug={tool.slug} title={title} />
</div>

<style>
  .app-tile-wrap {
    position: relative;
    min-width: 0;
  }

  .app-tile {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.15rem;
    border-radius: 8px;
    color: var(--ink);
    text-align: center;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .app-tile:hover,
  .app-tile:focus-visible {
    color: var(--ink);
    text-decoration: none;
  }

  .app-tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .app-tile[data-group='document'] {
    --cat: var(--cat-document);
    --cat-soft: var(--cat-document-soft);
  }

  .app-tile[data-group='image'] {
    --cat: var(--cat-image);
    --cat-soft: var(--cat-image-soft);
  }

  .app-tile[data-group='sheet'] {
    --cat: var(--cat-sheet);
    --cat-soft: var(--cat-sheet-soft);
  }

  .app-tile[data-group='text'] {
    --cat: var(--cat-text);
    --cat-soft: var(--cat-text-soft);
  }

  .app-tile[data-group='office'] {
    --cat: var(--cat-office);
    --cat-soft: var(--cat-office-soft);
  }

  .app-tile[data-group='utility'] {
    --cat: var(--cat-utility);
    --cat-soft: var(--cat-utility-soft);
  }

  .app-tile-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--cat-soft, var(--surface-muted));
    color: var(--cat, var(--ink));
    transition:
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.18s ease,
      background 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease;
  }

  /* hover 에도 분류 색을 유지한다: 테두리를 분류 색으로, 배경만 조금 진하게 */
  .app-tile:hover .app-tile-icon,
  .app-tile:focus-visible .app-tile-icon {
    transform: translateY(-2px);
    border-color: var(--cat, var(--accent));
    background: color-mix(in srgb, var(--cat, var(--accent)) 16%, var(--cat-soft, var(--surface)));
    box-shadow: var(--shadow-sm);
  }

  /* 누르는 순간 살짝 눌린다 — 페이지가 넘어가기 전에도 눌렸다는 반응이 있다 */
  .app-tile:active .app-tile-icon {
    transform: translateY(0) scale(0.96);
    box-shadow: none;
    transition-duration: 0.06s;
  }

  .app-tile-label {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.3;
    word-break: keep-all;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 640px) {
    .app-tile-icon {
      width: 44px;
      height: 44px;
      border-radius: 8px;
    }

    .app-tile-label {
      font-size: 0.74rem;
    }
  }
</style>
