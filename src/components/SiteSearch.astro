---
---

<button id="search-open" class="search-trigger" type="button" aria-haspopup="dialog">
  <span aria-hidden="true">🔍</span>
  <span class="search-trigger-label">도구·양식 검색</span>
  <kbd>⌘K</kbd>
</button>

<dialog id="site-search" class="site-search" aria-labelledby="search-title">
  <div class="search-head">
    <h2 id="search-title" class="visually-hidden">도구·양식 검색</h2>
    <input
      id="search-input"
      type="search"
      placeholder="PDF, 휴가신청서, 견적서…"
      autocomplete="off"
      aria-controls="search-results"
      aria-describedby="search-count"
    />
    <button id="search-close" class="search-close" type="button" aria-label="검색 닫기">✕</button>
  </div>

  <p id="search-count" class="search-count" aria-live="polite"></p>
  <ul id="search-results" class="search-results" aria-label="검색 결과"></ul>
  <p class="search-hint">↑↓ 이동 · Enter 열기 · Esc 닫기</p>
</dialog>

<script>
  import { SPRITE_URL } from '@/data/sprite';
  import { isFormIntent, isToolFormatQuery, normalizeSearch } from '@/lib/search-intent';

  const openButton = document.getElementById('search-open');
  const dialog = document.getElementById('site-search') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  const count = document.getElementById('search-count');
  const closeButton = document.getElementById('search-close');

  if (!openButton || !dialog || !input || !results || !count) {
    // 검색 UI가 없는 페이지에서는 아무것도 하지 않는다.
  } else {
    let cache: SearchItem[] | null = null;
    let active = -1;
    let current: SearchItem[] = [];

    const load = async (): Promise<SearchItem[]> => {
      if (cache) return cache;
      const response = await fetch('/search.json');
      cache = (await response.json()) as SearchItem[];
      return cache;
    };

    const normalize = normalizeSearch;

    const filter = (query: string): SearchItem[] => {
      if (!cache) return [];
      const q = normalize(query);
      if (!q) return cache.slice(0, 8);
      const words = q.split(' ');
      const formIntent = isFormIntent(q);
      const toolOnly = isToolFormatQuery(q);
      const pool = toolOnly
        ? cache.filter((item) => (item.type ?? 'tool') === 'tool')
        : cache;

      return pool
        .map((item) => {
          const haystack = normalize(
            `${item.title} ${item.summary} ${item.keywords.join(' ')} ${item.operationSearch ?? ''} ${item.accepts?.join(' ') ?? ''} ${item.produces?.join(' ') ?? ''} ${item.category ?? ''}`,
          );
          if (!words.every((word) => haystack.includes(word))) return null;
          const title = normalize(item.title);
          const titleHit = title === q ? 8 : title.includes(q) ? 4 : 0;
          const keywordHit = Math.max(
            0,
            ...item.keywords.map((word) => {
              const keyword = normalize(word);
              return keyword === q ? 3 : keyword.includes(q) ? 2 : 0;
            }),
          );
          const typeHit = formIntent && item.type === 'form' ? 3 : 0;
          return { item, score: titleHit + keywordHit + typeHit };
        })
        .filter((entry): entry is { item: SearchItem; score: number } => entry !== null)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8)
        .map((entry) => entry.item);
    };

    const setActive = (index: number) => {
      const links = [...results.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
      if (links.length === 0) return;
      active = (index + links.length) % links.length;
      links.forEach((link, i) => {
        link.classList.toggle('active', i === active);
        if (i === active) link.scrollIntoView({ block: 'nearest' });
      });
    };

    const render = (query: string) => {
      current = filter(query);
      active = current.length > 0 ? 0 : -1;
      results.replaceChildren();

      if (current.length === 0) {
        count.textContent = '결과가 없습니다. 다른 단어로 검색해 보세요.';
        return;
      }
      const formCount = current.filter((item) => item.type === 'form').length;
      const categoryCount = current.filter((item) => item.type === 'category').length;
      const toolCount = current.length - formCount - categoryCount;
      if (!query) {
        count.textContent = '도구와 양식을 함께 검색합니다.';
      } else if (toolCount === current.length) {
        count.textContent = `${current.length}개 결과`;
      } else {
        count.textContent = [
          toolCount > 0 ? `도구 ${toolCount}` : '',
          formCount > 0 ? `양식 ${formCount}` : '',
          categoryCount > 0 ? `카테고리 ${categoryCount}` : '',
        ]
          .filter(Boolean)
          .join(' · ');
      }

      current.forEach((item, index) => {
        const li = document.createElement('li');

        const link = document.createElement('a');
        link.href = item.path;
        link.dataset.index = String(index);
        link.className = index === 0 ? 'active' : '';

        const icon = document.createElement('span');
        icon.className = 'result-icon';
        icon.setAttribute('aria-hidden', 'true');
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('width', '18');
        svg.setAttribute('height', '18');
        svg.setAttribute('viewBox', '0 0 24 24');
        const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
        use.setAttribute('href', `${SPRITE_URL}#i-${item.iconName}`);
        svg.append(use);
        icon.append(svg);

        const body = document.createElement('span');
        body.className = 'result-body';
        const head = document.createElement('span');
        head.className = 'result-head';
        const title = document.createElement('strong');
        title.textContent = item.title;
        head.append(title);
        if (item.type === 'form' || item.type === 'category') {
          const badge = document.createElement('span');
          badge.className = `result-kind result-kind-${item.type}`;
          badge.textContent = item.type === 'form' ? '양식' : '카테고리';
          head.append(badge);
        }
        const summary = document.createElement('span');
        summary.textContent = item.summary;
        const category = document.createElement('em');
        category.textContent = item.category;
        body.append(head, summary, category);

        link.append(icon, body);
        li.append(link);
        results.append(li);
      });

      // 결과가 적을 때 빈 공간을 방치하지 않고 다른 양식을 제안한다.
      if (query && current.length < 5 && cache) {
        const suggestions = cache
          .filter(
            (item) =>
              item.type === 'form' && !current.some((entry) => entry.path === item.path),
          )
          .slice(0, 4);
        if (suggestions.length > 0) {
          const li = document.createElement('li');
          li.className = 'search-suggest';
          const label = document.createElement('span');
          label.className = 'search-suggest-label';
          label.textContent = '다른 양식';
          const list = document.createElement('span');
          list.className = 'search-suggest-links';
          for (const item of suggestions) {
            const link = document.createElement('a');
            link.href = item.path;
            link.textContent = item.title;
            list.append(link);
          }
          li.append(label, list);
          results.append(li);
        }
      }
    };

    const open = async () => {
      if (dialog.open) return;
      dialog.showModal();
      input.value = '';
      input.focus();
      const items = await load();
      cache = items;
      render(input.value);
    };

    openButton.addEventListener('click', () => void open());
    // 페이지 안의 다른 검색 진입점(홈 히어로 검색창 등)도 같은 대화상자를 연다.
    document.querySelectorAll<HTMLElement>('[data-search-open]').forEach((trigger) => {
      trigger.addEventListener('click', () => void open());
    });
    closeButton?.addEventListener('click', () => dialog.close());

    input.addEventListener('input', () => render(input.value));

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        dialog.close();
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(active + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(active - 1);
      } else if (event.key === 'Enter') {
        const item = current[active];
        if (item) {
          event.preventDefault();
          window.location.href = item.path;
        }
      }
    });

    results.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest('a');
      if (link) dialog.close();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      const meta = event.metaKey || event.ctrlKey;
      if (meta && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        void open();
        return;
      }
      // 계산기처럼 '/' 를 직접 쓰는 화면이 먼저 처리했으면 검색을 열지 않는다.
      if (event.key === '/' && !dialog.open && !event.defaultPrevented) {
        const target = event.target as HTMLElement | null;
        const tag = target?.tagName;
        if (tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT' && !target?.isContentEditable) {
          event.preventDefault();
          void open();
        }
      }
    });
  }

  type SearchItem = {
    type?: 'tool' | 'form' | 'category';
    slug: string;
    path: string;
    title: string;
    summary: string;
    category: string;
    iconName: string;
    keywords: string[];
    format?: string;
    operations?: string[];
    operationSearch?: string;
    accepts?: string[];
    produces?: string[];
  };
</script>

<style is:global>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 38px;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }

  .search-trigger:hover {
    border-color: var(--accent);
  }

  .search-trigger kbd {
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface-muted);
    color: var(--muted);
    font-size: 0.68rem;
  }

  .site-search {
    width: min(560px, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.5);
  }

  .site-search::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .search-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .search-head input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--surface);
  }

  .search-close {
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-muted);
    cursor: pointer;
  }

  .search-count {
    padding: 0.5rem 0.9rem 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .search-results {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    height: 50vh;
    max-height: 450px;
    min-height: 220px;
    margin: 0;
    padding: 0.5rem;
    overflow: auto;
    list-style: none;
  }

  .search-results a {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.55rem 0.6rem;
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
  }

  .search-results a:hover,
  .search-results a.active {
    background: var(--accent-soft);
  }

  .result-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    color: var(--accent-strong);
  }

  .result-icon svg {
    fill: currentColor;
    stroke: none;
  }

  .result-body {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .result-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .result-body strong {
    font-size: 0.9rem;
  }

  .result-kind {
    flex: none;
    padding: 0.08rem 0.32rem;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .result-kind-form {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .result-body span {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result-body em {
    color: var(--accent-strong);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 700;
  }

  .search-suggest {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    margin-top: 0.35rem;
    padding: 0.65rem 0.6rem 0.2rem;
    border-top: 1px solid var(--line);
  }

  .search-suggest-label {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .search-suggest-links {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.3rem;
  }

  .search-suggest-links a {
    display: inline-block;
    padding: 0.18rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.7rem;
    text-decoration: none;
  }

  .search-suggest-links a:hover,
  .search-suggest-links a:focus-visible {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .search-hint {
    padding: 0.5rem 0.9rem 0.8rem;
    color: var(--muted);
    font-size: 0.7rem;
  }

  @media (max-width: 560px) {
    .search-trigger-label,
    .search-trigger kbd {
      display: none;
    }
  }
</style>
