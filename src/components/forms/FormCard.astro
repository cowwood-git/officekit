---
import { formHaystack } from '@/data/form-search';
import { FORM_FAMILIES } from '@/data/forms';
import type { FormTemplate } from '@/lib/doc/types';

interface Props {
  form: FormTemplate;
  /** 검색·필터에 쓰는 분류 이름. 카드에는 family 이름을 표시한다. */
  categoryLabel: string;
  /** 양식관 카테고리 필터에 쓰는 id. */
  categoryId?: string;
  /** 홈 검색 결과 카드면 data-form-result를 붙인다. */
  searchResult?: boolean;
  /** 홈 검색 결과는 처음에 숨겨 두고 입력에 따라 보여 준다. */
  hidden?: boolean;
}

const { form, categoryLabel, categoryId, searchResult = false, hidden = false } = Astro.props;
const haystack = formHaystack(form, categoryLabel);
---

<a
  class="form-card"
  data-form-card
  data-category={categoryId}
  data-haystack={haystack}
  data-form-result={searchResult ? '' : undefined}
  href={`/forms/${form.slug}/`}
  hidden={hidden}
>
  <span class="paper" aria-hidden="true">
    <span class="paper-line accent"></span>
    <span class="paper-title">{form.title}</span>
    <span class="paper-line"></span>
    <span class="paper-line"></span>
    <span class="paper-line short"></span>
    <span class="paper-sign">(서명)</span>
  </span>
  <span class="card-body">
    <span class="card-kicker">{FORM_FAMILIES[form.family]}</span>
    <strong>{form.title}</strong>
    <span class="card-desc">{form.lead}</span>
    <span class="card-cta">작성하기 →</span>
  </span>
</a>

<style>
  .form-card {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    height: 100%;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }

  .form-card:hover,
  .form-card:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .paper {
    display: grid;
    align-content: start;
    gap: 7px;
    aspect-ratio: 210 / 297;
    padding: 14px 12px;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 8px 18px -14px rgb(20 24 31 / 0.45);
  }

  .paper-line {
    display: block;
    height: 1px;
    background: #d9d5cb;
  }

  .paper-line.accent {
    width: 34%;
    height: 2px;
    background: #0b6b5b;
  }

  .paper-line.short {
    width: 62%;
  }

  .paper-title {
    margin: 4px 0 2px;
    color: #14181f;
    font-size: 0.62rem;
    font-weight: 800;
    text-align: center;
  }

  .paper-sign {
    align-self: end;
    justify-self: end;
    margin-top: auto;
    color: #8a929c;
    font-size: 0.5rem;
  }

  .card-body {
    display: grid;
    gap: 0.32rem;
    min-width: 0;
  }

  .card-kicker {
    color: var(--accent-strong);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .card-body strong {
    font-size: 1.05rem;
  }

  .card-desc {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.55;
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .card-cta {
    margin-top: 0.3rem;
    color: var(--accent-strong);
    font-size: 0.8rem;
    font-weight: 700;
  }

  @media (max-width: 560px) {
    .form-card {
      grid-template-columns: 92px minmax(0, 1fr);
    }
  }
</style>
