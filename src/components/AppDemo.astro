}

{
  type === 'info-image' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <use href="#demo-photo" x="56" y="30" width="72" height="54" />
      <text class="demo-file-label" x="62" y="41"></text>
      <g class="d-out-2" style="--ty:-6px;--ts:0.4">
        <path d="M112 34 a7 7 0 0 1 14 0 c0 6 -7 12 -7 12 s-7 -6 -7 -12 z" class="demo-accent-fill" />
        <circle cx="119" cy="34" r="2.6" fill="var(--demo-paper)" />
      </g>
      <path d="M134 28 V86" class="demo-line" stroke-width="1" stroke-dasharray="2 3" />
      <rect x="150" y="22" width="68" height="62" rx="4" class="demo-paper" />
      <g class="d-out-2" style="--tx:10px;--ts:1">
        <text x="160" y="41" class="demo-static-label">GPS</text>
        <rect x="186" y="37" width="22" height="4" rx="2" class="demo-line-fill" />
        <path class="d-draw-1 demo-accent" pathLength="1" d="M158 39 H210" stroke-width="1.4" stroke-linecap="round" />
      </g>
      <g class="d-out-3" style="--tx:10px;--ts:1">
        <text x="160" y="55" class="demo-static-label">카메라</text>
