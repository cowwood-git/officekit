---
import type { DemoType } from '@/data/app-demos';

interface Props {
  type: DemoType;
}

const { type } = Astro.props;
---

{
  type === 'merge' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <g class="merge-a">
        <use href="#demo-page-text" x="112" y="24" width="48" height="64" />
      <text class="demo-file-label" x="117" y="34"></text>
      </g>
      <g class="merge-b">
        <use href="#demo-page-text" x="112" y="24" width="48" height="64" />
      <text class="demo-file-label" x="117" y="34"></text>
      </g>
      <use href="#demo-page-text" x="112" y="24" width="48" height="64" />
      <text class="demo-file-label" x="117" y="34"></text>
      <g class="demo-check">
        <circle cx="155" cy="82" r="8" class="demo-accent-fill" />
        <path
          d="M151 82 l2.5 2.5 l5 -5.5"
          class="demo-check-ink"
          fill="none"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )
}

{
  type === 'split' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <g class="split-a">
        <use href="#demo-page-text" x="112" y="24" width="48" height="64" />
      <text class="demo-file-label" x="117" y="34"></text>
      </g>
      <g class="split-b">
        <use href="#demo-page-text" x="112" y="24" width="48" height="64" />
      <text class="demo-file-label" x="117" y="34"></text>
      </g>
      <g class="split-c">
        <use href="#demo-page-text" x="112" y="24" width="48" height="64" />
      <text class="demo-file-label" x="117" y="34"></text>
      </g>
    </svg>
  )
}

{
  type === 'compress' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <g class="compress-page">
        <use href="#demo-page-text" x="100" y="20" width="48" height="64" />
      <text class="demo-file-label" x="105" y="30"></text>
      </g>
      <rect class="compress-bar demo-accent-fill" x="178" y="46" width="54" height="6" rx="3" />
      <text class="size-big demo-ink" x="178" y="38" font-size="10">
        4.2 MB
      </text>
      <text class="size-small demo-accent-text" x="178" y="38" font-size="10" font-weight="700">
        0.8 MB
      </text>
      <g class="demo-check">
        <circle cx="218" cy="84" r="8" class="demo-accent-fill" />
        <path
          d="M214 84 l2.5 2.5 l5 -5.5"
          class="demo-check-ink"
          fill="none"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )
}

{
  type === 'redact' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <use href="#demo-page-text" x="112" y="24" width="48" height="64" />
      <text class="demo-file-label" x="117" y="34"></text>
      <rect class="redact-bar demo-redact" x="120" y="49" width="32" height="7" rx="1.5" />
      <rect
        class="redact-bar redact-bar-2 demo-redact"
        x="120"
        y="57"
        width="26"
        height="7"
        rx="1.5"
      />
    </svg>
  )
}

{
  type === 'sign' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <use href="#demo-page" x="112" y="24" width="48" height="64" />
      <text class="demo-file-label" x="117" y="34"></text>
      <path d="M121 76 H151" class="demo-line" stroke-width="1.5" stroke-linecap="round" />
      <path
        class="sign-stroke demo-accent"
        d="M121 72 C125 61 128 80 133 69 C137 60 140 75 144 67 C147 62 149 70 152 63"
        fill="none"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>
  )
}

{
  type === 'form' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <use href="#demo-page" x="112" y="24" width="48" height="64" />
      <text class="demo-file-label" x="117" y="34"></text>
      <rect class="form-field" x="120" y="36" width="30" height="8" rx="2" />
      <rect class="form-field form-field-2" x="120" y="50" width="30" height="8" rx="2" />
      <rect class="form-field form-field-3" x="120" y="64" width="30" height="8" rx="2" />
      <g class="form-check">
        <path
          d="M140 40 l2 2 l4 -4"
          class="demo-accent"
          fill="none"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
      <g class="form-check form-check-2">
        <path
          d="M140 54 l2 2 l4 -4"
          class="demo-accent"
          fill="none"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
      <g class="form-check form-check-3">
        <path
          d="M140 68 l2 2 l4 -4"
          class="demo-accent"
          fill="none"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )
}

{
  type === 'extract-text' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <g class="txt-source">
        <use href="#demo-page-text" x="64" y="22" width="48" height="64" />
      <text class="demo-file-label" x="69" y="32"></text>
      </g>
      <path
        class="txt-arrow demo-accent"
        d="M124 55 H143 m-5 -4 l5 4 l-5 4"
        fill="none"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <g class="txt-card">
        <rect x="158" y="24" width="48" height="64" rx="3" class="demo-paper" />
        <path d="M192 24 H205.5 V38 Z" class="demo-fold" stroke-linejoin="round" />
        <text x="164" y="35" class="demo-accent-text" font-size="7.5" font-weight="700">
          TXT
        </text>
        <path
          d="M165 47 H199 M165 54 H199 M165 61 H191 M165 68 H195"
          class="demo-line"
          stroke-width="2"
          stroke-linecap="round"
        />
      </g>
    </svg>
  )
}

{
  type === 'extract-image' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <use href="#demo-page" x="64" y="22" width="48" height="64" />
      <text class="demo-file-label" x="69" y="32"></text>
      <rect
        x="70"
        y="35"
        width="32"
        height="22"
        rx="2"
        class="demo-photo"
        stroke-dasharray="3 2"
      />
      <g class="img-card">
        <rect x="158" y="24" width="48" height="64" rx="3" class="demo-paper" />
        <path d="M192 24 H205.5 V38 Z" class="demo-fold" stroke-linejoin="round" />
        <text x="164" y="35" class="demo-accent-text" font-size="7.5" font-weight="700">
          PNG
        </text>
        <rect
          x="166"
          y="43"
          width="32"
          height="22"
          rx="2"
          class="demo-photo"
          stroke-dasharray="3 2"
        />
        <path
          d="M165 78 H199 M165 84 H187"
          class="demo-line"
          stroke-width="2"
          stroke-linecap="round"
        />
      </g>
      <g class="img-photo">
        <rect x="70" y="35" width="32" height="22" rx="2" class="demo-photo" />
        <path
          d="M74 53 l6 -8 l5 5 l4 -3 l4 6 z"
          class="demo-photo-shape"
          stroke-width="1.2"
          stroke-linejoin="round"
        />
        <circle cx="95" cy="41" r="2" class="demo-accent-fill" />
      </g>
    </svg>
  )
}


{
  type === 'convert-image' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <g class="convert-from">
        <rect x="54" y="32" width="44" height="48" rx="3" class="demo-paper" />
        <text x="64" y="44" class="demo-static-label" font-size="7">
          PNG
        </text>
        <use href="#demo-photo" x="60" y="50" width="32" height="24" />
      </g>
      <path
        class="convert-arrow demo-accent"
        d="M110 56 h42 m-8 -6 l8 6 l-8 6"
        fill="none"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <g class="convert-to">
        <rect x="168" y="32" width="44" height="48" rx="3" class="demo-paper" />
        <text x="178" y="44" class="demo-static-label" font-size="7">
          JPG
        </text>
        <use href="#demo-photo" x="174" y="50" width="32" height="24" />
      </g>
    </svg>
  )
}

{
  type === 'to-pdf' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <g class="to-pdf-photo">
        <rect x="54" y="32" width="44" height="48" rx="3" class="demo-paper" />
        <text x="64" y="44" class="demo-static-label" font-size="7">
          JPG
        </text>
        <use href="#demo-photo" x="60" y="50" width="32" height="24" />
      </g>
      <path
        class="to-pdf-arrow demo-accent"
        d="M110 56 h42 m-8 -6 l8 6 l-8 6"
        fill="none"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <g class="to-pdf-page">
        <use href="#demo-page" x="168" y="24" width="48" height="64" />
        <text x="174" y="38" class="demo-static-label" font-size="7">
          PDF
        </text>
        <use href="#demo-photo" x="176" y="46" width="32" height="20" class="to-pdf-thumb" />
      </g>
      <g class="demo-check">
        <circle cx="218" cy="86" r="8" class="demo-accent-fill" />
        <path
          d="M214 86 l2.5 2.5 l5 -5.5"
          class="demo-check-ink"
          fill="none"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )
}

{
  type === 'to-image' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <g class="to-image-page">
        <use href="#demo-page-text" x="54" y="24" width="48" height="64" />
