        fill="none"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <g class="to-image-card">
        <rect x="168" y="32" width="44" height="48" rx="3" class="demo-paper" />
        <text x="178" y="44" class="demo-static-label" font-size="7">
          JPG
        </text>
        <use href="#demo-photo" x="174" y="50" width="32" height="24" />
      </g>
      <text x="178" y="94" class="to-image-count demo-ink" font-size="7">
        × 3
      </text>
      <g class="demo-check">
        <circle cx="218" cy="86" r="8" class="demo-accent-fill" />
        <path
          d="M214 86 l2.5 2.5 l5 -5.5"
          class="demo-check-ink"
          fill="none"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )
}


{
  type === 'split-images' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <g class="split-a">
        <use href="#demo-photo" x="112" y="38" width="48" height="36" />
      <text class="demo-file-label" x="117" y="48"></text>
      </g>
      <g class="split-b">
        <use href="#demo-photo" x="112" y="38" width="48" height="36" />
