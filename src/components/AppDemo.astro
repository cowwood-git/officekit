      </g>
      <g class="split-c">
        <use href="#demo-photo" x="112" y="38" width="48" height="36" />
      <text class="demo-file-label" x="117" y="48"></text>
      </g>
    </svg>
  )
}

{
  type === 'compress-image' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <g class="compress-page">
        <use href="#demo-photo" x="100" y="36" width="64" height="48" />
      <text class="demo-file-label" x="105" y="46"></text>
      </g>
      <rect class="compress-bar demo-accent-fill" x="178" y="46" width="54" height="6" rx="3" />
      <text class="size-big demo-ink" x="178" y="38" font-size="10">
        1.8 MB
      </text>
      <text class="size-small demo-accent-text" x="178" y="38" font-size="10" font-weight="700">
        420 KB
      </text>
      <g class="demo-check">
        <circle cx="218" cy="84" r="8" class="demo-accent-fill" />
        <path
          d="M214 84 l2.5 2.5 l5 -5.5"
          class="demo-check-ink"
          fill="none"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )
}

{
  type === 'stamp-image' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <use href="#demo-photo" x="92" y="22" width="88" height="66" />
      <text class="demo-file-label" x="98" y="33"></text>
      <g class="d-in-2" style="--fx:6px;--fy:0px">
        <rect x="140" y="74" width="36" height="11" rx="2" fill="var(--surface)" opacity="0.75" />
        <text x="158" y="82" class="demo-accent-text" font-size="6.5" font-weight="800" text-anchor="middle">© 2026</text>
      </g>
    </svg>
  )
}

{
  type === 'extract-image-text' && (
    <svg class="app-demo-svg demo-cycle" viewBox="0 0 272 112" role="presentation">
      <g class="txt-source">
        <use href="#demo-photo" x="64" y="34" width="48" height="36" />
      <text class="demo-file-label" x="69" y="44"></text>
      </g>
      <rect class="ocr-sweep demo-accent-fill" x="62" y="35" width="52" height="2" rx="1" style="--sweep:32px" />
      <path
        class="txt-arrow demo-accent"
        d="M124 55 H143 m-5 -4 l5 4 l-5 4"
        fill="none"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <g class="txt-card">
        <rect x="158" y="24" width="48" height="64" rx="3" class="demo-paper" />
        <path d="M192 24 H205.5 V38 Z" class="demo-fold" stroke-linejoin="round" />
        <text x="164" y="35" class="demo-accent-text" font-size="7.5" font-weight="700">
