---
import AppDemo from '@/components/AppDemo.astro';
import { DEMO_TYPES } from '@/data/app-demos';
---

<svg class="app-demo-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="demo-page" viewBox="0 0 48 64">
      <rect
        x="0.5"
        y="0.5"
        width="47"
        height="63"
        rx="3"
        style="fill: var(--demo-paper); stroke: var(--demo-stroke)"></rect>
      <path
        d="M34 0.5 H47.5 V15 Z"
        stroke-linejoin="round"
        style="fill: var(--demo-fold); stroke: var(--demo-stroke)"></path>
    </symbol>
    <symbol id="demo-photo" viewBox="0 0 48 36">
      <rect
        x="0.5"
        y="0.5"
        width="47"
        height="35"
        rx="2"
        style="fill: var(--accent-soft); stroke: var(--demo-stroke)"></rect>
      <path
        d="M6 28 l8 -9 l6 6 l5 -5 l9 8 z"
        stroke-width="1.2"
        stroke-linejoin="round"
        style="fill: var(--demo-line); stroke: var(--accent)"></path>
      <circle cx="35" cy="9" r="2.5" style="fill: var(--accent)"></circle>
    </symbol>
    <symbol id="demo-table" viewBox="0 0 120 64">
      <rect
        x="0.5"
        y="0.5"
        width="119"
        height="63"
        rx="2"
        style="fill: var(--demo-paper); stroke: var(--demo-stroke)"></rect>
      <path
        d="M0 14 H120 M0 30 H120 M0 46 H120 M30 0 V64 M60 0 V64 M90 0 V64"
        stroke-width="1"
        style="stroke: var(--demo-line)"></path>
    </symbol>
    <symbol id="demo-page-text" viewBox="0 0 48 64">
      <rect
        x="0.5"
        y="0.5"
        width="47"
        height="63"
        rx="3"
        style="fill: var(--demo-paper); stroke: var(--demo-stroke)"></rect>
      <path
        d="M34 0.5 H47.5 V15 Z"
        stroke-linejoin="round"
        style="fill: var(--demo-fold); stroke: var(--demo-stroke)"></path>
      <path
        d="M7 20 H41 M7 28 H41 M7 36 H33"
        stroke-width="2"
        stroke-linecap="round"
        style="stroke: var(--demo-line)"></path>
    </symbol>
  </defs>
</svg>

{
  DEMO_TYPES.map((type) => (
    <template data-demo={type}>
      <AppDemo type={type} />
    </template>
  ))
}

<div class="app-tip" id="app-tip" role="tooltip" aria-hidden="true">
  <span class="app-tip-arrow"></span>
  <div class="app-tip-demo" aria-hidden="true" hidden></div>
  <span class="app-tip-kicker"></span>
  <strong class="app-tip-title"></strong>
  <span class="app-tip-desc"></span>
</div>

<style is:global>
  .app-demo-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .app-tip {
    position: fixed;
    z-index: 120;
    width: 280px;
    max-width: calc(100vw - 24px);
    padding: 11px 14px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--shadow);
    pointer-events: none;
    opacity: 0;
    transform: translateY(7px) scale(0.96);
    transform-origin: 50% 100%;
    transition:
      opacity 0.14s ease,
      transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .app-tip.below {
    transform: translateY(-7px) scale(0.96);
    transform-origin: 50% 0;
  }

  .app-tip.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .app-tip-arrow {
    position: absolute;
    bottom: -5px;
    left: 50%;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border: 1px solid var(--line-strong);
    border-top: 0;
    border-left: 0;
    background: var(--surface);
    transform: rotate(45deg);
  }

  .app-tip.below .app-tip-arrow {
    top: -5px;
    bottom: auto;
    border: 1px solid var(--line-strong);
    border-right: 0;
    border-bottom: 0;
  }

  .app-tip-demo {
    height: 116px;
    margin: -11px -14px 10px;
    border-bottom: 1px solid var(--line);
    border-radius: 9px 9px 0 0;
    background: var(--demo-bg);
    overflow: hidden;
  }

  .app-tip-demo[hidden] {
    display: none;
  }

  .app-demo-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* 입력 → 결과 한 줄 */
  .app-tip-kicker {
    display: block;
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .app-tip-title {
    display: block;
    margin-top: 2px;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .app-tip-desc {
    display: -webkit-box;
    margin-top: 3px;
    overflow: hidden;
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .demo-file-label,
  .demo-static-label {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* ===== 데모 색 ===== */
  .demo-paper {
    fill: var(--demo-paper);
    stroke: var(--demo-stroke);
  }

  .demo-fold {
    fill: var(--demo-fold);
    stroke: var(--demo-stroke);
  }

  .demo-line {
    stroke: var(--demo-line);
  }

  .demo-accent {
    stroke: var(--accent);
  }

  .demo-accent-fill {
    fill: var(--accent);
  }

  .demo-accent-text {
    fill: var(--accent-strong);
    font-family: var(--font-mono);
  }

  .demo-check-ink {
    stroke: var(--demo-check-ink);
  }

  .demo-ink {
    fill: var(--demo-ink);
    font-family: var(--font-mono);
  }

  .demo-redact {
    fill: var(--demo-redact);
  }

  .demo-photo {
    fill: var(--accent-soft);
    stroke: var(--demo-stroke);
  }

  .demo-photo-shape {
    fill: var(--demo-line);
    stroke: var(--accent);
  }

  /* ===== 데모 애니메이션 ===== */
  .demo-cycle {
    animation: appdemo-cycle 3.8s infinite;
  }

  @keyframes appdemo-cycle {
    0%,
    84% {
      opacity: 1;
    }
    89%,
    93% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  .demo-check {
    transform-box: fill-box;
    transform-origin: center;
    animation: appdemo-check 3.8s infinite;
  }

  @keyframes appdemo-check {
    0%,
    44% {
      opacity: 0;
      transform: scale(0.5);
    }
    54%,
    92% {
      opacity: 1;
      transform: scale(1);
    }
    95%,
    100% {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  .merge-a,
  .merge-b,
  .split-a,
  .split-b,
  .split-c {
    transform-box: fill-box;
    transform-origin: center;
  }

  .merge-a {
    transform: translate(-4px, -2px);
    animation: appdemo-merge-a 3.8s infinite;
  }

  .merge-b {
    transform: translate(4px, 2px);
    animation: appdemo-merge-b 3.8s infinite;
  }

  @keyframes appdemo-merge-a {
    0%,
    8% {
      transform: translate(-52px, 4px) rotate(-8deg);
    }
    42%,
    92% {
      transform: translate(-4px, -2px) rotate(0deg);
    }
    95%,
    100% {
      transform: translate(-52px, 4px) rotate(-8deg);
    }
  }

  @keyframes appdemo-merge-b {
    0%,
    8% {
      transform: translate(52px, 6px) rotate(8deg);
    }
    42%,
    92% {
      transform: translate(4px, 2px) rotate(0deg);
    }
    95%,
    100% {
      transform: translate(52px, 6px) rotate(8deg);
    }
  }

  .split-a {
    transform: translate(-52px, 2px) rotate(-7deg);
    animation: appdemo-split-a 3.8s infinite;
  }

  .split-b {
    transform: translate(0, 0);
    animation: appdemo-split-b 3.8s infinite;
  }

  .split-c {
    transform: translate(52px, 2px) rotate(7deg);
    animation: appdemo-split-c 3.8s infinite;
  }

  @keyframes appdemo-split-a {
    0%,
    10% {
      transform: translate(0, 0) rotate(0deg);
    }
    42%,
    92% {
      transform: translate(-52px, 2px) rotate(-7deg);
    }
    95%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
  }

  @keyframes appdemo-split-b {
    0%,
    10% {
      transform: translate(2px, 1px) rotate(0deg);
    }
    42%,
    92% {
      transform: translate(0, 0) rotate(0deg);
    }
    95%,
    100% {
      transform: translate(2px, 1px) rotate(0deg);
    }
  }

  @keyframes appdemo-split-c {
    0%,
    10% {
      transform: translate(4px, 2px) rotate(0deg);
    }
    42%,
    92% {
      transform: translate(52px, 2px) rotate(7deg);
    }
    95%,
    100% {
      transform: translate(4px, 2px) rotate(0deg);
    }
  }

  .compress-page {
    transform: scale(0.8);
    transform-box: fill-box;
    transform-origin: center;
    animation: appdemo-compress-page 3.8s infinite;
  }

  @keyframes appdemo-compress-page {
    0%,
    10% {
      transform: scale(1);
    }
    42%,
    92% {
      transform: scale(0.8);
    }
    95%,
    100% {
      transform: scale(1);
    }
  }

  .compress-bar {
    transform: scaleX(0.36);
    transform-box: fill-box;
    transform-origin: left center;
    animation: appdemo-compress-bar 3.8s infinite;
  }

  @keyframes appdemo-compress-bar {
    0%,
    10% {
      transform: scaleX(1);
    }
    42%,
    92% {
      transform: scaleX(0.36);
    }
    95%,
    100% {
      transform: scaleX(1);
    }
  }

  .size-big {
    opacity: 0;
    animation: appdemo-size-big 3.8s infinite;
  }

  .size-small {
    opacity: 1;
    animation: appdemo-size-small 3.8s infinite;
  }

  @keyframes appdemo-size-big {
    0%,
    24% {
      opacity: 1;
    }
    40%,
    92% {
      opacity: 0;
    }
    95%,
    100% {
      opacity: 1;
    }
  }

  @keyframes appdemo-size-small {
    0%,
    24% {
      opacity: 0;
    }
    40%,
    92% {
      opacity: 1;
    }
    95%,
    100% {
      opacity: 0;
    }
  }

  .redact-bar {
    transform-box: fill-box;
    transform-origin: left center;
    transform: scaleX(1);
    animation: appdemo-redact 3.8s infinite;
  }

  .redact-bar-2 {
    animation-name: appdemo-redact-2;
  }

  @keyframes appdemo-redact {
    0%,
    12% {
      transform: scaleX(0);
    }
    36%,
    92% {
      transform: scaleX(1);
    }
    95%,
    100% {
      transform: scaleX(0);
    }
  }

  @keyframes appdemo-redact-2 {
    0%,
    18% {
      transform: scaleX(0);
    }
    42%,
    92% {
      transform: scaleX(1);
    }
    95%,
    100% {
      transform: scaleX(0);
    }
  }

  .sign-stroke {
    stroke-dasharray: 160;
    stroke-dashoffset: 0;
    animation: appdemo-sign 3.8s infinite;
  }

  @keyframes appdemo-sign {
    0%,
    12% {
      stroke-dashoffset: 160;
    }
    46%,
    92% {
      stroke-dashoffset: 0;
    }
    95%,
    100% {
      stroke-dashoffset: 160;
    }
  }

  .form-field {
    fill: var(--demo-paper);
    stroke: var(--demo-stroke);
    animation: appdemo-form-field 3.8s infinite;
  }

  .form-field-2 {
    animation-name: appdemo-form-field-2;
  }

  .form-field-3 {
    animation-name: appdemo-form-field-3;
  }

  @keyframes appdemo-form-field {
    0%,
    14% {
      fill: var(--demo-paper);
      stroke: var(--demo-stroke);
    }
    30%,
    92% {
      fill: var(--accent-soft);
      stroke: var(--accent);
    }
    95%,
    100% {
      fill: var(--demo-paper);
      stroke: var(--demo-stroke);
    }
  }

  @keyframes appdemo-form-field-2 {
    0%,
    20% {
      fill: var(--demo-paper);
      stroke: var(--demo-stroke);
    }
    38%,
    92% {
      fill: var(--accent-soft);
      stroke: var(--accent);
    }
    95%,
    100% {
      fill: var(--demo-paper);
      stroke: var(--demo-stroke);
    }
  }

  @keyframes appdemo-form-field-3 {
    0%,
    26% {
      fill: var(--demo-paper);
      stroke: var(--demo-stroke);
    }
    44%,
    92% {
      fill: var(--accent-soft);
      stroke: var(--accent);
    }
    95%,
    100% {
      fill: var(--demo-paper);
      stroke: var(--demo-stroke);
    }
  }

  .form-check {
    opacity: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: appdemo-form-check 3.8s infinite;
  }

  .form-check-2 {
    animation-name: appdemo-form-check-2;
  }

  .form-check-3 {
    animation-name: appdemo-form-check-3;
  }

  @keyframes appdemo-form-check {
    0%,
    28% {
      opacity: 0;
      transform: scale(0.5);
    }
    38%,
    92% {
      opacity: 1;
      transform: scale(1);
    }
    95%,
    100% {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  @keyframes appdemo-form-check-2 {
    0%,
    36% {
      opacity: 0;
      transform: scale(0.5);
    }
    46%,
    92% {
      opacity: 1;
      transform: scale(1);
    }
    95%,
    100% {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  @keyframes appdemo-form-check-3 {
    0%,
    44% {
      opacity: 0;
      transform: scale(0.5);
    }
    54%,
    92% {
      opacity: 1;
      transform: scale(1);
    }
    95%,
    100% {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  .txt-source {
    opacity: 0.3;
    animation: appdemo-txt-source 3.8s infinite;
  }

  @keyframes appdemo-txt-source {
    0%,
    14% {
      opacity: 1;
    }
    40%,
    92% {
      opacity: 0.3;
    }
    95%,
    100% {
      opacity: 1;
    }
  }

  .txt-card {
    opacity: 1;
    animation: appdemo-txt-card 3.8s infinite;
  }

  @keyframes appdemo-txt-card {
    0%,
    14% {
      opacity: 0;
      transform: translateX(-12px);
    }
    42%,
    92% {
      opacity: 1;
      transform: translateX(0);
    }
    95%,
    100% {
      opacity: 0;
      transform: translateX(-12px);
    }
  }

  .txt-arrow {
    opacity: 1;
    animation: appdemo-txt-arrow 3.8s infinite;
  }

  @keyframes appdemo-txt-arrow {
    0%,
    14% {
      opacity: 0;
    }
    34%,
    92% {
      opacity: 1;
    }
    95%,
    100% {
      opacity: 0;
    }
  }

  .img-card {
    opacity: 1;
    animation: appdemo-img-card 3.8s infinite;
  }

  @keyframes appdemo-img-card {
    0%,
    14% {
      opacity: 0;
      transform: translateX(-10px);
    }
    42%,
    92% {
      opacity: 1;
      transform: translateX(0);
    }
    95%,
    100% {
      opacity: 0;
      transform: translateX(-10px);
    }
  }

  .img-photo {
    animation: appdemo-img-photo 3.8s infinite;
  }

  @keyframes appdemo-img-photo {
    0%,
    14% {
      transform: translate(0, 0);
    }
    42%,
    92% {
      transform: translate(96px, 8px);
    }
    95%,
    100% {
      transform: translate(0, 0);
    }
  }


  .demo-line-fill {
    fill: var(--demo-line);
  }

  .demo-ink-fill {
    fill: var(--ink);
  }

  .convert-from {
    animation: appdemo-convert-from 3.8s infinite;
  }

  @keyframes appdemo-convert-from {
    0%,
    12% {
      opacity: 1;
    }
    38%,
    92% {
      opacity: 0.35;
    }
    95%,
    100% {
      opacity: 1;
    }
  }

  .convert-to {
    opacity: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: appdemo-convert-to 3.8s infinite;
  }

  @keyframes appdemo-convert-to {
    0%,
    12% {
      opacity: 0;
      transform: translateX(-14px) scale(0.94);
    }
    38%,
    92% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
    95%,
    100% {
      opacity: 0;
      transform: translateX(-14px) scale(0.94);
    }
  }

  .convert-arrow {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: appdemo-convert-arrow 3.8s infinite;
  }

  @keyframes appdemo-convert-arrow {
    0%,
    12% {
      opacity: 0;
      stroke-dashoffset: 60;
    }
    38%,
    92% {
      opacity: 1;
      stroke-dashoffset: 0;
    }
    95%,
    100% {
      opacity: 0;
      stroke-dashoffset: 60;
    }
  }


  .to-pdf-photo {
    opacity: 0.35;
    animation: appdemo-to-pdf-photo 3.8s infinite;
  }

  @keyframes appdemo-to-pdf-photo {
    0%,
    12% {
      opacity: 1;
    }
    38%,
    92% {
      opacity: 0.35;
    }
    95%,
    100% {
      opacity: 1;
    }
  }

  .to-pdf-arrow,
  .to-image-arrow {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: appdemo-convert-arrow 3.8s infinite;
  }

  .to-pdf-page {
    opacity: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: appdemo-to-pdf-page 3.8s infinite;
  }

  @keyframes appdemo-to-pdf-page {
    0%,
    12% {
      opacity: 0;
      transform: translateX(-14px) scale(0.94);
    }
    38%,
    92% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
    95%,
    100% {
      opacity: 0;
      transform: translateX(-14px) scale(0.94);
    }
  }

  .to-pdf-thumb {
    transform-box: fill-box;
    transform-origin: center;
    animation: appdemo-to-pdf-thumb 3.8s infinite;
  }

  @keyframes appdemo-to-pdf-thumb {
    0%,
    12% {
      opacity: 0;
      transform: scale(0.8);
    }
    40%,
    92% {
      opacity: 1;
      transform: scale(1);
    }
    95%,
    100% {
      opacity: 0;
      transform: scale(0.8);
    }
  }

  .to-image-page {
    opacity: 0.35;
    animation: appdemo-to-image-page 3.8s infinite;
  }

  @keyframes appdemo-to-image-page {
    0%,
    12% {
      opacity: 1;
    }
    38%,
    92% {
      opacity: 0.35;
    }
    95%,
    100% {
      opacity: 1;
    }
  }

  .to-image-card {
    opacity: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: appdemo-to-image-card 3.8s infinite;
  }

  @keyframes appdemo-to-image-card {
    0%,
    12% {
      opacity: 0;
      transform: translateX(-14px) scale(0.94);
    }
    38%,
    92% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
    95%,
    100% {
      opacity: 0;
      transform: translateX(-14px) scale(0.94);
    }
  }

  .to-image-count {
    opacity: 1;
    animation: appdemo-to-image-count 3.8s infinite;
  }

  @keyframes appdemo-to-image-count {
    0%,
    20% {
      opacity: 0;
    }
    42%,
    92% {
      opacity: 1;
    }
    95%,
    100% {
      opacity: 0;
    }
  }

  .crop-frame {
    transform-box: fill-box;
    transform-origin: center;
    animation: appdemo-crop 3.8s infinite;
  }

  @keyframes appdemo-crop {
    0%,
    12% {
      opacity: 0.35;
      transform: scale(1.35);
    }
    40%,
    92% {
      opacity: 1;
      transform: scale(1);
    }
    95%,
    100% {
      opacity: 0.35;
      transform: scale(1.35);
    }
  }

  .rotate-photo {
    transform-box: fill-box;
    transform-origin: center;
    animation: appdemo-rotate 3.8s infinite;
  }

  @keyframes appdemo-rotate {
    0%,
    10% {
      transform: rotate(0deg);
    }
    45%,
    92% {
      transform: rotate(90deg);
    }
    95%,
    100% {
      transform: rotate(0deg);
    }
  }

  .rotate-arrow {
    opacity: 1;
    animation: appdemo-rotate-arrow 3.8s infinite;
  }

  @keyframes appdemo-rotate-arrow {
    0%,
    10% {
      opacity: 0.35;
    }
    25%,
    92% {
      opacity: 1;
    }
    95%,
    100% {
      opacity: 0.35;
    }
  }

  .filter-photo {
    animation: appdemo-filter 3.8s infinite;
  }

  @keyframes appdemo-filter {
    0%,
    10% {
      filter: saturate(1) brightness(1);
    }
    45%,
    92% {
      filter: saturate(1.4) brightness(1.15);
    }
    95%,
    100% {
      filter: saturate(1) brightness(1);
    }
  }

