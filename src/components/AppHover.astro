    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-tip {
      transition: none;
    }

    .app-tip-demo .demo-cycle,
    .app-tip-demo .demo-cycle * {
      animation: none !important;
    }

    /* 움직임 없이 완성된 장면만 보여 준다: 사라질 것·지나간 장면·훑는 선은 숨긴다 */
    .app-tip-demo .d-out-1, .app-tip-demo .d-out-2, .app-tip-demo .d-out-3, .app-tip-demo .d-out-4, .app-tip-demo .d-out-5, .app-tip-demo .d-out-6,
    .app-tip-demo .d-ph-1,
    .app-tip-demo .d-ph-2,
    .app-tip-demo .ocr-sweep {
      opacity: 0;
    }
  }
</style>

<script>
  (() => {
    const tip = document.getElementById('app-tip');
    if (!(tip instanceof HTMLElement)) return;

    const arrow = tip.querySelector<HTMLElement>('.app-tip-arrow');
    const demo = tip.querySelector<HTMLElement>('.app-tip-demo');
    const kicker = tip.querySelector<HTMLElement>('.app-tip-kicker');
    const title = tip.querySelector<HTMLElement>('.app-tip-title');
    const desc = tip.querySelector<HTMLElement>('.app-tip-desc');
    if (!arrow || !demo || !kicker || !title || !desc) return;

    let active: HTMLElement | null = null;
    let timer = 0;
    let clearDemoTimer = 0;
    /** 마지막으로 카드를 닫은 시각 — 막 닫혔으면 다음 타일은 기다리지 않고 바로 띄운다 */
    let lastHide = 0;
    // 처음 뜰 때는 잠깐 기다려, 마우스가 지나가기만 하는 타일에서 카드가 번쩍이지 않게 한다.
    const OPEN_DELAY = 350;
    const WARM_WINDOW = 300;

    const tileFrom = (target: EventTarget | null): HTMLElement | null => {
      if (!(target instanceof Element)) return null;
      const tile = target.closest<HTMLElement>('[data-app-tile]');
      return tile;
    };

    // 같은 행의 타일은 카드 높이가 달라도 같은 방향으로 뜨게 한다.
    // 실제 높이 대신 최대 높이(240px)로 위 공간을 판단한다.
    const TIP_MAX_HEIGHT = 240;
    const GAP = 10;
    const EDGE = 12;

    const place = (tile: HTMLElement) => {
      const rect = tile.getBoundingClientRect();
      const width = tip.offsetWidth;
      const height = tip.offsetHeight;
      const viewport = document.documentElement.clientWidth;
      const below = rect.top - TIP_MAX_HEIGHT - GAP < EDGE;

      let left = rect.left + rect.width / 2 - width / 2;
      left = Math.max(12, Math.min(left, viewport - width - 12));
      const top = below ? rect.bottom + GAP : rect.top - height - GAP;

      tip.style.left = `${Math.round(left)}px`;
      tip.style.top = `${Math.round(top)}px`;
      tip.classList.toggle('below', below);

      const center = rect.left + rect.width / 2 - left;
      arrow.style.left = `${Math.round(Math.max(16, Math.min(center, width - 16)) - 4.5)}px`;
    };

    const show = (tile: HTMLElement) => {
      if (active && active !== tile) {
        active.classList.remove('is-tip-open');
        active.removeAttribute('aria-describedby');
      }

      active = tile;
      tile.classList.add('is-tip-open');
      tile.setAttribute('aria-describedby', 'app-tip');

      // 분류(워터마크)·이름(타일)과 겹치지 않게, 무엇을 넣으면 무엇이 나오는지 보여 준다.
      kicker.textContent = tile.dataset.flow ?? tile.dataset.category ?? '';
      title.textContent = tile.dataset.title ?? '';
      desc.textContent = tile.dataset.summary ?? '';

      clearTimeout(clearDemoTimer);
      const demoSlug = tile.dataset.demo;
      const template = demoSlug
        ? document.querySelector<HTMLTemplateElement>(`template[data-demo="${demoSlug}"]`)
        : null;

      if (template) {
        demo.replaceChildren(template.content.cloneNode(true));
        const fileFormat = tile.dataset.format ?? "";
        demo.querySelectorAll<SVGTextElement>('.demo-file-label').forEach((label) => {
          if (fileFormat) label.textContent = fileFormat;
          else label.remove();
        });
        demo.hidden = false;
      } else {
        demo.replaceChildren();
        demo.hidden = true;
      }

      place(tile);
      tip.classList.add('visible');
      tip.setAttribute('aria-hidden', 'false');
    };

    const hide = () => {
      if (!active) return;
      active.classList.remove('is-tip-open');
      active.removeAttribute('aria-describedby');
      active = null;
      lastHide = performance.now();
      tip.classList.remove('visible');
      tip.setAttribute('aria-hidden', 'true');

      clearTimeout(clearDemoTimer);
      clearDemoTimer = window.setTimeout(() => {
        if (active) return;
        demo.replaceChildren();
        demo.hidden = true;
      }, 340);
    };

    document.addEventListener('pointerover', (event) => {
      if (event.pointerType && event.pointerType !== 'mouse') return;
      const tile = tileFrom(event.target);
      if (!tile || tile === active) return;
      clearTimeout(timer);
      const warm = active !== null || performance.now() - lastHide < WARM_WINDOW;
      if (warm) show(tile);
      else timer = window.setTimeout(() => show(tile), OPEN_DELAY);
    });

    document.addEventListener('pointerout', (event) => {
      if (event.pointerType && event.pointerType !== 'mouse') return;
      const tile = tileFrom(event.target);
      if (!tile) return;
      if (event.relatedTarget instanceof Node && tile.contains(event.relatedTarget)) return;
      clearTimeout(timer);
      hide();
    });

    document.addEventListener('focusin', (event) => {
      const tile = tileFrom(event.target);
      if (!tile) return;
      if (!tile.matches(':focus-visible')) return;
      clearTimeout(timer);
      show(tile);
    });

    document.addEventListener('focusout', (event) => {
      const tile = tileFrom(event.target);
      if (!tile) return;
      clearTimeout(timer);
      hide();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') hide();
    });

    window.addEventListener('scroll', hide, { passive: true, capture: true });
    window.addEventListener('resize', hide);
  })();
</script>
