{
  "name": "officekit",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "직장인 업무 도구 — PDF·이미지·텍스트, 설치 없이 브라우저에서",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare": "node scripts/check-commit.mjs install",
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/apply-ad-csp.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:perf": "node scripts/audit-perf.mjs",
    "verify": "npm run check && npm run lint && npm run test && npm run build && npm run audit:content && npm run audit:perf",
    "og": "node scripts/make-og.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs && node scripts/copy-rhwp-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs && node scripts/copy-rhwp-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:pwa": "playwright test --project=pwa",
    "test:e2e:slow": "playwright test --project=slow",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "predev:4140": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs && node scripts/copy-rhwp-assets.mjs",
    "dev:4140": "astro dev --port 4140 --host 127.0.0.1",
    "cf:login": "npx wrangler login",
    "cf:whoami": "npx wrangler whoami",
    "deploy": "node scripts/check-deploy-env.mjs && npm run verify && npx wrangler pages deploy dist --project-name officekit --branch main",
    "deploy:preview": "npm run build && npx wrangler pages deploy dist --project-name officekit --branch preview"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.4.0",
    "@astrojs/sitemap": "^3.7.4",
    "@cantoo/pdf-lib": "^2.11.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/webp": "1.5.0",
    "@mdgate/doc": "^0.6.25",
    "@pdf-lib/fontkit": "^1.1.1",
    "@rhwp/core": "^0.9.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "@web-ppt/core": "^0.8.0",
    "astro": "^7.4.8",
    "dompurify": "^3.4.17",
    "exifr": "^7.1.3",
    "gifenc": "^1.0.3",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "korean-holidays": "^1.0.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "mupdf": "1.28.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.65.0",
    "@types/qrcode": "^1.5.6",
    "@zxing/library": "^0.23.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "npm@11.12.1"
}
